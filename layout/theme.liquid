<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS variables %}
    {% render 'css-variables' %}

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% unless settings.type_heading_font.system?
      and settings.type_subheading_font.system?
      and settings.type_body_font.system?
    %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_subheading_font.system? %}
      {{ settings.type_subheading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load theme stylesheet %}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'comman-section.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- if settings.enable_wishlist -%}
      {{ 'wishlist.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
     {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <script>
            window.theme = window.theme || {};
            window.routes = window.routes || {};
            window.routes.predictive_search_url = {{ routes.predictive_search_url | json }};
            window.theme.predictiveSearchEnabled = {{ settings.predictive_search_enabled | json }};

            window.theme.moneyFormat = {{ shop.money_format | json }};
          window.theme.cartType = {{ settings.cart_type | json }};

            window.theme.formatMoney = function(cents) {
        const amount = (cents / 100).toFixed(2);

        return window.theme.moneyFormat
          .replace(/\{\{\s*amount\s*\}\}/g, amount);
      };

      window.theme.cartType = {{ settings.cart_type | json }};
      window.theme.cartDrawerConfetti = {{ settings.cart_drawer_enable_confetti | default: true }};

      {%- if settings.enable_wishlist -%}
        {%- liquid
          if settings.wishlist_page != blank
            assign wishlist_url = settings.wishlist_page.url
          else
            assign wishlist_url = '/pages/wishlist'
          endif
        -%}
        window.theme.wishlistLabels = {
          loading: {{ 'wishlist.loading' | t | json }},
          addToCart: {{ 'card_product.add_to_cart.label' | t | json }},
          quickView: {{ 'card_product.quick_view.label' | t | json }},
          soldOut: {{ 'card_product.sold_out.label' | t | json }},
          remove: {{ 'wishlist.remove' | t | json }}
        };
        window.theme.wishlistPageUrl = {{ wishlist_url | json }};
      {%- endif -%}
    </script>

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}
    {% if settings.cart_type == 'cart_drawer' %}
      {% render 'cart-drawer' %}
    {% endif %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% render 'quick-view-modal' %}
  </body>
</html>

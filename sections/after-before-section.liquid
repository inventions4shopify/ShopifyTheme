{{ 'after-before-section.css' | asset_url | stylesheet_tag }}

<div {%- render 'section-variables', section: section, class: 'after-before__section' -%}>
  <div class="page-width">
    <div class="cms-row flex-{{ section.settings.image_position }} items-{{ section.settings.desktop_content_position }}">
      <div class="cms-cell--{{ section.settings.width }}">
        <div class="before-after-wrapper">
          <div class="before-after-container-inner aspect-square" id="before-after-{{ section.id }}">
            {% if section.settings.after_image != blank %}
              <div class="after-img">
                <img
                  src="{{ section.settings.after_image | img_url: 'master' }}"
                  alt="{{ section.settings.after_image.alt }}"
                  loading="lazy"
                  width="auto"
                  height="auto"
                />
              </div>
            {% endif %}

            {% if section.settings.before_image != blank %}
              <div class="before-image-wrapper">
                <img
                  src="{{ section.settings.before_image | img_url: 'master' }}"
                  alt="{{ section.settings.before_image.alt }}"
                  loading="lazy"
                  width="auto"
                  height="auto"
                />
              </div>
            {% endif %}

            <div class="cms-image-labels items-{{ section.settings.bedge_position }}">
              {% if section.settings.after_text != blank %}
                <div class="badge">
                  {{ section.settings.after_text }}
                </div>
              {% endif %}

              {% if section.settings.before_text != blank %}
                <div class="badge">
                  {{ section.settings.before_text }}
                </div>
              {% endif %}
            </div>

            <!-- Divider -->
            <div class="divider-line"></div>

            <!-- Handle -->
            <div class="divider-handle">

              {% if section.settings.svg_text_icon != blank %}
                {{ section.settings.svg_text_icon }}
              {% elsif section.settings.svg_icon_img != blank %}
                <img
                  src="{{ section.settings.svg_icon_img | img_url: 'master' }}"
                  alt="Handle Icon"
                  loading="lazy"
                  width="24"
                  height="24"
                >
              {% else %}
                <span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="icon" viewBox="0 0 16 16">
                    <path d="M8 15a.5.5 0 0 1-.5-.5v-13a.5.5 0 0 1 1 0v13a.5.5 0 0 1-.5.5M.146 8.354a.5.5 0 0 1 0-.708l2-2a.5.5 0 1 1 .708.708L1.707 7.5H5.5a.5.5 0 0 1 0 1H1.707l1.147 1.146a.5.5 0 0 1-.708.708zM10 8a.5.5 0 0 1 .5-.5h3.793l-1.147-1.146a.5.5 0 0 1 .708-.708l2 2a.5.5 0 0 1 0 .708l-2 2a.5.5 0 0 1-.708-.708L14.293 8.5H10.5A.5.5 0 0 1 10 8"/>
                  </svg>
                </span>
              {% endif %}

            </div>

            <!-- Range -->
            <input
              type="range"
              min="0"
              max="100"
              value="50"
              class="slider-range"
            >
          </div>
        </div>
      </div>
      <div class="cms-cell ps-rte">
        {% for block in section.blocks %}

          {% case block.type %}

            {% when 'caption' %}
              {%- assign sub_color = block.settings.subheading_color -%}
              <span class="sub-heading"
              {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ sub_color.rgb }});"
              {%- endunless %}
              >
                {{ block.settings.caption }}
              </span>

            {% when 'heading' %}
              {%- assign head_grad = block.settings.heading_gradient -%}
              {%- assign head_color = block.settings.heading_color -%}

              {%- capture heading_style -%}
                {%- if head_grad != blank -%}
                  background: {{ head_grad }};
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;
                {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                  --color-heading: {{ head_color.rgb }};
                {%- endif -%}
              {%- endcapture -%}

              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_size }} class="{{ block.settings.heading_size }}"
                {%- unless heading_style == blank %}
                  style="{{ heading_style | strip }}"
                {%- endunless %}
                >
                  {{ block.settings.heading }}
                </{{ block.settings.heading_size }}>
              {% endif %}

            {% when 'text' %}
              {%- assign block_color = block.settings.text_color -%}
              <div class="text-desc"
                {%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
                  style="color: rgb({{ block_color.rgb }});"
                {%- endunless %}
              >
                {{ block.settings.text }}
              </div>

            {% when 'button' %}
              {% if block.settings.button_label != blank %}
                <div class="cms-buttons-row">
                    {%- render 'button',
                    text: block.settings.button_label,
                    href: block.settings.button_link,
                    style: block.settings.button_style_secondary,
                    background_color: block.settings.button_background_color,
                    text_color: block.settings.button_text_color,
                    outline_color: block.settings.button_outline_color
                  -%}
                </div>
              {% endif %}

          {% endcase %}

        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const container = document.querySelector("#before-after-{{ section.id }}");

    if (!container) return;

    const slider = container.querySelector(".slider-range");
    const beforeWrapper = container.querySelector(".before-image-wrapper");
    const dividerLine = container.querySelector(".divider-line");
    const handle = container.querySelector(".divider-handle");

    function updateSlider(value) {
      beforeWrapper.style.width = value + "%";
      dividerLine.style.left = value + "%";
      handle.style.left = value + "%";
    }

    updateSlider(slider.value);

    slider.addEventListener("input", function () {
      updateSlider(this.value);
    });

  });
</script>

{% schema %}
{
  "name": "After Before comparison",
  "class": "after-before-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",

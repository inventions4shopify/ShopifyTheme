{{ 'after-before-section.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="cms-row {{ section.settings.image_position }} items-{{ section.settings.desktop_content_position }}">
    <div class="cms-after-before-thumb">
      <div class="before-after-wrapper">
        <div class="before-after-container-inner" id="before-after-{{ section.id }}">
          {% if section.settings.after_image != blank %}
            <div class="after-img">
              <img
                src="{{ section.settings.after_image | img_url: 'master' }}"
                alt="{{ section.settings.after_image.alt }}"
                loading="lazy"
                width="auto"
                height="auto"
              />
            </div>
          {% endif %}

          {% if section.settings.before_image != blank %}
            <div class="before-image-wrapper">
              <img
                src="{{ section.settings.before_image | img_url: 'master' }}"
                alt="{{ section.settings.before_image.alt }}"
                loading="lazy"
                width="auto"
                height="auto"
              />
            </div>
          {% endif %}

          <!-- Divider -->
          <div class="divider-line"></div>

          <!-- Handle -->
          <div class="divider-handle">

            {% if section.settings.svg_text_icon != blank %}
              {{ section.settings.svg_text_icon }}
            {% elsif section.settings.svg_icon_img != blank %}
              <img
                src="{{ section.settings.svg_icon_img | img_url: 'master' }}"
                alt="Handle Icon"
                loading="lazy"
                width="24"
                height="24"
              >
            {% else %}
              <span>↔</span>
            {% endif %}

          </div>

          <!-- Range -->
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            class="slider-range"
          >
        </div>
      </div>
    </div>
    <div class="cms-content">
      <div class="text-block">

        {% for block in section.blocks %}

          {% case block.type %}

            {% when 'caption' %}
              <span class="subheading">
                {{ block.settings.caption }}
              </span>

            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_size }} class="title {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </{{ block.settings.heading_size }}>
              {% endif %}

            {% when 'text' %}
              <div class="text-desc">
                {{ block.settings.text }}
              </div>

            {% when 'button' %}
              {% if block.settings.button_label != blank %}
                <div class="cms-buttons-row">
                  <a
                    href="{{ block.settings.button_link }}"
                    class="button {% if block.settings.button_style_secondary %}button--secondary{% endif %}"
                  >
                    {{ block.settings.button_label }}
                  </a>
                </div>
              {% endif %}

          {% endcase %}

        {% endfor %}

      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const container = document.querySelector("#before-after-{{ section.id }}");

    if (!container) return;

    const slider = container.querySelector(".slider-range");
    const beforeWrapper = container.querySelector(".before-image-wrapper");
    const dividerLine = container.querySelector(".divider-line");
    const handle = container.querySelector(".divider-handle");

    function updateSlider(value) {
      beforeWrapper.style.width = value + "%";
      dividerLine.style.left = value + "%";
      handle.style.left = value + "%";
    }

    updateSlider(slider.value);

    slider.addEventListener("input", function () {
      updateSlider(this.value);
    });

  });
</script>

{% schema %}
{
  "name": "After Before comparison",
  "class": "section after-before-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "start",
      "label": "Desktop Content Position"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "row",
          "label": "Image First"
        },
        {
          "value": "row-reverse",
          "label": "Image Second"
        }
      ],
      "default": "row",
      "label": "Image Position"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "textarea",
      "id": "svg_text_icon",
      "label": "Custom SVG"
    },
    {
      "type": "image_picker",
      "id": "svg_icon_img",
      "label": "Handle Icon"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "caption",
          "default": "Caption",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            }
          ],
          "default": "h1",
          "label": "Heading Size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Description</p>",
          "label": "Description"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop Now",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "Secondary Style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "After Before comparison"
    }
  ]
}
{% endschema %}
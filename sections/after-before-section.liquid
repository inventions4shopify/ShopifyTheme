        },
        {
          "value": "row-reverse",
          "label": "Image Second"
        }
      ],
      "default": "row",
      "label": "Image Position"
    },
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Width"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "text",
      "id": "after_text",
      "label": "After Text",
      "default": "After"
    },
    {
      "type": "text",
      "id": "before_text",
      "label": "Before Text",
      "default": "Before"
    },
    {
      "type": "select",
      "id": "bedge_position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "end",
          "label": "Bottom"
        },
        {
          "value": "alternate",
          "label": "Alternate"
        }
      ],
      "default": "alternate",
      "label": "Bedge Position"
    },
    {
      "type": "textarea",
      "id": "svg_text_icon",
      "label": "Custom SVG"
    },
    {
      "type": "image_picker",
      "id": "svg_icon_img",
      "label": "Handle Icon"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,

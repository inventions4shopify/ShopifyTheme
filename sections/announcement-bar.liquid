{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<style>
  .announcement-bar {
    background-color: {{ settings.accountment_background_color }};
    color: {{ settings.accountment_text_color }};
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px 0;
    transition: all 0.25s ease;
  }

  .announcement-bar:hover {
    color: {{ settings.accountment_hover_text_color }};
  }

  .announcement-marquee {
    animation: marqueeScroll {{ section.settings.scrolling_speed }}s linear infinite;
  }

  @media screen and (min-width: 768px){
    .announcement-bar {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    }
  }
</style>

{% render 'variables', section: section %}
{% if section.blocks.size > 0 %}
  <announcement-bar
    class="announcement-bar bg-custom text-large"
    {% if section.settings.type == 'arrows' %}
      data-auto-rotate="{{ section.settings.auto_rotated }}"
      data-timing="{{ section.settings.timing }}"
    {% endif %}
  >
    <div class="page-width rte">
      {% if section.settings.type == 'arrows' %}
        <div class="announcement-slider">
          <button class="announcement-arrow prev">
            {% render 'icon', icon: 'chevron-left', width: '2rem', height: '2rem' %}
          </button>

          <div class="announcement-slides">
            {% for block in section.blocks %}
              {% if block.settings.text != blank %}
                <div class="announcement-slide">
                  <div class="announcement-wrap">
                    <div class="announcement-bar-text">
                      {{ block.settings.text }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <button class="announcement-arrow next">
            {% render 'icon', icon: 'chevron-right', width: '2rem', height: '2rem' %}
          </button>
        </div>

      {% else %}
        <div class="announcement-marquee-wrapper">
          <div class="announcement-marquee">
            <div class="announcement-marquee-content">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <div class="announcement-wrap">
                    <div class="announcement-bar-text">
                      {{ block.settings.text }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
            <div class="announcement-marquee-content">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <div class="announcement-wrap">
                    <div class="announcement-bar-text">
                      {{ block.settings.text }}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </announcement-bar>
{% endif %}
{% if section.settings.type == 'arrows' %}
  <script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "type",
      "label": "Type",
      "default": "auto_Scrolling",
      "options": [
        {
          "value": "arrows",
          "label": "Arrows"
        },
        {
          "value": "auto_Scrolling",
          "label": "Auto Scrolling"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "auto_rotated",
      "label": "Auto Rotated",
      "visible_if": "{{ section.settings.type == 'arrows' }}"
    },
    {
      "type": "range",
      "id": "timing",
      "label": "Change message every",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.auto_rotated == true  and section.settings.type == 'arrows'}}"
    },
    {
      "type": "range",
      "id": "scrolling_speed",
      "label": "Scrolling Speed",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "sec",
      "visible_if": "{{ section.settings.type == 'auto_Scrolling' }}"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Top Mobile",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Bottom Mobile",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Bar",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
 
{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}
<div {%- render 'section-variables', section: section, class: 'article-section' -%}>
  {% liquid
    assign background_color = section.settings.bg_color | default: settings.background_color
  %}
  {% liquid
    assign sub_color = section.settings.meta_color
    assign head_color = section.settings.heading_color
    assign block_color = section.settings.text_color
    assign tag = section.settings.heading_tag | default: 'h2'
    assign accent_color = section.settings.accent_color
    if section.settings.bg_color != 'rgba(0,0,0,0)'
      assign background_color = section.settings.bg_color
    else
      assign background_color = settings.background_color
    endif
  %}
  <div class="article-template" style="background: {{ background_color }};">
    <div class="page-width">
      <a
        href="{{ blog.url }}"
        class="article-back-btn"
        {% unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
          style="color: rgb({{ block_color.rgb }});"
        {% endunless %}
      >
        <span class="article-back-btn__icon text-sm"> ← </span>
        <span class="text-sm">{{ section.settings.back_label }}</span>
      </a>

      <div class="article-header ps-rte">
        <h1
          class="article-title {{ tag }}"
          {% unless head_color == blank or head_color == 'rgba(0,0,0,0)' %}
            style="color: rgb({{ head_color.rgb }});"
          {% endunless %}
        >
          {{ article.title }}
        </h1>

        <div
          class="article-meta"
          {% unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
            style="color: rgb({{ sub_color.rgb }});"
          {% endunless %}
        >
          {% if section.settings.show_author %}
            <div class="article-meta__item">
              <span>{{ article.author }}</span>
            </div>
          {% endif %}

          {% if section.settings.show_date %}
            <div class="article-meta__item">
              <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      {% if article.image and section.settings.show_featured_image %}
        <div class="article-featured-image">
          {{
            article.image
            | image_url: width: 1800
            | image_tag: loading: 'lazy', widths: '550,720,990,1200,1500,1800'
          }}
        </div>
      {% endif %}

      <div class="article-content ps-rte text-sm {{ section.settings.content_width }}{% if section.settings.enable_dropcap %} article-content--dropcap{% endif %}">
        {{ article.content }}
      </div>

      {% if blog.comments_enabled? and section.settings.show_comments %}
        <div class="article-comments">
          <h2>{{ 'blog.article_comments' | t }}</h2>

          <div id="comments">
            {% paginate article.comments by 10 %}
              {% for comment in article.comments %}
                <div class="article-comment">
                  <strong>{{ comment.author }}</strong>
                  <div>{{ comment.created_at | date: '%B %d, %Y' }}</div>
                  <p>{{ comment.content }}</p>
                </div>
              {% endfor %}

              {{ paginate | default_pagination }}
            {% endpaginate %}
          </div>

          {% form 'new_comment', article %}
            <h3>{{ 'blog.comment_form_title' | t }}</h3>

            {{ form.errors | default_errors }}

            <input
              type="text"
              name="comment[author]"
              value="{{ form.author }}"
              placeholder="{{ 'blog.comment_form_name' | t }}"
              required
            >

            <input
              type="email"
              name="comment[email]"
              value="{{ form.email }}"
              placeholder="{{ 'blog.comment_form_email' | t }}"
              required
            >

            <textarea
              name="comment[body]"
              placeholder="{{ 'blog.comment_form_body' | t }}"
              required
            >{{ form.body }}</textarea>

            <button type="submit">
              {{ 'blog.comment_form_submit' | t }}
            </button>
          {% endform %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
<style>
  .article-template {
    padding: 60px 0;
  }
  .article-header {
    display: flex;
    flex-direction: column;
    padding: 24px 0;
  }

  /* Back button alignment */
  .article-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .article-meta {
    display: flex;
    opacity: 0.7;
  }

  .article-content,
  .article-content p,
  .article-content span,
  .article-content ul,
  .article-content ol,
  .article-content li,
  .article-content table,
  .article-content td,
  .article-content th,
  .article-content tr {
    font-size: var(--text-sm);
  }
  .article-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .article-back-btn__icon {
    width: 38px;
    height: 38px;
    border: 1px solid;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .article-category {
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 10px;
  }

  .article-meta {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .article-featured-image {
    margin-bottom: 50px;
  }

  .article-featured-image img,
  .article-content img {
    width: 100%;
    display: block;
    min-height: var(--section-height-{{section.settings.slide_height}});
    height: 50rem;
  }

  .article-content img {
    width: 100%;
    display: block;
    margin: 40px 0;
  }

  .article-content a {
    color: rgb({{accent_color.rgb}});
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .article-content ul,
  .article-content ol {
    padding-left: 25px;
    margin: 25px 0;
  }

  .article-content blockquote {
    border-left: 4px solid rgb({{accent_color.rgb}});
    padding: 20px 30px;
    margin: 40px 0;
    background: rgba(0, 0, 0, 0.03);
  }

  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 40px 0;
  }

  .article-content th,
  .article-content td {
    padding: 16px;
    border: 1px solid;
    text-align: center;
  }

  .article-comments {
    margin-top: 60px;
  }

  .article-comment {
    padding: 20px 0;
    border-bottom: 1px solid;
  }

  .article-comments input,
  .article-comments textarea {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
  }

  .article-comments button {
    padding: 12px 24px;
    cursor: pointer;
  }

  @media screen and (max-width: 768px) {
    .article-template {
      padding: 40px 0;
    }

    .article-back-btn {
      margin-bottom: 30px;
    }

    .article-meta {
      gap: 15px;
    }

    .article-featured-image {
      margin-bottom: 30px;
    }
    .article-header {
      padding: 12px 0 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Article Template",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back Button Label",
      "default": "BACK"
    },

    {
      "type": "header",
      "content": "Featured Image Settings"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show Featured Image",
      "default": true
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Media height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "fullscreen", "label": "Fullscreen" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_featured_image == true }}"
    },

    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Default" },
        { "value": "page-width page-width--narrow", "label": "Narrow" },
        { "value": "page-width page-width--small", "label": "Small" },
        { "value": "page-width page-width--xs-small", "label": "Extra Small" },
        { "value": "full-width", "label": "Full Width" }
      ]
    },

    {
      "type": "header",
      "content": "Article Meta Settings"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show Comments",
      "default": true
    },

    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color"
    },

    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_dropcap",
      "label": "Enable First Letter Style",
      "default": true
    }
  ]
}
{% endschema %}

{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{{ 'article.css' | asset_url | stylesheet_tag }}


<div {%- render 'section-variables', section: section, class: 'article-section' -%}>
  {% liquid
    assign background_color = section.settings.bg_color | default: settings.background_color
  %}
  {% liquid
    assign sub_color = section.settings.meta_color
    assign head_color = section.settings.heading_color
    assign block_color = section.settings.text_color
    assign tag = section.settings.heading_tag | default: 'h2'
    assign accent_color = section.settings.accent_color
    if section.settings.bg_color != 'rgba(0,0,0,0)'
      assign background_color = section.settings.bg_color
    else
      assign background_color = settings.background_color
    endif
  %}
  <div class="article-template" style="background: {{ background_color }};">
    <div class="page-width">
      <a
        href="{{ blog.url }}"
        class="article-back-btn"
        {% unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
          style="color: rgb({{ block_color.rgb }});"
        {% endunless %}
      >
        <span class="article-back-btn__icon text-sm"> ← </span>
        <span class="text-sm">{{ section.settings.back_label }}</span>
      </a>

      <div class="article-header ps-rte">
        <h1
          class="article-title {{ tag }}"
          {% unless head_color == blank or head_color == 'rgba(0,0,0,0)' %}
            style="color: rgb({{ head_color.rgb }});"
          {% endunless %}
        >
          {{ article.title }}
        </h1>

        <div
          class="article-meta"
          {% unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
            style="color: rgb({{ sub_color.rgb }});"
          {% endunless %}
        >
          {% if section.settings.show_author %}
            <div class="article-meta__item">
              <span>{{ article.author }}</span>
            </div>
          {% endif %}

          {% if section.settings.show_date %}
            <div class="article-meta__item">
              <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
            </div>
          {% endif %}
        </div>
      </div>

      {% if article.image and section.settings.show_featured_image %}
        <div class="article-featured-image">
          {{
            article.image
            | image_url: width: 1800
            | image_tag: loading: 'lazy', widths: '550,720,990,1200,1500,1800'
          }}
        </div>
      {% endif %}

      <div class="article-content ps-rte text-sm {{ section.settings.content_width }}{% if section.settings.enable_dropcap %} article-content--dropcap{% endif %}">
        {{ article.content }}
      </div>

      {% if blog.comments_enabled? and section.settings.show_comments %}
        <div class="article-comments">
          <h2 class="article-comments__title">
            {%- if section.settings.comments_heading != blank -%}
              {{ section.settings.comments_heading }}
            {%- else -%}
              {{ 'blog.comment_form_title' | t }}
            {%- endif -%}
          </h2>

          {%- form 'new_comment', article, id: 'ArticleCommentForm', class: 'article-comment-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status form__message success-msg" tabindex="-1" autofocus>
                {{- 'icon-success.svg' | inline_asset_content -}}
                {{ section.settings.comment_success_message }}
              </div>
            {%- elsif form.errors -%}
              <div class="form__message">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- liquid
              assign comment_first_name = ''
              assign comment_last_name = ''
              if form.author != blank
                assign author_parts = form.author | split: ' '
                assign comment_first_name = author_parts.first
                if author_parts.size > 1
                  assign comment_last_name = author_parts | slice: 1, author_parts.size | join: ' '
                endif
              endif
            -%}

            <input type="hidden" name="comment[author]" id="CommentForm-author" value="{{ form.author }}">

            <div class="article-comment-form__fields">
              <div class="article-comment-form__row">
                <div class="field">
                  <input
                    class="field__input text-lg"
                    type="text"
                    id="CommentForm-first-name"
                    autocomplete="given-name"
                    value="{{ comment_first_name }}"
                    placeholder="{{ 'contact_form.first_name' | t }}"
                    required
                  >
                  
                </div>

                <div class="field">
                  <input
                    class="field__input text-lg"
                    type="text"
                    id="CommentForm-last-name"
                    autocomplete="family-name"
                    value="{{ comment_last_name }}"
                    placeholder="{{ 'contact_form.last_name' | t }}"
                    required
                  >
                </div>
              </div>

              <div class="field">
                <input
                  class="field__input text-lg"
                  type="email"
                  id="CommentForm-email"
                  name="comment[email]"
                  autocomplete="email"
                  value="{{ form.email }}"
                  placeholder="{{ 'blog.comment_form_email' | t }}"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                >
              </div>

              <div class="field">
                <textarea
                  class="text-area field__input text-lg"
                  id="CommentForm-body"
                  name="comment[body]"
                  rows="6"
                  placeholder="{{ 'blog.comment_form_body' | t }}"
                  required
                >{{ form.body }}</textarea>
              
              </div>
            </div>

            <div class="article-comment-form__submit">
              <button type="submit" class="button">
                {{ 'blog.comment_form_submit' | t }}
              </button>
            </div>
          {%- endform -%}

          <div id="comments" class="article-comments__list{% if article.comments_count > 0 %} article-comments__list--has-comments{% endif %}">
            {%- if article.comments_count > 0 -%}
              <h3 class="article-comments__list-title">
                {{ 'blog.article_comments' | t }}
                <span class="article-comments__count">({{ article.comments_count }})</span>
              </h3>

              {%- paginate article.comments by section.settings.comments_per_page -%}
                {%- for comment in article.comments -%}
                  <article class="article-comment">
                    <header class="article-comment__header">
                      <strong class="article-comment__author">{{ comment.author }}</strong>
                      <time class="article-comment__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                        {{ comment.created_at | date: '%B %d, %Y' }}
                      </time>
                    </header>
                    <div class="article-comment__content">{{ comment.content }}</div>
                  </article>
                {%- endfor -%}

                {%- if paginate.pages > 1 -%}
                  <div class="article-comments__pagination">
                    {{ paginate | default_pagination }}
                  </div>
                {%- endif -%}
              {%- endpaginate -%}
            {%- endif -%}
          </div>
        </div>

        <script>
          (function () {
            var form = document.getElementById('ArticleCommentForm');
            if (!form) return;

            form.addEventListener('submit', function () {
              var firstName = document.getElementById('CommentForm-first-name').value.trim();
              var lastName = document.getElementById('CommentForm-last-name').value.trim();
              document.getElementById('CommentForm-author').value = (firstName + ' ' + lastName).trim();
            });

            {%- if form.posted_successfully? -%}
              form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            {%- endif -%}
          })();
        </script>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .article-featured-image img,
  .article-content img {
    min-height: var(--section-height-{{section.settings.slide_height}});
  }

  .article-content a {
    color: rgb({{accent_color.rgb}});
  }

  .article-content blockquote {
    border-left: 0.4rem solid rgb({{accent_color.rgb}});
  }
</style>

{% schema %}
{
  "name": "Custom Article Template",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back Button Label",
      "default": "BACK"
    },

    {
      "type": "header",
      "content": "Featured Image Settings"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show Featured Image",
      "default": true
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Media height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "fullscreen", "label": "Fullscreen" }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_featured_image == true }}"
    },

    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Default" },
        { "value": "page-width page-width--narrow", "label": "Narrow" },
        { "value": "page-width page-width--small", "label": "Small" },
        { "value": "page-width page-width--xs-small", "label": "Extra Small" },
        { "value": "full-width", "label": "Full Width" }
      ]
    },

    {
      "type": "header",
      "content": "Article Meta Settings"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "header",
      "content": "Comments Settings"
    },
    {
      "type": "paragraph",
      "content": "Comments must also be enabled in Shopify admin: Online Store > Blog posts > Manage comments."
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Allow customer comments",
      "default": true
    },
    {
      "type": "text",
      "id": "comments_heading",
      "label": "Comment form heading",
      "default": "Leave a comment"
    },
    {
      "type": "text",
      "id": "comment_success_message",
      "label": "Comment success message",
      "default": "Thank you! Your comment was submitted successfully.",
      "visible_if": "{{ section.settings.show_comments == true }}"
    },
    {
      "type": "range",
      "id": "comments_per_page",
      "min": 5,
      "max": 50,
      "step": 5,
      "label": "Comments per page",
      "default": 10,
      "visible_if": "{{ section.settings.show_comments == true }}"
    },

    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content Color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_dropcap",
      "label": "Enable First Letter Style",
      "default": true
    }
  ]
}
{% endschema %}

{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{% paginate blog.articles by section.settings.posts_per_page %}
  <div {%- render 'section-variables', section: section, class: 'custom-articles-section' -%}>
    {% liquid
      assign sub_color = section.settings.subheading_color
      assign head_color = section.settings.heading_color
      assign block_color = section.settings.text_color
      assign tag = section.settings.heading_tag | default: 'h2'
      if section.settings.bg_color != 'rgba(0,0,0,0)'
        assign background_color = section.settings.bg_color
      else
        assign background_color = settings.background_color
      endif
    %}
    <div class="page-width">
      <div class="blog-template-header ps-rte">
        {% if section.settings.subheading != blank %}
          <div
            class="blog-template-subheading subheading"
            {% unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
              style="color: rgb({{ sub_color.rgb }});"
            {% endunless %}
          >
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        <h2
          class="blog-template-heading {{ tag }}"
          {% unless head_color == blank or head_color == 'rgba(0,0,0,0)' %}
            style="color: rgb({{ head_color.rgb }});"
          {% endunless %}
        >
          {% if section.settings.heading != blank %}
            {{ section.settings.heading }}
          {% else %}
            {{ blog.title }}
          {% endif %}
        </h2>

        {% if section.settings.description != blank %}
          <div
            class="blog-template-description text-sm"
            {% unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
              style="color: rgb({{ block_color.rgb }});"
            {% endunless %}
          >
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="blog-grid grid md:grid--{{ section.settings.blogs_per_row }}-col xs:grid--2-col">
        {% for article in blog.articles %}
          <article class="blog-card{% if section.settings.first_article_full_width and forloop.first %} blog-card--featured{% endif %}">
            {%- render 'article-card',
              article: article,
              media_height: section.settings.image_ratio,
              show_image: section.settings.show_image,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt,
              read_more_label: section.settings.read_more_label,
              settings: settings
            -%}
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="pagination-wrapper">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    </div>
  </div>
{% endpaginate %}
<style>
  .custom-articles-section{
    background: {{ background_color }};
  }
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding: 60px 0;
  }

  .blog-template-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .blog-template-subheading {
    text-transform: uppercase;
    letter-spacing: .15rem;
  }

  .blog-template-description {
    max-width: 72rem;
    margin-inline: auto;
  }

  .blog-card {
    background: transparent;
    border: 0;
    overflow: hidden;
    height: 100%;
  }

  .article-card-wrapper {
    height: 100%;
    border-radius: var(--media-radius);
  }

  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .article-card__image-wrapper {
    overflow: hidden;
    border-radius: var(--media-radius);
  }

  .article-card__image {
    position: relative;
    overflow: hidden;
  }

  .article-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .ratio-square {
    aspect-ratio: 1 / 1;
  }

  .ratio-portrait {
    aspect-ratio: 4 / 5;
  }

  .ratio-adapt img {
    height: auto;
    object-fit: contain;
  }
  .card__information {
    display: flex;
    flex-direction: column;
  }

  .article-card__info {
    opacity: .7;
  }

  .card__heading {
    line-height: 1.3;
  }

  .card__heading a {
    text-decoration: none;
    color: inherit;
    transition: opacity .3s ease;
  }

  .card__heading a:hover {
    opacity: .7;
  }
  .ps-rte .card__heading a:hover{
    color: currentColor;
  }
  .article-card__excerpt {
    line-height: 1.6;
  }

  .blog-read-more {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 500;
    color: inherit;
    padding-bottom: 2px;
  }

  .blog-read-more:hover {
    opacity: .7;
  }

  .pagination-wrapper {
    text-align: center;
  }

  .pagination-wrapper .pagination {
    display: flex;
    justify-content: center;
    gap: .8rem;
    flex-wrap: wrap;
  }

  .pagination-wrapper a,
  .pagination-wrapper span {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, .15);
    transition: all .2s ease;
  }

  .pagination-wrapper a:hover {
    background: rgba(0, 0, 0, .05);
  }
  .blog-card--featured {
    grid-column: 1 / -1;
  }

  .blog-card--featured .article-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  .blog-card--featured .article-card__image-wrapper {
    margin-bottom: 0;
  }
  .blog-card--featured .article-card__image-wrapper,
  .blog-card--featured .article-card__image img{
    border-radius: var(--media-radius) 0 0 var(--media-radius);
  }
  {% if section.settings.zoom_effect %}
    .blog-card:hover .article-card__image img,
    .article-card:hover .article-card__image img {
      transform: scale(1.05);
    }
  {% endif %}
   {% if section.settings.card_style == true %}
    .card__content {
      padding: 16px;
    }
    .article-card__image-wrapper,
    .article-card__image img{
      border-radius: var(--media-radius) var(--media-radius) 0 0;
    }
    @media screen and (max-width: 768px) {
      .blog-card--featured .article-card__image-wrapper,
      .blog-card--featured .article-card__image img{
        border-radius: var(--media-radius) var(--media-radius) 0 0;
      }
    }
  {% else %}
    .card__content {
      padding-top: 16px;
    }
    .blog-card--featured .card__content{
      padding: 16px;
    }
    .blog-card--featured .article-card__image-wrapper,
    .blog-card--featured .article-card__image img{
      border-radius: var(--media-radius);
    }
    @media screen and (max-width: 768px) {
      .blog-card--featured .card__content{
        padding: 16px 0 0 0;
      }
    }
  {% endif %}
  @media screen and (max-width: 768px) {
    .blog-card--featured .article-card {
      grid-template-columns: 1fr;
    }
    .blog-template-header{
      margin-bottom: 2rem;
    }
  }
</style>
{% schema %}
{
  "name": "Blog Template",
  "settings": [
    {
      "type": "header",
      "content": "Blog Header Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Layout & Grid Settings"
    },
    {
      "type": "checkbox",
      "id": "first_article_full_width",
      "label": "First Article Full Width",
      "default": false
    },
    {
      "type": "range",
      "id": "blogs_per_row",
      "label": "Blogs Per Row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts Per Page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Article Image Settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "default": "adapt",
      "visible_if": "{{ section.settings.show_image == true }}",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "zoom_effect",
      "label": "Enable Image Zoom",
      "default": true,
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "header",
      "content": "Article Content Settings"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read More Label",
      "default": "Read More"
    },
    {
      "type": "header",
      "content": "Section Color Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "checkbox",
      "id": "card_style",
      "label": "Enable Card Style",
      "default": false,
      "info": "Enable this option to use custom styling for the article card."
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Heading Color",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "author_date",
      "label": "Author and Date",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card Text",
      "visible_if": "{{ section.settings.card_style == true }}"
    }
  ]
}
{% endschema %}

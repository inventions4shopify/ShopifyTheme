{% comment %}
  Cart page section — /cart template.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{{ 'cart.css' | asset_url | stylesheet_tag }}

<cart-page
  class="cart-page page-width{% if cart == empty %} is-empty{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="cart-page__celebration" data-cart-celebration aria-hidden="true" hidden></div>

  <div data-cart-page-contents>
    {% render 'cart-page-content' %}
  </div>

  <div class="cart-page__loading" data-cart-loading aria-hidden="true">
    {% render 'loading-spinner' %}
  </div>
</cart-page>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}

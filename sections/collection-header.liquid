{% comment %}
  Collection page header banner — title, description, and optional background image.
  Extracted from collection.liquid for use as a standalone section.
{% endcomment %}

{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<style>
  {% if section.settings.show_bg_image %}
    #shopify-section-{{ section.id }} .cms-main-collection-banner .main-page__section {
      background-image: url(
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 }}
        {% elsif collection.featured_image %}
          {{ collection.featured_image | image_url: width: 2000 }}
        {% endif %}
      );
    }
  {% endif %}

  #shopify-section-{{ section.id }} .cms-main-collection-banner .main-page__overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
  }

  {% if section.settings.container_width == 'custom' and section.settings.custom_container_width > 0 %}
    #shopify-section-{{ section.id }} .main-page__container--custom {
      max-width: {{ section.settings.custom_container_width }}px;
    }
  {% endif %}
</style>

{%- liquid
  assign s = section.settings
  assign container_class = 'page-width'

  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  elsif s.container_width == 'narrow'
    assign container_class = 'page-width page-width--narrow'
  elsif s.container_width == 'small'
    assign container_class = 'page-width page-width--small'
  elsif s.container_width == 'custom'
    assign container_class = 'page-width main-page__container--custom'
  endif

  assign align_class = 'text-' | append: s.content_alignment
  assign tag = s.heading_tag | default: 'h2'

  assign banner_has_image = false
  if s.show_bg_image
    if s.image != blank or collection.featured_image != blank
      assign banner_has_image = true
    endif
  endif
-%}

<div class="cms-main-collection-banner{% if banner_has_image %} image_media--{{ s.media_height }}{% else %} cms-main-collection-banner--compact{% endif %}">
  <div
    {%- render 'section-variables',
      section: section,
      class: 'main-page__section',
      spacing: false
    -%}
  >
    {% if banner_has_image %}
      <div class="main-page__overlay"></div>
    {% endif %}

    <div class="main-page__inner">
      <div class="{{ container_class }}">
        <div class="main-page__content flex flex-col {{ align_class }}">
          {% if section.settings.subheading != blank %}
            <div class="page-subheading subheading">
              {{ section.settings.subheading }}
            </div>
          {% endif %}

          <{{ tag }} class="page-heading heading {{ tag }}">
            {% if section.settings.heading != blank %}
              {{ section.settings.heading }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </{{ tag }}>

          {% if collection.description != blank %}
            <div class="page-description text-sm" style="color: {{ section.settings.text_color }};">
              {{ collection.description }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection header",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Layout Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" }
      ],
      "default": "24"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "checkbox",
      "id": "show_bg_image",
      "label": "Show background image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.show_bg_image == true }}"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.show_bg_image == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_bg_image == true }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "visible_if": "{{ section.settings.show_bg_image == true }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Collection header"
    }
  ]
}
{% endschema %}

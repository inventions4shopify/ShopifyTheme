{{ 'collection-list.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }} .collection-card {
    background-color:
      {% if section.settings.card_bg_color != blank or section.settings.card_bg_color != 'rgba(0,0,0,0)' %}
        {{ section.settings.card_bg_color }}
      {% else %}
        rgb(var(--color-product-card-background))
      {% endif %};
  }

  .section-{{ section.id }} .collection-card__content > * {
    color:
      {% if section.settings.card_heading_color != blank or section.settings.card_heading_color != 'rgba(0,0,0,0)' %}
        {{ section.settings.card_heading_color }}
      {% else %}
        rgb(var(--color-product-card-text))
      {% endif %};
  }

</style>

{% liquid
  assign columns = section.settings.columns

  assign s = section.settings

  # ── Container width ──────────────────────────────────────────────────────
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  endif

  # ── Alignment class ───────────────────────────────────────────────────────
  assign align_value = s.content_alignment | default: 'center'
  assign align_class = 'text-' | append: align_value
%}

<div {%- render 'section-variables', section: section, class: 'collection-list__section' -%}>
  <div class="{{ container_class }}">
    <div class="collection-list-header 123 {{ align_class }}">
      {%- render 'section-header',
        subheading:    section.settings.subheading,
        heading:       section.settings.heading,
        content:       section.settings.description,
        text_alignment: align_value
      -%}
    </div>
    <collection-list-section
      class="collection-wrapper-main section-{{ section.id }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    >
      <div id="collection-slider-{{ section.id }}" class="collection-grid columns-{{ columns }} {% if section.settings.layout == 'slider' %}is-slider flex{% else %}is-grid grid grid--{{ section.settings.mobile_column_count }}-col md:grid--3-col lg:grid--4-col{% endif %}">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}
            {% assign collection_image = collection.featured_image %}
            {% if collection_image == blank and collection.products.first %}
              {% assign collection_image = collection.products.first.featured_image %}
            {% endif %}
            <a
              href="{{ collection.url }}"
              class="collection-card"
              {{ block.shopify_attributes }}
            >
              <div class="collection-card__image">
                {% if block.settings.custom_image %}
                  {{
                    block.settings.custom_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320,480,640,800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      alt: 'collection thumb'
                  }}
                {% elsif collection_image %}
                  {{
                    collection_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320,480,640,800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      alt: 'collection thumb'
                  }}
                {% else %}
                  <img
                    src="{{ 'thumbnail.svg' | asset_url }}"
                    alt="collection thumb"
                    loading="lazy"
                    width="auto"
                    height="auto">
                {% endif %}
              </div>
              {%- assign align_value = s.collection_heading_alignment | default: 'center' -%}
              {%- assign align_class = 'text-' | append: align_value -%}
              <div class="collection-card__content {{ align_class }} justify-{{align_value}}">
                {%- if collection.title -%}
                  <h3 class="collection__heading h5">
                    {{ collection.title | escape }}
                  </h3>
                {%- endif -%}
                {%if s.collection_heading_alignment == 'start' %}
                  <span>
                    {% render 'icon', icon: 'arrow-right', width: 24, height: 24 %}
                  </span>
                {% endif %}
              </div>
            </a>
        {% endfor %}
      </div>
      {% if s.layout == 'slider' %}
        {% if s.show_arrow %}
          <div class="collection-grid-slider-arrow-btn flex">
            <button class="collection-grid-prev button" aria-label="previous slide">{% render 'icon', icon: 'chevron-left', width: '2.4rem', height: '2.4rem' %}</button>
            <button class="collection-grid-next button" aria-label="next slide">{% render 'icon', icon: 'chevron-right', width: '2.4rem', height: '2.4rem' %}</button>
          </div>
        {% endif %}
      {% endif %}
    </collection-list-section>
  </div>
</div>

<script src="{{ 'collection-list.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Collection List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Latest Collecton"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Text",
      "default": "<p>Most Populer Products</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" },
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "collection_heading_alignment",
      "label": "Card Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Enable Arrow",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay Speed",
      "default": 5,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_column_count",
      "label": "Mobile Columns",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Heading",
          "default": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
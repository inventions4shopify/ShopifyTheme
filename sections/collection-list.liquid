<style>
.collection-grid.is-slider {
  overflow:hidden;
  gap: var(--spacing-20);
  transition: transform 0.5s ease;
  scroll-behavior: auto;
}
.collection-grid.columns-4.is-slider.collection-mobile-grid-2 .collection-card,
.collection-grid.columns-3.is-slider.collection-mobile-grid-2 .collection-card,
.collection-grid.columns-2.is-slider.collection-mobile-grid-2 .collection-card,
.collection-grid.columns-1.is-slider.collection-mobile-grid-2 .collection-card {
  flex: 0 0 calc((100% - 2rem) / {{ section.settings.mobile_column_count }});
  flex-shrink:0;
}
.collection-grid.columns-4.is-slider .collection-card,
.collection-grid.columns-3.is-slider .collection-card,
.collection-grid.columns-2.is-slider .collection-card,
.collection-grid.columns-1.is-slider .collection-card {
  flex: 0 0 calc((100% - 0rem) / {{ section.settings.mobile_column_count }});
  flex-shrink:0;
}
.collection-grid.is-grid.columns-4,
.collection-grid.is-grid.columns-3,
.collection-grid.is-grid.columns-2,
.collection-grid.is-grid.columns-1 {
  grid-template-columns: repeat({{ section.settings.mobile_column_count }}, 1fr);
}
.collection-grid-slider-arrow-btn {
  width: 100%;
  justify-content: center;
  margin-top: 3rem;
  gap: var(--spacing-16);
}
.collection-grid-slider-arrow-btn button {
  cursor: pointer;
  padding: 0;
  width: 3rem;
  height: 3rem;
}
.collection-grid-slider-arrow-btn button svg.icon {
  width: 1.8rem;
  height: 1.8rem;
}
.collection-card {
  display: block;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
  border-radius: var(--input-radius);
  background: {{ section.settings.card_bg_color }};
}

.collection-card__image img,
.collection-card__image svg {
  width: 100%;
  height: auto;
  object-fit: cover;
  display: block;
}
h3.collection__heading {
  margin-bottom: 0;
}
.collection-card__content {
  padding: 1.6rem;
}
@media (min-width: 576px) {
  .collection-grid-slider-arrow-btn button {
    width: 4rem;
    height: 4rem;
  }
  .collection-grid-slider-arrow-btn button svg.icon {
    width: 2.4rem;
    height: 2.4rem;
  }
  .collection-grid.is-grid.columns-4,
  .collection-grid.is-grid.columns-3,
  .collection-grid.is-grid.columns-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .collection-grid.columns-4.is-slider .collection-card,
  .collection-grid.columns-3.is-slider .collection-card,
  .collection-grid.columns-2.is-slider .collection-card {
    flex: 0 0 calc((100% - 2rem) / 2) !important;
  }
}
@media (min-width: 992px) {
  .collection-grid.is-grid.columns-4,
  .collection-grid.is-grid.columns-3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .collection-grid.columns-4.is-slider .collection-card,
  .collection-grid.columns-3.is-slider .collection-card {
    flex: 0 0 calc((100% - 4rem) / 3) !important;
  }
}
@media (min-width: 1200px) {
  .collection-grid.is-grid.columns-4 {
    grid-template-columns: repeat(4, 1fr);
  }
  .collection-grid.columns-4.is-slider .collection-card {
    flex: 0 0 calc((100% - 6rem) / 4) !important;
  }
}
</style>

{% liquid
  assign columns = section.settings.columns

  assign s = section.settings

  # ── Container width ──────────────────────────────────────────────────────
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  endif

  # ── Alignment class ───────────────────────────────────────────────────────
  assign align_value = s.content_alignment | default: 'center'
  assign align_class = 'text-' | append: align_value
%}

<div {%- render 'section-variables', section: section, class: 'collection-list__section' -%}>
  <div class="{{ container_class }}">
    <div class="collection-list-header {{ align_class }}">
      {%- render 'section-header',
        subheading:    section.settings.subheading,
        heading:       section.settings.heading,
        content:       section.settings.description,
        text_alignment: 'center'
      -%}
    </div>
    <div class="collection-wrapper-main">
      <div class="collection-grid columns-{{ columns }} {% if section.settings.layout == 'slider' %}is-slider flex{% else %}is-grid grid{% endif %} collection-mobile-grid-{{ section.settings.mobile_column_count }}">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}
          {% if collection != blank %}
            {% assign collection_image = collection.featured_image %}
            {% if collection_image == blank and collection.products.first %}
              {% assign collection_image = collection.products.first.featured_image %}
            {% endif %}
            <a
              href="{{ collection.url }}"
              class="collection-card"
              {{ block.shopify_attributes }}
            >
              <div class="collection-card__image">
                {% if block.settings.custom_image != blank %}
                  {{
                    block.settings.custom_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320,480,640,800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      alt: collection.title
                  }}
                  {% else collection_image != blank %}
                  {{
                    collection_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320,480,640,800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      alt: collection.title
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
              {%- assign align_value = s.collection_heading_alignment | default: 'center' -%}
              {%- assign align_class = 'text-' | append: align_value -%}
              <div class="collection-card__content {{ align_class }}">
                {%- capture heading_style -%}
                    --color-heading: {{ head_color.rgb }};
                {%- endcapture -%}
                  {%if block.settings.custom_title != blank %}
                    <h3 class="collection__heading h5">{{ block.settings.custom_title }} </h3>
                  {%  else %}
                    <h3 class="collection__heading h5">{{- collection.title | escape -}} </h3>
                  {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% if section.settings.layout == 'slider' %}
        {% if section.settings.show_arrow %}
          <div class="collection-grid-slider-arrow-btn flex">
            <button class="collection-grid-prev button">{% render 'icon', icon: 'chevron-left', width: '2.4rem', height: '2.4rem' %}</button>
            <button class="collection-grid-next button">{% render 'icon', icon: 'chevron-right', width: '2.4rem', height: '2.4rem' %}</button>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const slider = document.querySelector('.collection-grid.is-slider');
  const nextBtn = document.querySelector('.collection-grid-next');
  const prevBtn = document.querySelector('.collection-grid-prev');

  if (!slider) return;

  const autoplayEnabled = {{ section.settings.autoplay | json }};
  const autoplaySpeed = {{ section.settings.autoplay_speed }} * 1000;

  // Clone first and last slides
  const slides = [...slider.querySelectorAll('.collection-card')];

  slides.forEach(slide => {
    const clone = slide.cloneNode(true);
    clone.classList.add('clone');
    slider.appendChild(clone);
  });

  const getScrollAmount = () => {
    const card = slider.querySelector('.collection-card');
    return card ? card.offsetWidth + 20 : 300;
  };

  let currentIndex = 0;
  const originalCount = slides.length;

  function goToSlide(index, smooth = true) {
    slider.scrollTo({
      left: index * getScrollAmount(),
      behavior: smooth ? 'smooth' : 'auto'
    });
  }

  nextBtn?.addEventListener('click', () => {
    currentIndex++;
    goToSlide(currentIndex);
  });

  prevBtn?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      goToSlide(currentIndex);
    }
  });

  slider.addEventListener('scroll', () => {
    if (
      currentIndex >= originalCount &&
      slider.scrollLeft >= originalCount * getScrollAmount() - 5
    ) {
      setTimeout(() => {
        currentIndex = 0;
        goToSlide(0, false);
      }, 400);
    }
  });

  let autoSlide;

  function startAutoplay() {
    if (!autoplayEnabled) return;

    stopAutoplay();

    autoSlide = setInterval(() => {
      currentIndex++;
      goToSlide(currentIndex);
    }, autoplaySpeed);
  }

  function stopAutoplay() {
    clearInterval(autoSlide);
  }

  if (autoplayEnabled) {
    startAutoplay();

    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);

    slider.addEventListener('touchstart', stopAutoplay, { passive: true });
    slider.addEventListener('touchend', startAutoplay, { passive: true });
  }
});
</script>

{% schema %}
{
  "name": "Collection List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection List"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Text",
      "default": "<p>Most Populer Products</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" },
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "collection_heading_alignment",
      "label": "Card Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Enable Arrow",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Autoplay Speed",
      "default": 5,
      "visible_if": "{{ section.settings.layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_column_count",
      "label": "Mobile Columns",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List"
    }
  ]
}
{% endschema %}
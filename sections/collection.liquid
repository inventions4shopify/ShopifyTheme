{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<main-collection-section
  data-section-id="{{ section.id }}"
  {%- render 'section-variables', section: section, class: 'cms-main-collection' -%}
>  
  <div class="page-width">
    {% paginate collection.products by section.settings.card_per_page %}

      {% capture collection_filters %}
        <form method="get" action="{{ collection.url }}" data-collection-filter>

          {% for filter in collection.filters %}
            <div class="cms-filter-group">

              <!-- CLOSED BY DEFAULT -->
              <details class="cms-filter-accordion">

                <summary class="cms-filter-accordion-title">
                  <span class="cms-filter-label">{{ filter.label }}</span>
                  <span class="cms-filter-icon">
                    {% render 'icon', icon: 'chevron-bottom', width: 18, height: 18 %}
                  </span>
                </summary>

                <div class="cms-filter-accordion-content">

                  {% case filter.type %}

                    {% when 'list', 'boolean' %}
                      {% for value in filter.values %}
                        <label class="cms-filter-option">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                          >
                          <span>
                            {{ value.label }} <strong>({{ value.count }})</strong>
                          </span>
                        </label>
                      {% endfor %}

                    {% when 'price_range' %}
                      {%- liquid
                        assign price_range_min = filter.range_min | divided_by: 100.0
                        assign price_range_max = filter.range_max | divided_by: 100.0
                        assign price_step = 1
                        assign price_round = 0
                        if price_range_max < 100
                          assign price_step = 0.01
                          assign price_round = 2
                        endif

                        assign price_current_min = price_range_min
                        if filter.min_value.value != blank
                          assign price_current_min = filter.min_value.value | divided_by: 100.0
                        endif

                        assign price_current_max = price_range_max
                        if filter.max_value.value != blank
                          assign price_current_max = filter.max_value.value | divided_by: 100.0
                        endif

                        assign price_input_min = ''
                        if filter.min_value.value != blank
                          assign price_input_min = filter.min_value.value | divided_by: 100.0 | round: price_round
                        endif

                        assign price_input_max = ''
                        if filter.max_value.value != blank
                          assign price_input_max = filter.max_value.value | divided_by: 100.0 | round: price_round
                        endif
                      -%}

                      <price-range-filter
                        class="price-range-filter"
                        data-range-min="{{ price_range_min }}"
                        data-range-max="{{ price_range_max }}"
                        data-price-step="{{ price_step }}"
                      >
                        <div class="price-range-filter__slider" data-price-slider>
                          <div class="price-range-filter__track">
                            <div class="price-range-filter__progress" data-price-progress></div>
                          </div>
                          <input
                            type="range"
                            class="price-range-filter__range price-range-filter__range--min"
                            data-price-range-min
                            min="{{ price_range_min }}"
                            max="{{ price_range_max }}"
                            value="{{ price_current_min }}"
                            step="{{ price_step }}"
                            aria-label="{{ filter.label }} minimum"
                          >
                          <input
                            type="range"
                            class="price-range-filter__range price-range-filter__range--max"
                            data-price-range-max
                            min="{{ price_range_min }}"
                            max="{{ price_range_max }}"
                            value="{{ price_current_max }}"
                            step="{{ price_step }}"
                            aria-label="{{ filter.label }} maximum"
                          >
                        </div>

                        <div class="price-range">
                          <div class="field price-range__field">
                            <input
                              type="number"
                              class="field__input text-sm"
                              id="Filter-Price-{{ section.id }}-{{ forloop.index }}-min"
                              name="{{ filter.min_value.param_name }}"
                              placeholder="{{ price_range_min | round: price_round }}"
                              value="{{ price_input_min }}"
                              min="{{ price_range_min }}"
                              max="{{ price_range_max }}"
                              step="{{ price_step }}"
                              inputmode="decimal"
                              data-price-input-min
                            >
                          </div>

                          <span class="price-range__separator" aria-hidden="true">–</span>

                          <div class="field price-range__field">
                            <input
                              type="number"
                              class="field__input text-sm"
                              id="Filter-Price-{{ section.id }}-{{ forloop.index }}-max"
                              name="{{ filter.max_value.param_name }}"
                              placeholder="{{ price_range_max | round: price_round }}"
                              value="{{ price_input_max }}"
                              min="{{ price_range_min }}"
                              max="{{ price_range_max }}"
                              step="{{ price_step }}"
                              inputmode="decimal"
                              data-price-input-max
                            >
                          </div>
                        </div>
                      </price-range-filter>

                  {% endcase %}

                </div>

              </details>

            </div>
          {% endfor %}

        </form>
      {% endcapture %}


      {%- liquid
        if collection.sort_by != blank
          assign filter_clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
        else
          assign filter_clear_url = collection.url
        endif

        assign has_active_filters = false
        for filter in collection.filters
          if filter.active_values.size > 0
            assign has_active_filters = true
            break
          endif
        endfor

        assign show_filter_empty = false
        if collection.products_count == 0 and has_active_filters
          assign show_filter_empty = true
        endif
      -%}

      <div id="CollectionAjaxContainer" data-collection-ajax>
      {% render 'collection-filter-sort-row',
        show_filter: section.settings.show_filter,
        filter_position: section.settings.filter_position,
        filters: collection.filters,
        clear_url: filter_clear_url,
        filters_markup: collection_filters,
        products_count: collection.products_count,
        sort_options: collection.sort_options,
        sort_by: collection.sort_by,
        default_sort_by: collection.default_sort_by,
        show_total_product: section.settings.show_total_product,
        show_sort: section.settings.show_sort,
        show_layout: section.settings.show_layout
      %}

      <!-- SIDEBAR LAYOUT -->
      {% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %}

        <div class="cms-main-collection-grid cms-main-collection-grid--sidebar">

          <aside class="cms-collection-sidebar">
            {{ collection_filters }}
          </aside>

          <div class="collection-products">
            {% if show_filter_empty %}
              {% render 'collection-filter-empty' %}
            {% else %}
              <div class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col">
                {% for product in collection.products %}
                  {% render 'product-card',
                    product: product,
                    show_vendor: settings.show_vendor,
                    show_secondary_image: settings.show_secondary_image,
                    show_quick_buy: settings.show_quick_buy,
                    show_rating: settings.show_rating,
                    rating_display: settings.rating_display,
                    show_sold_out_badge: settings.show_sold_out_badge,
                    show_discount_badge: settings.show_discount_badge,
                    discount_type: settings.discount_type,
                    color_display_mode: settings.color_display_mode,
                    image_ratio: settings.image_ratio,
                    content_alignment: settings.content_alignment,
                    style: settings.style
                  %}
                {% endfor %}
              </div>
              {% render 'pagination', paginate: paginate %}
            {% endif %}
          </div>

        </div>

      {% else %}

        <!-- DEFAULT GRID -->
        <div class="collection-products">
          {% if show_filter_empty %}
            {% render 'collection-filter-empty' %}
          {% else %}
            <div class="grid grid--2-col sm:grid--3-col lg:grid--4-col">
              {% for product in collection.products %}
                {% render 'product-card',
                  product: product,
                  show_vendor: settings.show_vendor,
                  show_secondary_image: settings.show_secondary_image,
                  show_quick_buy: settings.show_quick_buy,
                  show_rating: settings.show_rating,
                  rating_display: settings.rating_display,
                  show_sold_out_badge: settings.show_sold_out_badge,
                  show_discount_badge: settings.show_discount_badge,
                  discount_type: settings.discount_type,
                  color_display_mode: settings.color_display_mode,
                  image_ratio: settings.image_ratio,
                  content_alignment: settings.content_alignment,
                  style: settings.style
                %}
              {% endfor %}
            </div>

            {% render 'pagination', paginate: paginate %}
          {% endif %}
        </div>

      {% endif %}

      </div>

    {% endpaginate %}

  </div>

</main-collection-section>

<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "card_per_page",
      "min": 8,
      "max": 40,
      "step": 1,
      "label": "Card Per Page",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Card Per Page",
      "default": 3
    },
    {
      "type": "header",
      "content": "Filter & sort"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.show_filter == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_total_product",
      "label": "Show Total Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout",
      "label": "Show Layout",
      "default": true
    }
  ]
}
{% endschema %}

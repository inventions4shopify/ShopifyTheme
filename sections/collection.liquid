{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<style>
  {% if section.settings.show_bg_image %}
    .cms-main-collection-banner .main-page__section {
      background-image: url(
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 }}
        {% elsif collection.featured_image %}
          {{ collection.featured_image | image_url: width: 2000 }}
        {% endif %}
      );
    }
  {% endif %}

  .cms-main-collection-banner .main-page__overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
  }
</style>


{% if section.settings.collection_header %}
  {%- liquid
    assign s = section.settings
    assign container_class = 'page-width'

    if s.container_width == 'full-width'
      assign container_class = 'page-width--full'
    elsif s.container_width == 'narrow'
      assign container_class = 'page-width page-width--narrow'
    elsif s.container_width == 'small'
      assign container_class = 'page-width page-width--small'
    elsif s.container_width == 'custom'
      assign container_class = 'page-width main-page__container--custom'
    endif

    assign align_class = 'text-' | append: s.content_alignment
    assign tag = s.heading_tag | default: 'h2'

    assign banner_has_image = false
    if s.show_bg_image
      if s.image != blank or collection.featured_image != blank
        assign banner_has_image = true
      endif
    endif
  -%}

  <div class="cms-main-collection-banner{% if banner_has_image %} image_media--{{ s.media_height }}{% else %} cms-main-collection-banner--compact{% endif %}">
    <div
      {%- render 'section-variables',
        section: section,
        class: 'main-page__section',
        spacing: false
      -%}
    >
      {% if banner_has_image %}
        <div class="main-page__overlay"></div>
      {% endif %}

      <div class="main-page__inner">
        <div class="{{ container_class }}">
          <div class="main-page__content flex flex-col {{ align_class }}">
            {% if section.settings.subheading != blank %}
              <div class="page-subheading subheading">
                {{ section.settings.subheading }}
              </div>
            {% endif %}

            <{{ tag }} class="page-heading heading {{ tag }}">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                {{ collection.title }}
              {% endif %}
            </{{ tag }}>

            {% if collection.description != blank %}
              <div class="page-description text-sm" style="color: {{ section.settings.text_color }};">
                {{ collection.description }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<main-collection-section
  data-section-id="{{ section.id }}"
  {%- render 'section-variables', section: section, class: 'cms-main-collection' -%}
>  
  <div class="page-width">
    {% paginate collection.products by section.settings.card_per_page %}

      {% capture collection_filters %}
        <form method="get" action="{{ collection.url }}" data-collection-filter>

          {% for filter in collection.filters %}
            <div class="cms-filter-group">

              <!-- CLOSED BY DEFAULT -->
              <details class="cms-filter-accordion">

                <summary class="cms-filter-accordion-title">
                  <span class="cms-filter-label">{{ filter.label }}</span>
                  <span class="cms-filter-icon">
                    {% render 'icon', icon: 'chevron-bottom', width: 18, height: 18 %}
                  </span>
                </summary>

                <div class="cms-filter-accordion-content">

                  {% case filter.type %}

                    {% when 'list', 'boolean' %}
                      {% for value in filter.values %}
                        <label class="cms-filter-option">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                          >
                          <span>
                            {{ value.label }} <strong>({{ value.count }})</strong>
                          </span>
                        </label>
                      {% endfor %}

                    {% when 'price_range' %}
                      <div class="price-range">
                        <div class="field price-range__field">
                          <input
                            type="number"
                            class="field__input text-sm"
                            id="Filter-Price-{{ section.id }}-{{ forloop.index }}-min"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="Min"
                            value="{{ filter.min_value.value }}"
                            min="0"
                            inputmode="numeric"
                          >
                        </div>

                        <span class="price-range__separator" aria-hidden="true">–</span>

                        <div class="field price-range__field">
                          <input
                            type="number"
                            class="field__input text-sm"
                            id="Filter-Price-{{ section.id }}-{{ forloop.index }}-max"
                            name="{{ filter.max_value.param_name }}"
                            placeholder="Max"
                            value="{{ filter.max_value.value }}"
                            min="0"
                            inputmode="numeric"
                          >
                        </div>
                      </div>

                  {% endcase %}

                </div>

              </details>

            </div>
          {% endfor %}

        </form>
      {% endcapture %}


      {%- liquid
        if collection.sort_by != blank
          assign filter_clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
        else
          assign filter_clear_url = collection.url
        endif

        assign has_active_filters = false
        for filter in collection.filters
          if filter.active_values.size > 0
            assign has_active_filters = true
            break
          endif
        endfor

        assign show_filter_empty = false
        if collection.products_count == 0 and has_active_filters
          assign show_filter_empty = true
        endif
      -%}

      <div id="CollectionAjaxContainer" data-collection-ajax>
      {% render 'collection-filter-sort-row',
        show_filter: section.settings.show_filter,
        filter_position: section.settings.filter_position,
        filters: collection.filters,
        clear_url: filter_clear_url,
        filters_markup: collection_filters,
        products_count: collection.products_count,
        sort_options: collection.sort_options,
        sort_by: collection.sort_by,
        default_sort_by: collection.default_sort_by,
        show_total_product: section.settings.show_total_product,
        show_sort: section.settings.show_sort,
        show_layout: section.settings.show_layout
      %}

      <!-- SIDEBAR LAYOUT -->
      {% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %}

        <div class="cms-main-collection-grid cms-main-collection-grid--sidebar">

          <aside class="cms-collection-sidebar">
            {{ collection_filters }}
          </aside>

          <div class="collection-products">
            {% if show_filter_empty %}
              {% render 'collection-filter-empty' %}
            {% else %}
              <div class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col">
                {% for product in collection.products %}
                  {% render 'product-card',
                    product: product,
                    show_vendor: settings.show_vendor,
                    show_secondary_image: settings.show_secondary_image,
                    show_quick_buy: settings.show_quick_buy,
                    show_rating: settings.show_rating,
                    rating_display: settings.rating_display,
                    show_sold_out_badge: settings.show_sold_out_badge,
                    show_discount_badge: settings.show_discount_badge,
                    discount_type: settings.discount_type,
                    color_display_mode: settings.color_display_mode,
                    image_ratio: settings.image_ratio,
                    content_alignment: settings.content_alignment,
                    style: settings.style
                  %}
                {% endfor %}
              </div>
              {% render 'pagination', paginate: paginate %}
            {% endif %}
          </div>

        </div>

      {% else %}

        <!-- DEFAULT GRID -->
        <div class="collection-products">
          {% if show_filter_empty %}
            {% render 'collection-filter-empty' %}
          {% else %}
            <div class="grid grid--2-col sm:grid--3-col lg:grid--4-col">
              {% for product in collection.products %}
                {% render 'product-card',
                  product: product,
                  show_vendor: settings.show_vendor,
                  show_secondary_image: settings.show_secondary_image,
                  show_quick_buy: settings.show_quick_buy,
                  show_rating: settings.show_rating,
                  rating_display: settings.rating_display,
                  show_sold_out_badge: settings.show_sold_out_badge,
                  show_discount_badge: settings.show_discount_badge,
                  discount_type: settings.discount_type,
                  color_display_mode: settings.color_display_mode,
                  image_ratio: settings.image_ratio,
                  content_alignment: settings.content_alignment,
                  style: settings.style
                %}
              {% endfor %}
            </div>

            {% render 'pagination', paginate: paginate %}
          {% endif %}
        </div>

      {% endif %}

      </div>

    {% endpaginate %}

  </div>

</main-collection-section>

<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection header"
    },
    {
      "type": "checkbox",
      "id": "collection_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "range",
      "id": "card_per_page",
      "min": 8,
      "max": 40,
      "step": 1,
      "label": "Card Per Page",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Card Per Page",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Layout Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" }
      ],
      "default": "24",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Filter & sort"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.show_filter == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_total_product",
      "label": "Show Total Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout",
      "label": "Show Layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Background image",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_bg_image",
      "label": "Show background image",
      "default": true,
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Colors",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    }
  ]
}
{% endschema %}

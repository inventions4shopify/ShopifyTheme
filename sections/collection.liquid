{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{% if section.settings.collection_header == true %}
  {%- liquid
    assign s = section.settings
    assign bg_color = s.bg_color
    assign bg_gradient = s.bg_gradient
    assign container_class = 'page-width'
    if s.container_width == 'full-width'
      assign container_class = 'page-width--full'
    elsif s.container_width == 'narrow'
      assign container_class = 'page-width page-width--narrow'
    elsif s.container_width == 'small'
      assign container_class = 'page-width page-width--small'
    elsif s.container_width == 'custom'
      assign container_class = 'page-width main-page__container--custom'
    endif

    assign align_value = s.content_alignment | default: 'center'
    assign align_class = 'text-' | append: align_value

    assign tag = s.heading_tag | default: 'h2'
  -%}

  {%- if s.container_width == 'custom' and s.custom_container_width > 0 -%}
    <style>
      #shopify-section-{{ section.id }} .main-page__container--custom {
        max-width: {{ s.custom_container_width }}px;
      }
    </style>
  {%- endif -%}

  <div
    {%- render 'section-variables', section: section, class: 'main-page__section' -%}
  >
    {% if section.settings.show_bg_image and section.settings.image != blank %}
      <div class="main-page__overlay"></div>
    {% endif %}

    <div class="main-page__inner">
      <div class="{{ container_class }}">
        <div class="main-page__content flex ps-rte flex-col {{ align_class }}">
          {% if section.settings.subheading != blank %}
            <div
              class="page-subheading subheading"
              {% unless section.settings.subheading_color == blank
                or section.settings.subheading_color == 'rgba(0,0,0,0)'
              %}
                style="color: rgb({{ section.settings.subheading_color.rgb }});"
              {% endunless %}
            >
              {{ section.settings.subheading }}
            </div>
          {% endif %}

          <{{ tag }}
            class="page-heading {{ tag }}"
            {% unless section.settings.heading_color == blank or section.settings.heading_color == 'rgba(0,0,0,0)' %}
              style="color: rgb({{ section.settings.heading_color.rgb }});"
            {% endunless %}
          >
            {% if section.settings.heading != blank %}
              {{ section.settings.heading }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </{{ tag }}>
          {% if collection.description != blank %}
            <div
              class="page-description text-sm"
              {% unless section.settings.text_color == blank or section.settings.text_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ section.settings.text_color.rgb }});"
              {% endunless %}
            >
              {{ collection.description }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}
<div
  {%- render 'section-variables', section: section, class: '' -%}
>
  <div class="collection-products">
    {% paginate collection.products by 20 %}
      {% for product in collection.products %}
        <div class="collection-product">
          {% if product.featured_image %}
            {% render 'image',
              class: 'collection-product__image',
              image: product.featured_image,
              url: product.url,
              width: 400,
              height: 400,
              crop: 'center'
            %}
          {% endif %}
          <div class="collection-product__content">
            <p>{{ product.title | escape | link_to: product.url }}</p>
            <p>{{ product.price | money }}</p>
          </div>
        </div>
      {% endfor %}

      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>
</div>
<style>
  .main-page__section{
    {% if bg_gradient != blank %}
      background: {{ bg_gradient }};
    {% elsif bg_color != blank and bg_color != 'rgba(0,0,0,0)' %}
      background-color: rgb({{ bg_color.rgb }});
    {% endif %}

    {% if section.settings.show_bg_image == true %}
      {% if section.settings.image != blank %}
      background-image: url({{ section.settings.image | image_url: width: 2000 }});
      {% else %}
      background-image: url({{ collection.featured_image | image_url: width: 2000 }});
      {% endif %}
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      height: 40rem;
      min-height: var(--section-height-{{ section.settings.slide_height }});
      padding: 0;
    {% endif %}

    position: relative;
    overflow: hidden;
  }
  .main-page__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
    z-index: 1;
    pointer-events: none;
  }

  /* content above overlay */
  .main-page__inner {
    position: relative;
    z-index: 2;
    align-items: center;
    justify-content: center;
    display: flex;
    flex-flow: column;
    height: 100%;
  }
</style>
{% stylesheet %}
  .collection-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection header"
    },
    {
      "type": "checkbox",
      "id": "collection_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" }
      ],
      "default": "24",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Background image",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_bg_image",
      "label": "Show background image",
      "default": true,
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Media height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "fullscreen",
          "label": "Fullscreen"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Colors",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    }
  ]
}
{% endschema %}

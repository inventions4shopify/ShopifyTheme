{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<style>
  .main-page__overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
  }

  {% if section.settings.show_bg_image %}
    .main-page__section {
      background-image: url(
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 }}
        {% elsif collection.featured_image %}
          {{ collection.featured_image | image_url: width: 2000 }}
        {% endif %}
      );
    }
  {% endif %}
</style>


{% if section.settings.collection_header %}
  {%- liquid
    assign s = section.settings
    assign container_class = 'page-width'

    if s.container_width == 'full-width'
      assign container_class = 'page-width--full'
    elsif s.container_width == 'narrow'
      assign container_class = 'page-width page-width--narrow'
    elsif s.container_width == 'small'
      assign container_class = 'page-width page-width--small'
    elsif s.container_width == 'custom'
      assign container_class = 'page-width main-page__container--custom'
    endif

    assign align_class = 'text-' | append: s.content_alignment
    assign tag = s.heading_tag | default: 'h2'
  -%}

  <div class="image_media--{{ section.settings.media_height }} cms-main-collection-banner">
    <div
      {%- render 'section-variables',
        section: section,
        class: 'main-page__section'
      -%}
    >
      {% if section.settings.show_bg_image %}
        <div class="main-page__overlay"></div>
      {% endif %}

      <div class="main-page__inner">
        <div class="{{ container_class }}">
          <div class="main-page__content flex flex-col {{ align_class }}">
            {% if section.settings.subheading != blank %}
              <div class="page-subheading subheading">
                {{ section.settings.subheading }}
              </div>
            {% endif %}

            <{{ tag }} class="page-heading heading {{ tag }}">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                {{ collection.title }}
              {% endif %}
            </{{ tag }}>

            {% if collection.description != blank %}
              <div class="page-description text-sm">
                {{ collection.description }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div
   {%- render 'section-variables', section: section, class: 'cms-main-collection' -%}
>
  {% paginate collection.products by 20 %}

    <div class="collection-products grid grid--2-col sm:grid--3-col lg:grid--4-col">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>

    {% render 'pagination', paginate: paginate %}

  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection header"
    },
    {
      "type": "checkbox",
      "id": "collection_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" }
      ],
      "default": "24",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Background image",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_bg_image",
      "label": "Show background image",
      "default": true,
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Colors",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    }
  ]
}
{% endschema %}

{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

<style>
  .main-page__overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity }};
  }

  {% if section.settings.show_bg_image %}
    .main-page__section {
      background-image: url(
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 }}
        {% elsif collection.featured_image %}
          {{ collection.featured_image | image_url: width: 2000 }}
        {% endif %}
      );
    }
  {% endif %}
</style>


{% if section.settings.collection_header %}
  {%- liquid
    assign s = section.settings
    assign container_class = 'page-width'

    if s.container_width == 'full-width'
      assign container_class = 'page-width--full'
    elsif s.container_width == 'narrow'
      assign container_class = 'page-width page-width--narrow'
    elsif s.container_width == 'small'
      assign container_class = 'page-width page-width--small'
    elsif s.container_width == 'custom'
      assign container_class = 'page-width main-page__container--custom'
    endif

    assign align_class = 'text-' | append: s.content_alignment
    assign tag = s.heading_tag | default: 'h2'
  -%}

  <div class="image_media--{{ section.settings.media_height }} cms-main-collection-banner">
    <div
      {%- render 'section-variables',
        section: section,
        class: 'main-page__section'
      -%}
    >
      {% if section.settings.show_bg_image %}
        <div class="main-page__overlay"></div>
      {% endif %}

      <div class="main-page__inner">
        <div class="{{ container_class }}">
          <div class="main-page__content flex flex-col {{ align_class }}">
            {% if section.settings.subheading != blank %}
              <div class="page-subheading subheading">
                {{ section.settings.subheading }}
              </div>
            {% endif %}

            <{{ tag }} class="page-heading heading {{ tag }}">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                {{ collection.title }}
              {% endif %}
            </{{ tag }}>

            {% if collection.description != blank %}
              <div class="page-description text-sm" style="color: {{ section.settings.text_color }};">
                {{ collection.description }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<main-collection-section
   {%- render 'section-variables', section: section, class: 'cms-main-collection' -%}
>  
  <div class="page-width">
    {% paginate collection.products by section.settings.card_per_page %}

      {% capture collection_filters %}
        <form id="CollectionFiltersForm" {% if section.settings.filter_position == 'sidebar' %}data-auto-filter{% endif %}>

          {% for filter in collection.filters %}
            <div class="cms-filter-group">

              <!-- CLOSED BY DEFAULT -->
              <details class="cms-filter-accordion">

                <summary class="cms-filter-accordion-title">
                  <span class="cms-filter-label">{{ filter.label }}</span>
                  <span class="cms-filter-icon">
                    {% render 'icon', icon: 'chevron-bottom', width: 18, height: 18 %}
                  </span>
                </summary>

                <div class="cms-filter-accordion-content">

                  {% case filter.type %}

                    {% when 'list', 'boolean' %}
                      {% for value in filter.values %}
                        <label class="cms-filter-option">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                          >
                          <span>
                            {{ value.label }} <strong>({{ value.count }})</strong>
                          </span>
                        </label>
                      {% endfor %}

                    {% when 'price_range' %}
                      <div class="price-range">
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          placeholder="Min"
                          value="{{ filter.min_value.value }}"
                        >

                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          placeholder="Max"
                          value="{{ filter.max_value.value }}"
                        >
                      </div>

                  {% endcase %}

                </div>

              </details>

            </div>
          {% endfor %}

          <!-- APPLY BUTTON ONLY FOR DRAWER -->
          {% if section.settings.filter_position == 'drawer' %}
            <button type="submit" class="button">
              Apply Filters
            </button>
          {% endif %}

        </form>
      {% endcapture %}


      <!-- FILTER + SORT ROW -->
      <div class="cms-main-collection-filter-row">

        {% if section.settings.show_filter and section.settings.filter_position == 'drawer' %}
          <div class="cms-main-collection-filter-left">

            <details class="collection-filter-dropdown">

              <summary>
                {% render 'icon', icon: 'sort', width: 20, height: 20 %}
                <span>Filter & Sort</span>
              </summary>

              <div class="collection-filter-drawer">
                <div class="collection-filter-header">
                  <div class="collection-filter-header-left">
                    <h2 class="h5">
                      {% render 'icon', icon: 'sort', width: 20, height: 20 %}
                      <span>Filter & Sort</span>
                    </h2>
                    {{ collection.products_count }} Products
                  </div>
                  <button type="button" class="collection-filter-drawer-close" aria-label="Close menu">
                    {% render 'icon' , icon: 'close' , width: 20, height: 20 %}
                  </button>
                </div>

                {{ collection_filters }}
              </div>

            </details>

          </div>
        {% endif %}


        <div class="cms-main-collection-filter-right">

          {% if section.settings.show_total_product %}
            <span class="cms-main-collection-total-product">
              {{ collection.products_count }} Products
            </span>
          {% endif %}


          {% if section.settings.show_sort %}
            <div class="cms-main-collection-sort">

              <form id="SortByForm" method="get">

                <input
                  type="hidden"
                  name="sort_by"
                  id="SortByInput"
                  value="{{ collection.sort_by | default: collection.default_sort_by }}"
                >

                <div class="cms-sort-dropdown js-sort-dropdown">

                  <div class="cms-sort-selected js-sort-selected">
                    <span class="cms-sort-label js-sort-label">
                      Sort By
                    </span>

                    <span class="cms-sort-icon">
                      {% render 'icon', icon: 'chevron-bottom', width: 20, height: 20 %}
                    </span>
                  </div>

                  <ul class="cms-sort-options">
                    {% for option in collection.sort_options %}
                      <li
                        class="cms-sort-option js-sort-option {% if option.value == collection.sort_by %}active{% endif %}"
                        data-value="{{ option.value }}"
                      >
                        {{ option.name }}
                      </li>
                    {% endfor %}
                  </ul>

                </div>

              </form>

            </div>
          {% endif %}


          {% if section.settings.show_layout %}
            <div class="cms-main-collection-view">

              <button type="button" data-grid="3">
                {% render 'icon', icon: 'three-grid', width: 20, height: 20 %}
              </button>

              <button type="button" data-grid="4">
                {% render 'icon', icon: 'four-grid', width: 20, height: 20 %}
              </button>

            </div>
          {% endif %}

        </div>

      </div>


      <!-- SIDEBAR LAYOUT -->
      {% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %}

        <div class="cms-main-collection-grid">

          <aside class="cms-collection-sidebar">
            {{ collection_filters }}
          </aside>

          <div class="collection-products">
            <div class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col">
              {% for product in collection.products %}
                {% render 'product-card',
                  product: product,
                  show_vendor: settings.show_vendor,
                  show_secondary_image: settings.show_secondary_image,
                  show_quick_buy: settings.show_quick_buy,
                  show_rating: settings.show_rating,
                  rating_display: settings.rating_display,
                  show_sold_out_badge: settings.show_sold_out_badge,
                  show_discount_badge: settings.show_discount_badge,
                  discount_type: settings.discount_type,
                  color_display_mode: settings.color_display_mode,
                  image_ratio: settings.image_ratio,
                  content_alignment: settings.content_alignment,
                  style: settings.style
                %}
              {% endfor %}
            </div>
            {% render 'pagination', paginate: paginate %}
          </div>

        </div>

      {% else %}

        <!-- DEFAULT GRID -->
        <div class="collection-products grid grid--2-col sm:grid--3-col lg:grid--4-col">
          {% for product in collection.products %}
            {% render 'product-card',
              product: product,
              show_vendor: settings.show_vendor,
              show_secondary_image: settings.show_secondary_image,
              show_quick_buy: settings.show_quick_buy,
              show_rating: settings.show_rating,
              rating_display: settings.rating_display,
              show_sold_out_badge: settings.show_sold_out_badge,
              show_discount_badge: settings.show_discount_badge,
              discount_type: settings.discount_type,
              color_display_mode: settings.color_display_mode,
              image_ratio: settings.image_ratio,
              content_alignment: settings.content_alignment,
              style: settings.style
            %}
          {% endfor %}
        </div>

        {% render 'pagination', paginate: paginate %}

      {% endif %}

    {% endpaginate %}

  </div>

</main-collection-section>

<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection header"
    },
    {
      "type": "checkbox",
      "id": "collection_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "range",
      "id": "card_per_page",
      "min": 8,
      "max": 40,
      "step": 1,
      "label": "Card Per Page",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Card Per Page",
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" }
      ],
      "default": "24",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Content",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Filter & sort"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.show_filter == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_total_product",
      "label": "Show Total Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout",
      "label": "Show Layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Background image",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_bg_image",
      "label": "Show background image",
      "default": true,
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "visible_if": "{{ section.settings.show_bg_image == true and section.settings.collection_header == true }}"
    },
    {
      "type": "header",
      "content": "Colors",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.collection_header == true }}"
    }
  ]
}
{% endschema %}

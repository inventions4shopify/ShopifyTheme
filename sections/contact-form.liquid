{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings

  # ── Container width ──────────────────────────────────────────────────────
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  elsif s.container_width == 'narrow'
    assign container_class = 'page-width page-width--narrow'
  elsif s.container_width == 'small'
    assign container_class = 'page-width page-width--small'
  elsif s.container_width == 'custom'
    assign container_class = 'page-width rich-text__container--custom'
  endif

  # ── Alignment class ───────────────────────────────────────────────────────
  assign align_value = s.content_alignment | default: 'center'
  assign align_class = 'text-' | append: align_value
  assign justify_class = 'justify-' | append: align_value

  # ── Gap class ─────────────────────────────────────────────────────────────
  assign gap_value = s.gap | default: '24'
  assign gap_class = ''
  if gap_value != 'default'
    assign gap_class = 'gap-' | append: gap_value
  else
    assign gap_class = 'gap-24'
  endif
  assign tag = section.settings.heading_tag | default: 'h2'
  assign description = section.settings.text
  assign block_color = section.settings.text_color
  assign icon_text_color = section.settings.icon_text_color
  assign icon_background_color = section.settings.icon_background_color
-%}
<div {%- render 'section-variables', section: section, class: 'rich-text__section' -%}>
  <div class="{{ container_class }}">
    <div class="contact-form flex sm:gap-40 flex-{{ section.settings.form_position }}">
      {% if description != blank %}
        <div class="contact-form-content ps-rte {{ align_class }}">
          <h2 class="{{ tag }} title title-wrapper--no-top-margin inline-richtext {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {%- if section.settings.heading != blank -%}
              {{ section.settings.heading }}
            {%- else -%}
              {{ 'contact_form.title' | t }}
            {%- endif -%}
          </h2>
          <div
            class="contact-form-description text-lg"
            {%- if block_color != blank and block_color != 'rgba(0,0,0,0)' %}
              style="{%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' -%}color: rgb({{ block_color.rgb }});{%- endunless -%}"
            {%- endif %}
          >
            {{ description }}
          </div>
          <div class="contact-form-icon-text">
            {% if section.settings.phone_number != blank %}
              <div
                class="contact-form-icon-with-text flex gap-16 text-lg {{ justify_class }}"
                {%- if icon_text_color != blank and icon_text_color != 'rgba(0,0,0,0)' %}
                  style="{%- unless icon_text_color == blank or icon_text_color == 'rgba(0,0,0,0)' -%}color: rgb({{ icon_text_color.rgb }});{%- endunless -%}"
                {%- endif %}
              >
                <div
                  class="contact-form-icon-background flex items-center justify-center"
                  {%- if icon_background_color != blank and icon_background_color != 'rgba(0,0,0,0)' %}
                    style="{%- unless icon_background_color == blank or icon_background_color == 'rgba(0,0,0,0)' -%}background-color: rgb({{ icon_background_color.rgb }});{%- endunless -%}"
                  {%- endif %}
                >
                  {% render 'icon', icon: 'phone', width: 24, height: 24 %}
                </div>
                {{ section.settings.phone_number }}
              </div>
            {% endif %}
            {% if section.settings.email_address != blank %}
              <div
                class="contact-form-icon-with-text flex gap-16 text-lg {{ justify_class }}"
                {%- if icon_text_color != blank and icon_text_color != 'rgba(0,0,0,0)' %}
                  style="{%- unless icon_text_color == blank or icon_text_color == 'rgba(0,0,0,0)' -%}color: rgb({{ icon_text_color.rgb }});{%- endunless -%}"
                {%- endif %}
              >
                <div
                  class="contact-form-icon-background flex items-center justify-center"
                  {%- if icon_background_color != blank and icon_background_color != 'rgba(0,0,0,0)' %}
                    style="{%- unless icon_background_color == blank or icon_background_color == 'rgba(0,0,0,0)' -%}background-color: rgb({{ icon_background_color.rgb }});{%- endunless -%}"
                  {%- endif %}
                >
                  {% render 'icon', icon: 'email', width: 24, height: 24 %}
                </div>
                {{ section.settings.email_address }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
      <div class="contact">
        {% if description == blank %}
          <h2 class="{{ tag }} title title-wrapper--no-top-margin inline-richtext {{ align_class }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {%- if section.settings.heading != blank -%}
              {{ section.settings.heading }}
            {%- else -%}
              {{ 'contact_form.title' | t }}
            {%- endif -%}
          </h2>
        {% endif %}
        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h6 class="form-status form-status-list form__message success-msg" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'contact_form.post_success' | t }}
            </h6>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h6 class="form-status text-body error-msg" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'contact_form.error_heading' | t }}
              </h6>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ 'contact_form.email' | t }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="contact__fields {{ gap_class }}">
            <div class="field">
              <input
                class="field__input text-lg"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[Name]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'contact_form.first_name' | t }}"
              >
              <label class="field__label" for="ContactForm-name">{{ 'contact_form.first_name' | t }}</label>
            </div>

            <div class="field">
              <input
                class="field__input text-lg"
                autocomplete="family-name"
                type="text"
                id="ContactForm-last-name"
                name="contact[Last Name]"
                value=""
                placeholder="{{ 'contact_form.last_name' | t }}"
              >
              <label class="field__label" for="ContactForm-last-name">{{ 'contact_form.last_name' | t }}</label>
            </div>

            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="field__input text-lg"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="{{ 'contact_form.email' | t }}"
              >

              <label class="field__label" for="ContactForm-email">
                {{ 'contact_form.email' | t }}
                <span aria-hidden="true">*</span>
              </label>

              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'contact_form.Error' | t }}</span>
                </small>
              {%- endif -%}
            </div>
            <div class="field">
              <input
                type="tel"
                id="ContactForm-phone"
                class="field__input text-lg"
                autocomplete="tel"
                name="contact[Phone]"
                pattern="[0-9\-]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ 'contact_form.phone' | t }}"
              >
              <label class="field__label" for="ContactForm-phone">{{ 'contact_form.phone' | t }}</label>
            </div>
          </div>

          <div class="field">
            <textarea
              rows="10"
              id="ContactForm-body"
              class="text-area field__input text-lg"
              name="contact[Message]"
              placeholder="{{ 'contact_form.comment' | t }}"
            >{{- form.body -}}</textarea>

            <label class="form__label field__label" for="ContactForm-body"> {{ 'contact_form.comment' | t }} </label>
          </div>

          <div class="contact__button {{ align_class }}">
            <button type="submit" class="button">{{ 'contact_form.send' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Default" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Content Alignment"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "form_position",
      "options": [
        {
          "value": "row",
          "label": "Form First"
        },
        {
          "value": "row-reverse",
          "label": "Form Second"
        }
      ],
      "default": "row",
      "label": "Form Position"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk about your brand"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Contact information",
      "visible_if": "{{ section.settings.text != blank }}"
    },
    {
      "type": "richtext",
      "id": "phone_number",
      "label": "Phone number",
      "visible_if": "{{ section.settings.text != blank }}"
    },
    {
      "type": "richtext",
      "id": "email_address",
      "label": "Email address",
      "visible_if": "{{ section.settings.text != blank }}"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background color",
      "visible_if": "{{ section.settings.text != blank }}"
    },
    {
      "type": "color",
      "id": "icon_text_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.text != blank }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}

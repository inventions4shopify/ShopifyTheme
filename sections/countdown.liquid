{{ 'countdown.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_show == false %}
  <style>
    .cms-countdown-main .cms-cell--{{ section.settings.width }} >* {
      border-radius: var(--media-radius);
      position: relative;
      overflow: hidden;
    }
  </style>
{% endif %}
{% if section.settings.image_show %}
    <style>
        .cms-countdown-main {
            position: relative;
            background-image: url({% if section.settings.desktop_image != blank %}{{ section.settings.desktop_image | image_url }}{% else %}{{ 'thumbnail.svg' | asset_url }}{% endif %});
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }

        .cms-countdown-main::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.3);
            z-index: 1;
        }

        @media (max-width: 767px) {
            .cms-countdown-main {
                background-image: url({% if section.settings.mb_image != blank %}{{ section.settings.mb_image | image_url }}{% else %}{{ 'thumbnail.svg' | asset_url }}{% endif %});
            }
        }

        .cms-countdown-main .cms-row {
            position: relative;
            z-index: 2;
            justify-content: center;
        }

        .cms-countdown-wrapper {
          width: 100%;
          max-width: 65rem;
          margin: 0 auto;
        }
    </style>
{% endif %}

<div {%- render 'section-variables', section: section, class: 'cms-countdown-main' -%}>
  <div class="{{ section.settings.section_width }}">
    <div class="cms-row flex-{{ section.settings.image_position }}">
        {% if section.settings.image_show == false %}
          <div class="cms-cell--{{ section.settings.width }} aspect-square">
            <picture>
              {% if section.settings.mb_image != blank %}
                <source
                  media="(max-width: 767px)"
                  srcset="{{ section.settings.mb_image | image_url: width: 767 }}"
                >
              {% endif %}

              {% if section.settings.desktop_image != blank %}
                <img
                  src="{{ section.settings.desktop_image | image_url: width: 1440 }}"
                  srcset="
                    {{ section.settings.desktop_image | image_url: width: 550 }} 550w,
                    {{ section.settings.desktop_image | image_url: width: 750 }} 750w,
                    {{ section.settings.desktop_image | image_url: width: 1440 }} 1200w
                  "
                  sizes="100vw"
                  alt="{{ section.settings.desktop_image.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.desktop_image.width }}"
                  height="{{ section.settings.desktop_image.height }}"
                >
              {% else %}
                <img
                  src="{{ 'img-with-text.svg' | asset_url }}"
                  alt="Placeholder image"
                  loading="lazy"
                  width="719"
                  height="719"
                >
              {% endif %}
            </picture>
          </div>
        {% endif %}
        <div class="cms-cell justify-{{ section.settings.content_alignment }}">
            <div class="cms-countdown-wrapper text-{{ section.settings.text_alignment }}">
              {%- assign sub_color = section.settings.subheading_color -%}
            {% if section.settings.subheading != blank %}
                <span class="subheading"
                  {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                    style="color: rgb({{ sub_color.rgb }});"
                  {%- endunless %}
                >{{ section.settings.subheading }}</span>
            {% endif %}

            {% if section.settings.heading != blank %}
              {%- assign head_color = section.settings.heading_color -%}
              {%- assign head_grad = section.settings.heading_gradient -%}
              {%- capture heading_style -%}
                {%- if head_grad != blank -%}
                  background: {{ head_grad }};
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;
                {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                  --color-heading: {{ head_color.rgb }};
                {%- endif -%}
              {%- endcapture -%}
                <h2 class="h2"
                {%- unless heading_style == blank %}
                    style="{{ heading_style | strip }}"
                  {%- endunless %}
                >{{ section.settings.heading }}</h2>
            {% endif %}

            {%- assign date_color = section.settings.date_color -%}
            <countdown-timer class="h1 countdown-timer justify-{{ section.settings.text_alignment }}" data-countdown="{{ section.settings.countdown_date }}"
              {%- unless date_color == blank or date_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ date_color.rgb }});"
              {%- endunless %}
            >
                <div class="countdown-day">
                    <span class="countdown-number h1">00</span>
                    <span class="sub-heading" 
                    {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                      style="color: rgb({{ sub_color.rgb }});"
                    {%- endunless %}
                    >Days</span>
                </div>
                <span class="countdown-separator">:</span>
                <div class="countdown-hour">
                    <span class="countdown-number h1">00</span>
                    <span class="sub-heading" 
                    {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                      style="color: rgb({{ sub_color.rgb }});"
                    {%- endunless %}
                    >Hours</span>
                </div>
                <span class="countdown-separator">:</span>
                <div class="countdown-minute">
                    <span class="countdown-number h1">00</span>
                    <span class="sub-heading" 
                    {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                      style="color: rgb({{ sub_color.rgb }});"
                    {%- endunless %}
                    >Minutes</span>
                </div>
                <span class="countdown-separator">:</span>
                <div class="countdown-second">
                    <span class="countdown-number h1">00</span>
                    <span class="sub-heading" 
                    {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                      style="color: rgb({{ sub_color.rgb }});"
                    {%- endunless %}
                    >Seconds</span>
                </div>
            </countdown-timer>
            </div>
        </div>
    </div>
  </div>
</div>

<script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Countdown",
  "class": "cms-countdown",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "section_width",
      "label": "Layout Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Image Width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "row",
          "label": "Image First"
        },
        {
          "value": "row-reverse",
          "label": "Image Second"
        }
      ],
      "default": "row",
      "label": "Image Position"
    },
    {
        "type": "checkbox",
        "id": "image_show",
        "label": "Show Image In Background",
        "default": true
    },
    {
        "type": "image_picker",
        "id": "mb_image",
        "label": "Mobile Image"
    },
    {
        "type": "image_picker",
        "id": "desktop_image",
        "label": "Desktop Image"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown Date",
      "info": "Enter a date in the format MM-DD-YYYY HH:MM:SS",
        "default": "12-31-2028 23:59:59"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date color"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub heading",
      "default": "Limited Time Offer"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hurry Up! Don't Miss Out On This Exclusive Deal."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "Countdown"
    }
  ]
}
{% endschema %}
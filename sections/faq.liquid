{{ 'faq.css' | asset_url | stylesheet_tag }}

<style>

  .cms-faq-item {
    border: 0.1rem solid {%if section.settings.faq_button_border_color != blank %}{{ section.settings.faq_button_border_color }}{% else %}#ccc{% endif %};
    border-radius: {%if section.settings.faq_button_br != blank %}{{ section.settings.faq_button_br }}{% else %}0{% endif %}px;
    background-color: {%if section.settings.faq_button_color != blank %}{{ section.settings.faq_button_color }}{% else %}transparent{% endif %};
    color: {%if section.settings.faq_heading_color != blank %}{{ section.settings.faq_heading_color }}{% else %}#000{% endif %};
    position: relative;
    overflow: hidden;
  }

  .cms-faq-question {{ section.settings.faq_heading_size }} {
      color: {%if section.settings.faq_heading_color != blank %}{{ section.settings.faq_heading_color }}{% else %}#000{% endif %};
  }

  .cms-faq-content .cms-cell--{{ section.settings.width }} >* {
    postion: relative;
    overflow: hidden;
    border-radius: var(--media-radius);
  }
  
  {% if section.settings.image == blank %}
    .cms-faq-wrapper {
      width: 100%;
      max-width: 80rem;
      margin: 0 auto;
    }
  {% endif %}
</style>


<div {%- render 'section-variables', section: section, class: 'cms-faq-main' -%}>
  <div class="{{ section.settings.section_width }}">
    <div class="cms-faq-content">
        <div class="faq-content-head ps-rte text-{{ section.settings.text_alignment }}">
        
          {% if section.settings.subheading != blank %}
              {%- assign sub_color = section.settings.subheading_color -%}
              <span class="subheading"
                {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                  style="color: rgb({{ sub_color.rgb }});"
                {%- endunless %}
              >
              {{ section.settings.subheading }}
              </span>
          {% endif %}

          {% if section.settings.heading != blank %}
            {%- assign head_color = section.settings.heading_color -%}
            {%- assign head_grad = section.settings.heading_gradient -%}

            {%- capture heading_style -%}
              {%- if head_grad != blank -%}
                background: {{ head_grad }};
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
              {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                --color-heading: {{ head_color.rgb }};
              {%- endif -%}
            {%- endcapture -%}

              <h2 class="faq-content-heading"
                {%- unless heading_style == blank %}
                  style="{{ heading_style | strip }}"
                {%- endunless %}
              >
              {{ section.settings.heading }}
              </h2>
          {% endif %}

          {% if section.settings.description != blank %}
            {%- assign block_color = section.settings.text_color -%}
            <div
                class="rich-text__text ps-rte"
                {%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
                  style="color: rgb({{ block_color.rgb }});"
                {%- endunless %}
              >
                {{ section.settings.description }}
              </div>
          {% endif %}

          {% if section.settings.link_label != blank %}
            {%- render 'button',
              text: section.settings.link_label,
              href: section.settings.link,
              style: section.settings.button_style,
              background_color: section.settings.button_background_color,
              text_color: section.settings.button_text_color,
              outline_color: section.settings.button_outline_color
            -%}
          {% endif %}

        </div>

        <div class="cms-row flex-{{ section.settings.image-position }}">
            {% if section.settings.image != blank %}
                <div class="cms-cell--{{ section.settings.width }} image_media--{{ section.settings.media_height }}">
                    <picture>
                        {% if section.settings.mb-image != blank %}
                            <source
                            media="(max-width: 767px)"
                            srcset="{{ section.settings.mb-image | image_url }}"
                            >
                        {% endif %}
                        {% if section.settings.image != blank %}
                            <img
                            src="{{ section.settings.image | image_url }}"
                            alt="{{ section.settings.image.alt | escape }}"
                            loading="lazy"
                            width="auto"
                            height="auto"
                            >
                        {% endif %}
                    </picture>
                </div>
            {% endif %}
            <div class="cms-cell justify-{{ section.settings.faq_alignment }}">
                <div class="cms-faq-wrapper">
                    {% for block in section.blocks %}
                      {% if block.settings.heading != blank %}
                        <div class="cms-faq-item" {{ block.shopify_attributes }}>
                              <button class="cms-faq-question button" type="button">
                                  <{{ section.settings.faq_heading_size }} class="faq-title {{ section.settings.faq_heading_size }}">{{ block.settings.heading }}</{{ section.settings.faq_heading_size }}>
                                  <span class="cms-faq-icon">
                                    {% render 'icon', icon: 'chevron-bottom', width: '2rem', height: '2rem' %}
                                  </span>
                              </button>
                            <div class="cms-faq-answer">
                                <div class="cms-faq-answer-inner">
                                {{ block.settings.description }}
                                </div>
                            </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
  </div>
</div>

<script>
  function initFaq(container = document) {

    const faqItems = container.querySelectorAll('.cms-faq-item');

    faqItems.forEach((item) => {

      // Duplicate event binding અટકાવવા
      if (item.dataset.faqInitialized) return;

      item.dataset.faqInitialized = "true";

      const question = item.querySelector('.cms-faq-question');

      if (!question) return;

      question.addEventListener('click', () => {

        const wrapper = item.closest('.cms-faq-wrapper');
        const wrapperFaqs = wrapper.querySelectorAll('.cms-faq-item');

        const isActive = item.classList.contains('active');

        wrapperFaqs.forEach((faq) => {
          faq.classList.remove('active');
        });

        if (!isActive) {
          item.classList.add('active');
        }

      });

    });

  }

  document.addEventListener('DOMContentLoaded', () => {
    initFaq();
  });

  document.addEventListener('shopify:section:load', (event) => {
    initFaq(event.target);
  });
</script>


{{ 'faq.css' | asset_url | stylesheet_tag }}


<style>
    .cms-faq .cms-faq-question {
        background-color: {%if section.settings.faq_button_color != blank %}{{ section.settings.faq_button_color }}{% else %}transparent{% endif %};
        color: {%if section.settings.faq_heading_color != blank %}{{ section.settings.faq_heading_color }}{% else %}#000{% endif %};
        border-color: {%if section.settings.faq_button_border_color != blank %}{{ section.settings.faq_button_border_color }}{% else %}#ccc{% endif %};
        border-radius: {%if section.settings.faq_button_br != blank %}{{ section.settings.faq_button_br }}{% else %}0{% endif %}px;
    }

    .cms-faq .cms-faq-question {{ section.settings.faq_heading_size }} {
        color: {%if section.settings.faq_heading_color != blank %}{{ section.settings.faq_heading_color }}{% else %}#000{% endif %};
    }
</style>

<div class="cms-faq-main">
  <div class="{{ section.settings.section_width }}">
    <div class="cms-faq-content">
        <div class="faq-content-head text-{{ section.settings.text_alignment }}">
        
        {% if section.settings.subheading != blank %}
            <span class="faq-content-subheading">
            {{ section.settings.subheading }}
            </span>
        {% endif %}

        {% if section.settings.heading != blank %}
            <h2 class="faq-content-heading">
            {{ section.settings.heading }}
            </h2>
        {% endif %}

        {% if section.settings.description != blank %}
            {{ section.settings.description }}
        {% endif %}

        {% if section.settings.link_label != blank %}
            {% render 'button',
            text: section.settings.link_label,
            href: section.settings.link,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            outline_color: section.settings.button_outline_color
            %}
        {% endif %}

        </div>

        <div class="cms-row">
            {% if section.settings.image != blank %}
                <div class="cms-cell--{{ section.settings.width }} image_media--{{ section.settings.media_height }}">
                    <picture>
                        {% if section.settings.mb-image != blank %}
                            <source
                            media="(max-width: 767px)"
                            srcset="{{ section.settings.mb-image | image_url }}"
                            >
                        {% endif %}
                        {% if section.settings.image != blank %}
                            <img
                            src="{{ section.settings.image | image_url }}"
                            alt="{{ section.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ section.settings.image.width }}"
                            height="{{ section.settings.image.height }}"
                            >
                        {% endif %}
                    </picture>
                </div>
            {% endif %}
            <div class="cms-cell">
                <div class="cms-faq-wrapper">
                    {% for block in section.blocks %}
                        <div class="cms-faq-item" {{ block.shopify_attributes }}>
                            <button class="cms-faq-question" type="button">
                                <{{ section.settings.faq_heading_size }} class="faq-title {{ section.settings.faq_heading_size }}">{{ block.settings.heading }}</{{ section.settings.faq_heading_size }}>
                                <span class="cms-faq-icon">+</span>
                            </button>
                            <div class="cms-faq-answer">
                                <div class="cms-faq-answer-inner">
                                {{ block.settings.description }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
  </div>
</div>

<script>
  function initFaq() {

    const faqItems = document.querySelectorAll('.cms-faq-item');

    faqItems.forEach((item) => {

      const question = item.querySelector('.cms-faq-question');

      question.addEventListener('click', () => {

        const isActive = item.classList.contains('active');

        faqItems.forEach((faq) => {
          faq.classList.remove('active');
        });

        if (!isActive) {
          item.classList.add('active');
        }

      });

    });

  }

  document.addEventListener('DOMContentLoaded', initFaq);

  document.addEventListener('shopify:section:load', initFaq);
</script>

{% schema %}
{
  "name": "Faq",
  "class": "section cms-faq",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",

      "label": "Link Label"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button Outline Color"
    },
    {
        "type": "header",
        "content": "Faq Heading style"
    },
    {
      "type": "select",
      "id": "faq_heading_size",
      "label": "Faq Heading Size",
      "options": [
        {
          "value": "h4",
          "label": "Large"
        },
        {
          "value": "h5",
          "label": "Medium"
        },
        {
          "value": "h6",
          "label": "Small"
        }
      ],
      "default": "h6"
    },
    {
        "type": "color",
        "id": "faq_button_color",
        "label": "Faq Button Background Color"
    },
    {
        "type": "color",
        "id": "faq_heading_color",
        "label": "Faq Heading Color"
    },
    {
        "type": "color",
        "id": "faq_button_border_color",
        "label": "Faq Button Border Color"
    },
    {
        "type": "range",
        "id": "faq_button_br",
        "label": "Faq Button Border Radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "default": 0
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Faq",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Faq",
      "blocks": [
        {
          "type": "faq"
        },
      ]
    }
  ]

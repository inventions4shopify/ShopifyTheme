{{ 'blog-template.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign selected_blog = s.blog
  assign posts_count = s.posts_count | default: 3

  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  endif

  assign align_value = s.content_alignment | default: 'center'
  assign align_class = 'text-' | append: align_value

  assign link_url = s.link_url
  if link_url == blank and selected_blog != blank
    assign link_url = selected_blog.url
  endif

  if s.bg_color != 'rgba(0,0,0,0)' and s.bg_color != blank
    assign background_color = s.bg_color
  else
    assign background_color = settings.background_color
  endif
-%}

<div {%- render 'section-variables', section: section, class: 'featured-blog custom-articles-section' -%}>
  <div class="{{ container_class }}">
    {%- if s.subheading != blank or s.heading != blank or s.description != blank -%}
      <div class="featured-blog__header {{ align_class }}">
        {%- render 'section-header',
          subheading: s.subheading,
          heading: s.heading,
          content: s.description,
          text_alignment: align_value
        -%}
      </div>
    {%- endif -%}

    {%- if selected_blog != blank and selected_blog.articles_count > 0 -%}
      <div class="blog-grid grid md:grid--{{ s.blogs_per_row }}-col xs:grid--2-col">
        {%- for article in selected_blog.articles limit: posts_count -%}
          <article class="blog-card{% if s.first_article_full_width and forloop.first %} blog-card--featured{% endif %}">
            {%- render 'article-card',
              article: article,
              media_height: s.image_ratio,
              show_image: s.show_image,
              show_date: s.show_date,
              show_author: s.show_author,
              show_excerpt: s.show_excerpt,
              read_more_label: s.read_more_label,
              settings: settings
            -%}
          </article>
        {%- endfor -%}
      </div>

      {%- if s.link_text != blank and link_url != blank -%}
        <div class="featured-blog__footer {{ align_class }}">
          {%- render 'button',
            text: s.link_text,
            href: link_url,
            background_color: s.button_background_color,
            text_color: s.button_text_color,
            outline_color: s.button_outline_color
          -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="blog-grid grid md:grid--{{ s.blogs_per_row }}-col xs:grid--2-col">
        {%- for i in (1..posts_count) -%}
          <article class="blog-card">
            {%- render 'article-card-placeholder',
              media_height: s.image_ratio,
              show_image: s.show_image,
              show_excerpt: s.show_excerpt,
              placeholder_index: i
            -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .featured-blog.custom-articles-section {
    background: {{ background_color }};
  }

  .featured-blog__header {
    margin-bottom: var(--spacing-32);
  }

  .featured-blog__footer {
    margin-top: var(--spacing-32);
  }

  .featured-blog .article-card__placeholder {
    background: rgb(var(--img-placeholder, 243 243 243));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--media-radius);
  }

  .featured-blog .article-card__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .featured-blog .ratio-square.article-card__placeholder,
  .featured-blog .ratio-portrait.article-card__placeholder {
    aspect-ratio: inherit;
  }

  .featured-blog .ratio-square {
    aspect-ratio: 1 / 1;
  }

  .featured-blog .ratio-portrait {
    aspect-ratio: 4 / 5;
  }

  {% if s.zoom_effect %}
    .featured-blog .blog-card:hover .article-card__image img,
    .featured-blog .article-card:hover .article-card__image img {
      transform: scale(1.05);
    }
  {% endif %}

  {% if s.card_style == true %}
    .featured-blog .card__content {
      padding: var(--spacing-16);
    }

    .featured-blog .article-card__image-wrapper,
    .featured-blog .article-card__image img {
      border-radius: var(--media-radius) var(--media-radius) 0 0;
    }

    @media screen and (max-width: 768px) {
      .featured-blog .blog-card--featured .article-card__image-wrapper,
      .featured-blog .blog-card--featured .article-card__image img {
        border-radius: var(--media-radius) var(--media-radius) 0 0;
      }
    }
  {% else %}
    .featured-blog .card__content {
      padding: var(--spacing-16);
    }

    .featured-blog .blog-card--featured .card__content {
      padding: var(--spacing-16);
    }

    .featured-blog .blog-card--featured .article-card__image-wrapper,
    .featured-blog .blog-card--featured .article-card__image img {
      border-radius: var(--media-radius);
    }

    @media screen and (max-width: 768px) {
      .featured-blog .blog-card--featured .card__content {
        padding: var(--spacing-16) 0 0 0;
      }
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "featured-blog-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "label": "Posts to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blog posts"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "info": "Defaults to the selected blog URL."
    },
    {
      "type": "header",
      "content": "Layout & Grid Settings"
    },
    {
      "type": "checkbox",
      "id": "first_article_full_width",
      "label": "First article full width",
      "default": false
    },
    {
      "type": "range",
      "id": "blogs_per_row",
      "label": "Blogs per row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "start",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Article image settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "adapt",
      "visible_if": "{{ section.settings.show_image == true }}",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "checkbox",
      "id": "zoom_effect",
      "label": "Enable image zoom",
      "default": true,
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "header",
      "content": "Article content settings"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "header",
      "content": "Section color settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "checkbox",
      "id": "card_style",
      "label": "Enable card style",
      "default": false
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Heading color",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "author_date",
      "label": "Author and date",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text",
      "visible_if": "{{ section.settings.card_style == true }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}

{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
{{ 'card-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_count
  assign layout = section.settings.layout
  assign s = section.settings

  # ── Container width ──
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  endif

  if collection != blank
    assign collection_products = collection.products
  endif

  assign link_url = section.settings.link_url
  if link_url == blank and collection != blank
    assign link_url = collection.url
  endif
-%}

{%- style -%}
  .featured-collection {
    --fc-columns: {{ section.settings.columns }};
    --fc-mobile-columns: {{ section.settings.mobile_columns }};
    --fc-gap: {{ section.settings.horizontal_gap }}px;
    --fc-info-align: {{ section.settings.product_info_alignment }};
  }
{%- endstyle -%}

<div {%- render 'section-variables', section: section, class: 'featured-collection' -%}>
  <div class="{{ container_class }}">
    {%- if section.settings.heading != blank
      or section.settings.content != blank
      or section.settings.link_url != blank
    -%}
      <div class="fc__header">
        <div class="fc__header-text">
          {%- render 'section-header',
            subheading: section.settings.subheading,
            heading: section.settings.heading,
            content: section.settings.description,
            text_alignment: 'start'
          -%}
        </div>
        <div class="fc__view-all">
          {% if section.settings.link_text != blank %}
            {%- render 'button',
              text: section.settings.link_text,
              href: link_url,
              background_color: section.settings.button_background_color,
              text_color: section.settings.button_text_color,
              outline_color: section.settings.button_outline_color
            -%}
          {% endif %}
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      case layout
        when 'carousel'
          assign wrapper_class = 'fc__carousel'
        when 'editorial'
          assign wrapper_class = 'fc__editorial'
        else
          assign wrapper_class = 'fc__grid'
      endcase
    -%}

    {%- comment -%} Render one product card with all card variables passed through {%- endcomment -%}
    {%- capture render_card -%}{%- endcapture -%}

    {%- if layout == 'carousel' -%}
      <div class="fc__slider" data-fc-slider>
        <button type="button" class="fc__arrow fc__arrow--prev" data-fc-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="fc__track" data-fc-track>
          {%- if collection != blank and collection_products.size > 0 -%}
            {%- for product in collection_products limit: products_to_show -%}
              {% render 'product-card',
                product: product,
                enable_image_zoom: section.settings.enable_image_zoom,
                image_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                show_sale_badge: section.settings.show_discount_badge,
                show_secondary_image: section.settings.show_secondary_image,
                show_color_swatches: section.settings.show_color_swatches,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                enable_quick_add: section.settings.show_quick_buy
              %}
            {%- endfor -%}
            {% comment %}
              {%- else -%}
              {%- for i in (1..products_to_show) -%}
                {% render 'product-card-placeholder', index: i, image_ratio: section.settings.image_ratio %}
              {%- endfor -%}
            {% endcomment %}
          {%- endif -%}
        </div>

        <button type="button" class="fc__arrow fc__arrow--next" data-fc-next aria-label="Next">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>

        <div class="fc__dots" data-fc-dots></div>
      </div>
    {%- else -%}
      <div class="{{ wrapper_class }}">
        {%- if collection != blank and collection_products.size > 0 -%}
          {%- for product in collection_products limit: products_to_show -%}
            {% render 'product-card',
              product: product,
              enable_image_zoom: section.settings.enable_image_zoom,
              image_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              show_sale_badge: section.settings.show_discount_badge,
              show_secondary_image: section.settings.show_secondary_image,
              show_color_swatches: section.settings.show_color_swatches,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              enable_quick_add: section.settings.show_quick_buy
            %}
          {%- endfor -%}
          {% comment %}
            {%- else -%}
            {%- for i in (1..products_to_show) -%}
              {% render 'product-card-placeholder', index: i, image_ratio: section.settings.image_ratio %}
            {%- endfor -%}
          {% endcomment %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initSlider(slider) {
      if (slider.dataset.fcInit) return;
      slider.dataset.fcInit = 'true';

      var track = slider.querySelector('[data-fc-track]');
      var prev = slider.querySelector('[data-fc-prev]');
      var next = slider.querySelector('[data-fc-next]');
      var dotsWrap = slider.querySelector('[data-fc-dots]');
      if (!track) return;

      function page() {
        return track.clientWidth;
      }

      function pageCount() {
        return Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth));
      }

      function buildDots() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        var count = pageCount();
        if (count <= 1) return;
        for (var i = 0; i < count; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'fc__dot';
          b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          (function (idx) {
            b.addEventListener('click', function () {
              track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
            });
          })(i);
          dotsWrap.appendChild(b);
        }
        dotsState();
      }

      function dotsState() {
        if (!dotsWrap) return;
        var dots = dotsWrap.querySelectorAll('.fc__dot');
        if (!dots.length) return;
        var active = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach(function (d, i) {
          d.classList.toggle('is-active', i === active);
        });
      }

      function updateArrows() {
        var max = track.scrollWidth - track.clientWidth - 1;
        if (prev) prev.disabled = track.scrollLeft <= 1;
        if (next) next.disabled = track.scrollLeft >= max;
        dotsState();
      }

      if (prev)
        prev.addEventListener('click', function () {
          track.scrollBy({ left: -page(), behavior: 'smooth' });
        });
      if (next)
        next.addEventListener('click', function () {
          track.scrollBy({ left: page(), behavior: 'smooth' });
        });

      var ticking = false;
      track.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          updateArrows();
          ticking = false;
        });
      });

      // drag to scroll
      var isDown = false,
        startX = 0,
        startScroll = 0;
      track.addEventListener('mousedown', function (e) {
        isDown = true;
        startX = e.pageX;
        startScroll = track.scrollLeft;
        track.style.cursor = 'grabbing';
      });
      window.addEventListener('mouseup', function () {
        isDown = false;
        track.style.cursor = '';
      });
      track.addEventListener('mousemove', function (e) {
        if (!isDown) return;
        e.preventDefault();
        track.scrollLeft = startScroll - (e.pageX - startX);
      });

      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(function () {
          buildDots();
          updateArrows();
        }, 150);
      });

      buildDots();
      updateArrows();
    }

    function initAll() {
      document.querySelectorAll('[data-fc-slider]').forEach(initSlider);
    }

    if (document.readyState !== 'loading') initAll();
    else document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "select",
      "id": "layout",
      "label": "Type",
      "default": "carousel",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "editorial", "label": "Editorial" }
      ]
    },
    { "type": "range", "id": "products_count", "label": "Product count", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Collection"
    },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL", "info": "Default to collection URL." },
    { "type": "header", "content": "Product card" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image size",
      "default": "natural",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "round", "label": "Round" }
      ]
    },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "Zoom image on hover", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show secondary image on hover", "default": true },
    { "type": "checkbox", "id": "show_quick_buy", "label": "Show quick buy", "default": false },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false,
      "info": "To display a rating, add a product rating app."
    },
    { "type": "checkbox", "id": "show_color_swatches", "label": "Show color swatches", "default": true },
    { "type": "checkbox", "id": "show_sold_out_badge", "label": "Show sold out badge", "default": true },
    { "type": "checkbox", "id": "show_discount_badge", "label": "Show discount badge", "default": true },
    {
      "type": "select",
      "id": "product_info_alignment",
      "label": "Product info alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_count
  assign layout = section.settings.layout
  assign s = section.settings

  # ── Layout Width ──
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  endif

  if collection != blank
    assign collection_products = collection.products
  endif

  assign link_url = section.settings.link_url
  if link_url == blank and collection != blank
    assign link_url = collection.url
  endif

  # ── Decide which markup to render ──
  # Carousel markup is used when:
  #   - the desktop Type is "carousel", OR
  #   - mobile_carousel is enabled (desktop stays grid/editorial, mobile becomes slider)
  assign use_slider_markup = false
  if layout == 'carousel'
    assign use_slider_markup = true
  elsif s.mobile_carousel
    assign use_slider_markup = true
  endif

  # data attribute tells the JS whether the slider is active at the current breakpoint
  if layout == 'carousel'
    assign slider_mode = 'always'
  else
    assign slider_mode = 'mobile'
  endif
-%}

{%- style -%}
  .featured-collection {
    --fc-columns: {{ section.settings.columns }};
    --fc-mobile-columns: {{ section.settings.mobile_columns }};
    --fc-gap: {{ section.settings.horizontal_gap }}px;
  }
  .section-{{ section.id }} .card_style-card {
    background-color:
      {% if section.settings.card_bg_color != blank and section.settings.card_bg_color != 'rgba(0,0,0,0)' %}
        {{ section.settings.card_bg_color }}
      {% else %}
        rgb(var(--color-product-card-background))
      {% endif %};
    border-radius: var(--media-radius);
  }
  .section-{{ section.id }} .card_style-card .product-card__content {
    padding: var(--spacing-6) var(--spacing-10);
  }
  {% if section.settings.card_heading_color != blank and section.settings.card_heading_color != 'rgba(0,0,0,0)' %}
    .section-{{ section.id }} .product-card__content > * {
      color: {{ section.settings.card_heading_color }};
    }
  {% endif %}
  {% if section.settings.image_shape == 'rounded' %}
    .section-{{ section.id }} .product-card__image-link {
      border-radius: var(--media-radius);
      overflow: hidden;
    }
    .section-{{ section.id }} .product-card__image {
      border-radius: var(--media-radius);
    }
  {% elsif section.settings.image_shape == 'circle' %}
    .section-{{ section.id }} .product-card__media {
      aspect-ratio: 1 / 1;
    }
    .section-{{ section.id }} .product-card__image-link {
      border-radius: 50%;
      overflow: hidden;
      width: 100%;
      height: 100%;
    }
    .section-{{ section.id }} .product-card__image {
      border-radius: 50%;
    }
  {% endif %}
{%- endstyle -%}

<div {%- render 'section-variables', section: section, class: 'featured-collection' -%}>
  <div class="{{ container_class }}">
      <div class="fc__wrapper-main section-{{ section.id }}">
        {%- if section.settings.heading != blank
          or section.settings.description != blank
          or section.settings.link_text != blank
        -%}
          <div class="fc__header">
            <div class="fc__header-text">
              {%- render 'section-header',
                subheading: section.settings.subheading,
                heading: section.settings.heading,
                content: section.settings.description,
                text_alignment: 'start'
              -%}
            </div>
            {%- if collection_products.size > 4 -%}
              <div class="fc__view-all">
                {% if section.settings.link_text != blank %}
                  {%- render 'button',
                    text: section.settings.link_text,
                    href: link_url,
                    background_color: section.settings.button_background_color,
                    text_color: section.settings.button_text_color,
                    outline_color: section.settings.button_outline_color
                  -%}
                {% endif %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          case layout
            when 'carousel'
              assign wrapper_class = 'fc__carousel'
            when 'editorial'
              assign wrapper_class = 'fc__editorial'
            else
              assign wrapper_class = 'fc__grid'
          endcase
        -%}

        {%- comment -%} Render one product card with all card variables passed through {%- endcomment -%}

        {%- if use_slider_markup -%}
          {%- comment -%}
            slider_mode="always"  → slider on all breakpoints (Type = Carousel)
            slider_mode="mobile"  → desktop keeps grid/editorial, mobile becomes slider
            The desktop layout class (fc__grid / fc__editorial) is added so that at
            >=750px the track reverts to that layout. CSS handles the switch.
          {%- endcomment -%}
          <featured-collection-slider
            class="fc__slider fc__slider--{{ slider_mode }} {% if slider_mode == 'mobile' %}fc__slider--desktop-{{ layout }}{% endif %}"
            data-fc-mode="{{ slider_mode }}"
          >
            <div class="fc__track {% if slider_mode == 'mobile' %}{{ wrapper_class }}{% endif %}" data-fc-track>
              {%- if collection != blank and collection_products.size > 0 -%}
                {%- for product in collection_products limit: products_to_show -%}
                  {% render 'product-card',
                    product: product,
                    style: section.settings.card_style,
                    enable_image_zoom: section.settings.enable_image_zoom,
                    image_ratio: settings.image_ratio,
                    show_vendor: settings.show_vendor,
                    show_secondary_image: settings.show_secondary_image,
                    show_quick_buy: settings.show_quick_buy,
                    show_rating: settings.show_rating,
                    rating_display: settings.rating_display,
                    show_sold_out_badge: settings.show_sold_out_badge,
                    show_discount_badge: settings.show_discount_badge,
                    discount_type: settings.discount_type,
                    color_display_mode: settings.color_display_mode,
                    content_alignment: settings.content_alignment
                  %}
                {%- endfor -%}
              {%- else -%}
                {% for i in (1..section.settings.columns) %}
                  <div class="collection-placeholder">
                    <img
                      src="{{ 'img-with-text.svg' | asset_url }}"
                      alt="Placeholder image"
                      loading="lazy"
                      width="100"
                      height="100"
                    />
                  </div>
                {% endfor %}
              {%- endif -%}
            </div>

            {%- if collection != blank and collection_products.size > 0 -%}
              <div class="fc__arrows_btn flex" data-fc-arrows>
                <button class="collection-grid-prev button" data-fc-prev aria-label="Previous">{% render 'icon', icon: 'chevron-left', width: '2.4rem', height: '2.4rem' %}</button>
                <button class="collection-grid-next button" data-fc-next aria-label="Next">{% render 'icon', icon: 'chevron-right', width: '2.4rem', height: '2.4rem' %}</button>
              </div>
            {%- endif -%}
          </featured-collection-slider>
        {%- else -%}
          <div class="{{ wrapper_class }}">
            {%- if collection != blank and collection_products.size > 0 -%}
              {%- for product in collection_products limit: products_to_show -%}
                {% render 'product-card',
                  product: product,
                  style: section.settings.card_style,
                  enable_image_zoom: section.settings.enable_image_zoom,
                  image_ratio: settings.image_ratio,
                  show_vendor: settings.show_vendor,
                  show_secondary_image: settings.show_secondary_image,
                  show_quick_buy: settings.show_quick_buy,
                  show_rating: settings.show_rating,
                  rating_display: settings.rating_display,
                  show_sold_out_badge: settings.show_sold_out_badge,
                  show_discount_badge: settings.show_discount_badge,
                  discount_type: settings.discount_type,
                  color_display_mode: settings.color_display_mode,
                  content_alignment: settings.content_alignment
                %}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
  </div>
</div>

{%- if use_slider_markup -%}
  <script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "select",
      "id": "layout",
      "label": "Type",
      "default": "carousel",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "editorial", "label": "Editorial" }
      ]
    },
    { "type": "range", "id": "products_count", "label": "Product count", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 6, "step": 1, "default": 4 },
    {
      "type": "range",
      "id": "horizontal_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    { "type": "header", "content": "Mobile layout" },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Carousel",
      "default": false,
      "info": "When on, the section scrolls horizontally as a slider on mobile (desktop keeps the Type layout above). Has no effect when Type is already Carousel."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Collection"
    },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link URL", "info": "Default to collection URL." },
    { "type": "header", "content": "Product card" },
    {
      "type": "select",
      "id": "card_style",
      "options": [
        {
          "value": "standard",
          "label": "standard"
        },
        {
          "value": "card",
          "label": "card"
        }
      ],
      "default": "standard",
      "label": "Card style"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "rounded", "label": "Rounded" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "default"
    },
    { "type": "checkbox", "id": "enable_image_zoom", "label": "Zoom image on hover", "default": true },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "visible_if": "{{ section.settings.card_style == 'card' }}"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Layout Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },

    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

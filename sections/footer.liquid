{{ 'footer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign has_social = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_pinterest_link != blank or settings.social_linkedin_link != blank
    assign has_social = true
  endif
-%}

{%- style -%}
  .footer_section {
    background-color: {{ settings.footer_background_color }};
    color: {{ settings.footer_text_color }};
  }
  .footer__mobile-toggle{
    color: {{ settings.footer_text_color }};
  }
  .footer__bottom-link {  color: {{ settings.footer_text_color }}; }
  .footer__bottom-link:hover { color: {{ settings.footer_text_color }}}
  .footer__block-title {
    color:{{ settings.footer_text_color }};
  }
  .footer_section .social_link {
    color: {{ settings.footer_text_color }};
  }
  .footer__menu-link:hover { color: {{ settings.footer_text_color }}; }
  .footer_section .footer__divider { background-color: {{ settings.footer_text_color }}; }
  .footer__copyright a{ color: {{ settings.footer_text_color }}; }
{%- endstyle -%}


<footer {%- render 'section-variables', section: section, class: 'footer footer_section' -%}>
  <div class="footer__inner page-width">
    {%- comment -%} ── BLOCKS ROW ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks-row">
        {%- for block in section.blocks -%}
          {%- style -%}
            .footer__text-img {
              max-width: {{ block.settings.logo_width_desktop }}px;
              height: auto;
              display: block;
            }
          {%- endstyle -%}
          {%- comment -%} Column size class {%- endcomment -%}
          {%- liquid
            case block.settings.column_size
              when 'small'
                assign col_class = 'footer__block--small'
              when 'medium'
                assign col_class = 'footer__block--medium'
              when 'large'
                assign col_class = 'footer__block--large'
              else
                assign col_class = 'footer__block--medium'
            endcase

            
          -%}

          {%- case block.type -%}

            {%- comment -%} ══ NEWSLETTER block ══ {%- endcomment -%}
            {%- when 'newsletter' -%}
              <div class="footer__block {{ col_class }} footer__block--newsletter" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="footer__block-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__block-richtext rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- form 'customer', id: 'footer-nl-{{ block.id }}' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="footer__nl-row">
                    <input
                      type="email"
                      name="contact[email]"
                      class="footer__nl-input"
                      placeholder="{{ block.settings.placeholder | default: 'Email address' }}"
                      required
                      autocomplete="email"
                      aria-label="{{ block.settings.placeholder | default: 'Email address' }}"
                    >
                    <button type="submit" class="footer__nl-btn">
                      {{ block.settings.btn_label | default: 'Subscribe' }}
                    </button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    <p class="footer__nl-success">{{ block.settings.success_msg | default: 'Thanks for subscribing!' }}</p>
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- comment -%} ══ MENU block ══ {%- endcomment -%}
            {%- when 'link_list' -%}
              <div class="footer__block {{ col_class }} footer__block--menu" {{ block.shopify_attributes }}>
                {%- if block.settings.menu != blank -%}
                  <div class="footer__menu-mobile">
                    <button class="footer__mobile-toggle">
                      <h3 class="footer__block-title">{{ block.settings.title }}</h3>
                      <span class="footer__toggle-icon"></span>
                    </button>

                    <ul class="footer__menu-list" role="list">
                      {%- for link in block.settings.menu.links -%}
                        <li>
                          <a href="{{ link.url }}" class="footer__menu-link">
                            {{ link.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>

            {%- comment -%} ══ TEXT block ══ {%- endcomment -%}
            {%- when 'text' -%}
              {%- liquid
                assign desktop_align_class = ''
                assign mobile_align_class = ''

                case block.settings.text_alignment
                  when 'center'
                    assign desktop_align_class = 'footer__block--center'
                  when 'right'
                    assign desktop_align_class = 'footer__block--right'
                  else
                    assign desktop_align_class = 'footer__block--left'
                endcase

                case block.settings.mobile_text_alignment
                  when 'center'
                    assign mobile_align_class = 'footer__block--mobile-center'
                  when 'right'
                    assign mobile_align_class = 'footer__block--mobile-right'
                  else
                    assign mobile_align_class = 'footer__block--mobile-left'
                endcase
              -%}
              <div class="footer__block {{ col_class }} footer__block--text {{ desktop_align_class }} {{ mobile_align_class }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="footer__text-img-wrap">
                    {{
                      block.settings.image
                      | image_url: width: 480
                      | image_tag:
                        loading: 'lazy',
                        class: 'footer__text-img',
                        alt: block.settings.image.alt | escape
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="footer__block-title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="footer__block-richtext rte footer__block-richtext--{{ block.settings.text_size }}">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_link != blank -%}
                  <a
                    href="{{ block.settings.button_link | default: '#' }}"
                    class="footer__text-btn button button--secondary"
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}

                {%- if block.settings.show_social_links and has_social -%}
                  {%- render 'social-icons', class: 'footer__list-social' -%}
                {%- endif -%}

              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__divider"></div>

    {%- comment -%} ── BOTTOM BAR ── {%- endcomment -%}
    <div class="footer__bottom">

      <div class="footer__bottom-left">
        <p class="footer__copyright sm:text-xs text-xss">
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url -}}.
          {%- if section.settings.copyright_text != blank -%}
            &nbsp;{{ section.settings.copyright_text }}.
          {%- endif -%}
        </p>

        {%- if section.settings.bottom_menu != blank -%}
          <ul class="footer__bottom-nav" role="list">
            {%- for link in section.settings.bottom_menu.links -%}
              <li><a href="{{ link.url }}" class="footer__bottom-link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__bottom-right">

        {%- comment -%} Language switcher {%- endcomment -%}
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body text-xss sm:text-xs" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                 {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- comment -%} Currency switcher {%- endcomment -%}
        {%- if section.settings.enable_currency_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body text-xss sm:text-xs" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

       

        {%- comment -%} Payment icons {%- endcomment -%}
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
          <ul class="footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="footer__payment-item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>
    </div>

  </div>
</footer>

<script>
  const footerMobile = document.querySelectorAll('.footer__mobile-toggle');
  if(footerMobile){  
    footerMobile.forEach((button) => {
      button.addEventListener('click', () => {
        button.parentElement.classList.toggle('active');
      });
    });
  }
</script>

{% schema %}

{{ 'header.css' | asset_url | stylesheet_tag }}
{% style %}
  .header {
    --header-padding: {{ section.settings.padding_vertical }}px;
    --header-separator: {{ section.settings.separator_color }};
  }
  .main-header-wrapper.has-separator {
    border-bottom: 0.1rem solid {{ section.settings.separator_color }};
  }
  .header--row-bottom .header__nav {
    border-top: 0.1rem solid {{ section.settings.separator_color }};
  }
    /* ----- Dropdown ----- */
  .header__submenu {
    position: absolute; top: 100%; left: 0; min-width: 200px;
    background: {{ settings.header_background_color }}; color: {{ settings.header_text_color }};
    list-style: none; margin: 0; padding: 0.8rem 0;
    box-shadow: 0 0.8rem 2.4rem rgba(0,0,0,.12); border-radius: var(--radius-sm);
    opacity: 0; visibility: hidden; transform: translateY(0.6rem);
    transition: .18s ease; z-index: 40;
  }
  /* ----- Drawer / mobile toggle ----- */
  .header__drawer {
    position: fixed; top: 0; left: -32.0rem; width: 30.0rem; height: 100dvh;
    background: {{ settings.header_background_color }}; color: {{ settings.header_text_color }};
    box-shadow: 0.2rem 0 2.0rem rgba(0,0,0,.2); transition: left .25s ease;
    z-index: 60; padding: 2.4rem; overflow-y: auto;
  }
  .header__nav-link:hover { color: {{ settings.header_hover_text_color }} }
  {%- if section.settings.menu_type != "drawer" -%}
    @media screen and (min-width: 992px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}
{% endstyle %}
{%- liquid
  assign logo_pos = section.settings.logo_position
  assign menu_pos = section.settings.menu_position
  assign menu_row = section.settings.menu_row
  assign menu_type = section.settings.menu_type
  assign mobile_logo = section.settings.mobile_logo_position
  assign sticky = section.settings.sticky_header
  assign localization_forms = false
  if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
    assign localization_forms = true
  endif
-%}

<site-header
  class="main-header-wrapper header--sticky-{{ sticky }} {% if section.settings.separator_line %}has-separator{% endif %}"
  data-sticky="{{ sticky }}"
>
  <header
    class="
      header
      header--logo-{{ logo_pos }}
      header--menu-{{ menu_pos }}
      header--row-{{ menu_row }}
      header--{{ menu_type }}
      header--mobile-logo-{{ mobile_logo }}
      {% if section.settings.menu_type == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu_type != blank %} header--has-menu{% endif %}
      {{ section.settings.section_width }}
       {% if shop.customer_accounts_enabled %} header--has-account{% endif %}
       {% if localization_forms %} header--has-localizations{% endif %}
    "
  >
    <div class="header__inner">
      {%- liquid
        if section.settings.main_menu != blank
          render 'header-drawer'
        endif
      -%}
      {%- comment -%} ---------- Logo ---------- {%- endcomment -%}
      <div class="header__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width_desktop | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width_desktop }}px, {{ settings.logo_width_mobile }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width_desktop }}, {{ settings.logo_width_desktop | times: 1.5 | round }}, {{ settings.logo_width_desktop | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo',
                width: widths,
                height: logo_height,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- liquid
        assign has_blocks = false

        if section.settings.main_menu != blank
          if section.blocks.size > 0
            for link in section.settings.main_menu.links
              for block in section.blocks
                if block.settings.parent_item != blank
                  assign block_target = block.settings.parent_item | downcase | strip
                  assign link_title = link.title | downcase | strip

                  if block_target == link_title
                    assign has_blocks = true
                    break
                  endif
                endif
              endfor

              if has_blocks
                break
              endif
            endfor
          endif
          if menu_type == 'dropdown'
            if has_blocks
              render 'header-mega-menu'
            else
              render 'header-dropdown-menu'
            endif
          elsif menu_type != 'drawer'
            render 'header-mega-menu'
          endif
        endif
      -%}

      {%- comment -%} ---------- Utilities ---------- {%- endcomment -%}
      <div class="header__utils {% if section.settings.show_country or section.settings.show_language %} header__icons--localization header-localization{% endif %}">
        {%- comment -%} Country / region selector {%- endcomment -%}
        {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body text-xss sm:text-xs" id="FooterCountryLabel">
                  {{ 'localization.country_label' | t }}
                </h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- comment -%} Language selector {%- endcomment -%}
        {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body text-xss sm:text-xs" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- comment -%} Search + Wishlist + Cart {%- endcomment -%}
        <header-search class="header-search">
          <button
            type="button"
            class="header-search__toggle header__icon-btn"
            aria-label="{{ 'search.title' | t }}"
            aria-haspopup="dialog"
            aria-expanded="false"
            data-search-open
          >
            {% render 'icon', icon: 'search', width: 20, height: 20 %}
          </button>

          <div class="search-modal" data-search-modal>
            <div class="search-modal__overlay" data-search-close></div>
            <div
              class="search-modal__panel"
              role="dialog"
              aria-modal="true"
              aria-label="{{ 'search.title' | t }}"
            >
              <div class="search-modal__inner">
                <div class="search-modal__form-wrapper">
                  {%- if settings.predictive_search_enabled -%}
                    <predictive-search data-loading-text="{{ 'search.loading' | t }}">
                  {%- else -%}
                    <search-form>
                  {%- endif -%}
                    <form action="{{ routes.search_url }}" method="get" role="search" class="search">
                      <div class="field with-icon-right">
                        <label class="visually-hidden" for="HeaderSearch-Input">
                          {{- 'search.placeholder' | t -}}
                        </label>
                        <input
                          class="search__input field__input"
                          id="HeaderSearch-Input"
                          type="search"
                          name="q"
                          value="{{ search.terms | escape }}"
                          placeholder="{{ 'search.placeholder' | t }}"
                          {%- if settings.predictive_search_enabled %}
                            role="combobox"
                            aria-expanded="false"
                            aria-owns="predictive-search-results"
                            aria-controls="predictive-search-results"
                            aria-haspopup="listbox"
                            aria-autocomplete="list"
                            autocorrect="off"
                            autocomplete="off"
                            autocapitalize="off"
                            spellcheck="false"
                          {%- endif %}
                        >
                        <input name="options[prefix]" type="hidden" value="last">

                        <button
                          type="reset"
                          class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                          aria-label="{{ 'search.reset' | t }}"
                        >
                          <span class="svg-wrapper">
                            {% render 'icon', icon: 'close', width: 18, height: 18 %}
                          </span>
                        </button>
                        <button type="submit" class="search__button field__button" aria-label="{{ 'search.title' | t }}">
                          <span class="svg-wrapper">
                            {% render 'icon', icon: 'search', width: 20, height: 20 %}
                          </span>
                        </button>
                      </div>

                      {%- if settings.predictive_search_enabled -%}
                        <div
                          class="predictive-search predictive-search--header"
                          tabindex="-1"
                          data-predictive-search
                        >
                          <div class="predictive-search__loading-state">
                            {%- render 'loading-spinner' -%}
                          </div>
                        </div>
                        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                      {%- endif -%}
                    </form>
                  {%- if settings.predictive_search_enabled -%}
                    </predictive-search>
                  {%- else -%}
                    </search-form>
                  {%- endif -%}
                </div>
                <button
                  type="button"
                  class="search-modal__close"
                  aria-label="{{ 'search.close' | t }}"
                  data-search-close
                >
                  {% render 'icon', icon: 'close', width: 24, height: 24 %}
                </button>
              </div>
            </div>
          </div>
        </header-search>
        {%- if settings.enable_wishlist -%}
          {%- liquid
            if settings.wishlist_page != blank
              assign wishlist_url = settings.wishlist_page.url
            else
              assign wishlist_url = '/pages/wishlist'
            endif
          -%}
          <a href="{{ wishlist_url }}" class="header__icon-btn wishlist" aria-label="{{ 'wishlist.title' | t }}">
            {% render 'icon', icon: 'heart', width: 20, height: 20 %}
            <span class="header__wishlist-count" data-wishlist-count hidden>0</span>
          </a>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon-btn header__icon--account {% if section.settings.menu != blank %} small-hide{% endif %}"
            rel="nofollow"
          >
            {%- if section.settings.enable_customer_avatar -%}
              <account-icon>
                {%- if customer and customer.has_avatar? -%}
                  {{ customer | avatar }}
                {%- else -%}
                  <span class="svg-wrapper">
                    {% render 'icon', icon: 'account', width: 20, height: 20 %}
                  </span>
                {%- endif -%}
              </account-icon>
            {%- else -%}
              <span class="svg-wrapper"> {% render 'icon', icon: 'account', width: 20, height: 20 %}</span>
            {%- endif -%}
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'Account'
                else
                  echo 'Log in'
                endif
              -%}
            </span>
          </a>
        {%- endif -%}
        <a
          href="{{ routes.cart_url }}"
          class="header__icon-btn"
          aria-label="Cart"
          {% if settings.cart_type == 'cart_drawer' or settings.cart_type == 'cart_popup' %}
            data-cart-drawer-trigger
          {% endif %}
        >
          {% render 'icon', icon: 'cart', width: 20, height: 20 %}
          <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </header>
</site-header>

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Position",
      "default": "start",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_logo_position",
      "label": "Mobile logo position",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "start", "label": "Left" }
      ]
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "menu_type",
      "label": "Menu type",
      "default": "dropdown",
      "options": [
        { "value": "dropdown", "label": "Dropdown" },
        { "value": "mega", "label": "Mega menu" },
        { "value": "drawer", "label": "Drawer" }
      ]
    },
    {
      "type": "select",
      "id": "menu_position",
      "label": "Position",
      "default": "start",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "menu_row",
      "label": "Row",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": "always",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "scroll-up", "label": "On scroll up" },
        { "value": "always", "label": "Always" },
        { "value": "reduce", "label": "Always, reduce logo size" }
      ]
    },
    {
      "type": "checkbox",
      "id": "separator_line",
      "label": "Separator line",
      "default": true
    },
    {
      "type": "header",
      "content": "Utilities"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "Country/region selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Language selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_customer_avatar",
      "default": true,
      "label": "Customer account avatar",
      "info": "Only visible when customers are signed in with Shop. [Manage customer accounts](/admin/settings/customer_accounts)"
    },
    {
      "type": "header",
      "content": "Colors & spacing"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator / border",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "parent_item",
          "label": "Menu item",
          "info": "Exact top-level menu item title this column appears under (e.g. Shop)."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "image_banner",
      "name": "Image Banner",
      "settings": [
        {
          "type": "text",
          "id": "parent_item",
          "label": "Menu item",
          "info": "Exact top-level menu item title this banner appears under (e.g. Shop)."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ]
}
{% endschema %}

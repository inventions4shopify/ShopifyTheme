{{ 'hot-spot.css' | asset_url | stylesheet_tag }}


<div {%- render 'section-variables', section: section, class: 'cms-hot-spot__section' -%}>
  <div class="{{ section.settings.section_width }}">
    <div class="cms-hot-spot-row image_media--{{ section.settings.media_height }}">
        <div class="cms-hot-spot__media">
            {% if section.settings.media_type == 'image' %}
            <picture>
                <source
                media="(max-width: 767px)"
                srcset="{% if section.settings.mb_image != blank %}{{ section.settings.mb_image | image_url }}{% else %}{{ 'img-with-text.svg' | asset_url }}{% endif %}"
                >

                <img
                src="{% if section.settings.desktop_image != blank %}{{ section.settings.desktop_image | image_url }}{% else %}{{ 'thumbnail.svg' | asset_url }}{% endif %}"
                alt="{{ section.settings.desktop_image.alt | escape }}"
                loading="lazy"
                width="auto"
                height="auto"
                >
            </picture>
            {% elsif section.settings.media_type == 'video' %}
                {% if section.settings.desktop_video != blank %}
                    <video
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="metadata"
                        class="hero-media"
                    >
                        {%- if section.settings.desktop_video != blank -%}
                        {% for source in section.settings.desktop_video.sources %}
                            {% if source.format == 'mp4' %}
                                <source
                                    src="{{ source.url }}"
                                    type="video/mp4"
                                    media="(max-width: 989px)"
                                >
                                {% break %}
                            {% endif %}
                        {% endfor %}
                        {%- elsif section.settings.desktop_video != blank -%}
                            {% for source in section.settings.desktop_video.sources %}
                                {% if source.format == 'mp4' %}
                                <source
                                    src="{{ source.url }}"
                                    type="video/mp4"
                                    media="(max-width: 989px)"
                                >
                                {% break %}
                                {% endif %}
                            {% endfor %}
                        {%- endif -%}
                        {%- if section.settings.desktop_video != blank -%}
                            {% for source in section.settings.desktop_video.sources %}
                                {% if source.format == 'mp4' %}
                                <source
                                    src="{{ source.url }}"
                                    type="video/mp4"
                                    media="(min-width: 990px)"
                                >
                                {% break %}
                                {% endif %}
                            {% endfor %}
                        {%- endif -%}
                    </video>
                {% endif %}
            {% endif %}
        </div>
        <div class="cms-hot-spot__content flex ps-rte media-overlay-content--{{ section.settings.content_alignment }} cms-cell--{{ section.settings.width }} flex-col">
            {%- assign sub_color = section.settings.subheading_color -%}
                <span class="subheading" 
                {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ sub_color.rgb }});"
                {%- endunless %}
                >{{ section.settings.subheading }}</span>
            
            {%- assign head_grad = section.settings.heading_gradient -%}
            {%- assign head_color = section.settings.heading_color -%}

            {%- capture heading_style -%}
                {%- if head_grad != blank -%}
                background: {{ head_grad }};
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                --color-heading: {{ head_color.rgb }};
                {%- endif -%}
            {%- endcapture -%}
            
                <h2 class="cms-hot-spot__heading {{ section.settings.heading_size }}"
                {%- unless heading_style == blank %}
                style="{{ heading_style | strip }}"
                {%- endunless %}
                >{{ section.settings.heading }}</h2>
            
            {%- assign block_color = section.settings.text_color -%}
            <div class="cms-hot-spot__description"
                {%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ block_color.rgb }});"
                {%- endunless %}
            >
                {{ section.settings.description }}
            </div>
            
            {%- render 'button',
                text: section.settings.link_label,
                href: section.settings.link,
                background_color: section.settings.button_background_color,
                text_color: section.settings.button_text_color,
                outline_color: section.settings.button_outline_color
            -%}
        </div>
        <hot-spot-section class="cms-hot-spot-items">
            {%  for block in section.blocks  %}
                <div class="cms-hot-spot-cell" 
                style="
                    --hot-spot-bg: {{ block.settings.box_color }};
                    --button-position-horizontal-mobile: {{ block.settings.mb_horizontal_position }}%;
                    --button-position-vertical-mobile: {{ block.settings.mb_vertical_position }}%;
                    --button-position-horizontal-desktop: {{ block.settings.horizontal_position }}%;
                    --button-position-vertical-desktop: {{ block.settings.vertical_position }}%;
                    --hot-spot-heading-color: {{ block.settings.hot_spot_head_color }};
                ">
                    <button class="button button--secondary">
                        {% render 'icon', icon: 'plus', width: 20, height: 20 %}
                    </button>
                    <div class="cms-hot-spot-body ps-rte">
                        <h3 class="h5">{{ block.settings.hot-spot-heading }}</h3>
                        {{ block.settings.hot-spot-description }}
                    </div>
                </div>
            {% endfor %}
        </hot-spot-section>
    </div>
  </div>
</div>

<script src="{{ 'hot-spot.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hot Spots",
  "tag": "section",
  "class": "cms-hot-spot",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Media Width"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
        "type": "select",
        "id": "media_type",
        "label": "Type",
        "options": [
        {
            "value": "image",
            "label": "Image"
        },
        {
            "value": "video",
            "label": "Video"
        }
        ],
        "default": "image"
    },
    {
        "type": "video",
        "id": "desktop_video",
        "visible_if": "{{ section.settings.media_type == 'video' }}",
        "label": "Video"
    },
    {
        "type": "image_picker",
        "id": "mb_image",
        "visible_if": "{{ section.settings.media_type == 'image' }}",
        "label": "Mobile Image"
    },
    {
        "type": "image_picker",
        "id": "desktop_image",
        "visible_if": "{{ section.settings.media_type == 'image' }}",
        "label": "Desktop Image"
    },
    {
        "type": "select",
        "id": "content_alignment",
        "label": "Content Alignment",
        "options": [
        {
            "label": "Left Top",
            "value": "left-top"
        },
        {
            "label": "Center Top",
            "value": "center-top"
        },
        {
            "label": "Right Top",
            "value": "right-top"
        },
        {
            "label": "Left Center",
            "value": "left-center"
        },
        {
            "label": "Center Center",
            "value": "center-center"
        },
        {
            "label": "Right Center",
            "value": "right-center"
        },
        {
            "label": "Left Bottom",
            "value": "left-bottom"
        },
        {
            "label": "Center Bottom",
            "value": "center-bottom"
        },
        {
            "label": "Right Bottom",
            "value": "right-bottom"
        }
        ],
        "default": "left-center"
    },
    {
        "type": "text",
        "id": "subheading",
        "label": "Sub heading",
        "default": "Upgrade Your Style Today"
    },
    {
        "type": "color",
        "id": "subheading_color",
        "label": "Subheading color"
    },    
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Discover Our Latest Collection"
    },
    {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size (visual)",
        "options": [
        { "value": "h1", "label": "H1 - Largest" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6 - Smallest" }
        ],
        "default": "h2"
    },
    {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color"
    },
    {
        "type": "color_background",
        "id": "heading_gradient",
        "label": "Heading gradient"
    },
    {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Explore our latest collection of fashion-forward apparel and accessories. From trendy tops to stylish shoes, we have everything you need to elevate your wardrobe.</p>"
    },
    {
        "type": "color",
        "id": "text_color",
        "label": "Text color"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Link"
    },
    {
        "type": "text",
        "id": "link_label",
        "label": "Link Label",
        "default": "Shop Now"
    },
    {
        "type": "color",
        "id": "button_background_color",
        "label": "Button background"
    },
    {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text"
    },
    {
        "type": "color",
        "id": "button_outline_color",
        "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
        "type": "hot-spot",
        "name": "Hot Spot",
        "settings": [
            {
                "type": "range",
                "id": "horizontal_position",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "%",
                "label": "Horizontal position",
                "default": 83
            },
            {
                "type": "range",
                "id": "vertical_position",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "%",
                "label": "Vertical Position",
                "default": 74
            },
            {
                "type": "range",
                "id": "mb_horizontal_position",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "%",
                "label": "Horizontal position [Mobile]",
                "default": 83
            },
            {
                "type": "range",
                "id": "mb_vertical_position",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "%",
                "label": "Vertical Position [Mobile]",
                "default": 74
            },
            {
                "type": "image_picker",
                "id": "hot-spot-icon",
                "label": "Icon"
            },
            {
                "type": "range",
                "min": 0,
                "max": 40,
                "step": 1,
                "unit": "px",
                "id": "hot-spot-icon-width",
                "label": "Icon Size",
                "default": 40
            },
            {
                "type": "text",
                "id": "hot-spot-heading",
                "label": "Heading",
                "default": "Card Title"
            },
            {
                "type": "richtext",
                "id": "hot-spot-description",
                "label": "Description",
                "default": "<p>Card Description</p>"
            },
            {
                "type": "header",
                "content": "Colors"
            },
            {
                "type": "color",
                "id": "box_color",
                "label": "Box color",
                "default": "#ffffff"
            },
            {
                "type": "color",
                "id": "hot_spot_head_color",
                "label": "Card Content color"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Hot Spots",
      "blocks": [
        {
          "type": "hot-spot"
        },
        {
          "type": "hot-spot"
        },
        {
          "type": "hot-spot"
        }
      ]
    }
  ]
}
{% endschema %}
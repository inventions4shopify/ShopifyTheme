{{ 'image-with-text.css' | asset_url | stylesheet_tag }}

<style>
  {% if section.settings.image_show != true %}
    .cms-image-with-text__media {
      border-radius: var(--tps-media-radius);
      position: relative;
      overflow: hidden;
    }
  {% endif %}

  {% if section.settings.image_show == true %}
      .cms-image-with-text__content {
          padding-left: 2rem;
          padding-right: 2rem;
          padding-top: var(--tps-section-spacing-top);
          padding-bottom: var(--tps-section-spacing-bottom);
      }
  {% endif %}

  .cms-image-with-text-row {
      display: flex;
      flex-wrap: wrap;
      {% if section.settings.image_show != true %}
          margin: 0 -15px;
      {% endif %}
      gap: 4rem;
  }

  {% if section.settings.image_show != true %}
    .cms-image-with-text-row >* {
      padding: 0 1.5rem;
    }
  {% endif %}

  @media (min-width: 768px) {
    .cms-cell--{{ section.settings.width }} {
        width: {% case section.settings.width %}
            {% when 'small' %} 33.3333%
            {% when 'medium' %} 50%
            {% when 'large' %} 66.6666%
        {% endcase %};
    }

    .cms-image-with-text-row {
      gap: 0;
    }

    .cms-image-with-text__content {
        width: {% if section.settings.image_show == true %} 50% {% else %} 1% {% endif %};
        flex: {% if section.settings.image_show != true %} 1 1 auto {% endif %};
        max-width: 64rem;
    }
  }
</style>

{%- liquid
  assign s = section.settings

  # ── Gap class ─────────────────────────────────────────────────────────────
  assign gap_value = s.gap | default: '24'
  assign gap_class = ''
  if gap_value != 'default'
    assign gap_class = 'gap-' | append: gap_value
  else
    assign gap_class = 'gap-24'
  endif
-%}

<div {%- render 'section-variables', section: section, class: 'image-with-text__section' -%}>
  <div class="{% if section.settings.image_show != true %} {{ section.settings.section_width }} {% endif %}">
    <div class="cms-image-with-text-row flex-{{ section.settings.image_position }}">
      <div class="cms-cell--{{ section.settings.width }}">
        <div class="cms-image-with-text__media image_media--{{ section.settings.media_height }}">
            {% if section.settings.media_type == 'image' %}
                <picture>
                {% if section.settings.mb_image != blank %}
                    <source
                    media="(max-width: 767px)"
                    srcset="{{ section.settings.mb_image | image_url: width: 767 }}"
                    >
                {% endif %}

                {% if section.settings.desktop_image != blank %}
                    <img
                    src="{{ section.settings.desktop_image | image_url: width: 719 }}"
                    alt="{{ section.settings.desktop_image.alt | escape }}"
                    loading="lazy"
                    width="{{ section.settings.desktop_image.width }}"
                    height="{{ section.settings.desktop_image.height }}"
                    >
                {% else %}
                    <img
                      src="{{ 'img-with-text.svg' | asset_url }}"
                      alt="Placeholder image"
                      loading="lazy"
                      width="719"
                      height="460"
                    >
                {% endif %}
                </picture>

            {% elsif section.settings.media_type == 'video' %}
                {% if section.settings.desktop_video != blank %}
                {{
                    section.settings.desktop_video
                    | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    preload: 'metadata',
                    class: 'hero-media'
                }}
                {% endif %}
            {% endif %}
        </div>
      </div>
      <div class="cms-image-with-text__content {{ gap_class }} items-{{ section.settings.text_alignment }} text-{{ section.settings.text_alignment }} justify-{{ section.settings.content_alignment }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'subheading' %}
              {%- assign sub_color = block.settings.subheading_color -%}
              <span
                class="section-header__subheading subheading"
                {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                  style="color: rgb({{ sub_color.rgb }});"
                {%- endunless %}
              >
                {{- block.settings.subheading -}}
              </span>
            {% when 'heading' %}
              {%- assign head_grad = block.settings.heading_gradient -%}
              {%- assign head_color = block.settings.heading_color -%}

              {%- capture heading_style -%}
                      {%- if head_grad != blank -%}
                        background: {{ head_grad }};
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                      {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                        --tps-color-heading: {{ head_color.rgb }};
                      {%- endif -%}
                    {%- endcapture -%}

              <h2
                class="section-header__heading {{ block.settings.heading_size }}"
                {%- unless heading_style == blank %}
                  style="{{ heading_style | strip }}"
                {%- endunless %}
              >
                {{ block.settings.heading }}
              </h2>
            {% when 'description' %}
              {%- assign block_color = block.settings.text_color -%}
              <div
                class="image-with__text ps-rte"
                {%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' %}
                  style="color: rgb({{ block_color.rgb }});"
                {%- endunless %}
              >
                {{ block.settings.description }}
              </div>
            {% when 'buttons' %}
              {%- render 'button',
                text: block.settings.link_label,
                href: block.settings.link,
                background_color: block.settings.button_background_color,
                text_color: block.settings.button_text_color,
                outline_color: block.settings.button_outline_color
              -%}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image With Text",
  "tag": "section",
  "class": "cms-image-with-text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Layout Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Media Width"
    },
    {
      "type": "checkbox",
      "id": "image_show",
      "default": false,
      "label": "Show image In Half Screen"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "row",
          "label": "Image First"
        },
        {
          "value": "row-reverse",
          "label": "Image Second"
        }
      ],
      "default": "row",
      "label": "Image Position"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "visible_if": "{{ section.settings.media_type == 'video' }}",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "mb_image",
      "visible_if": "{{ section.settings.media_type == 'image' }}",
      "label": "Mobile Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "visible_if": "{{ section.settings.media_type == 'image' }}",
      "label": "Desktop Image"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Content Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" },
        { "value": "48", "label": "2× large" }
      ],
      "default": "12"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Sub heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub heading",
          "default": "Upgrade Your Style Today"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Subheading color"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover Our Latest Collection"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size (visual)",
          "options": [
            { "value": "h1", "label": "H1 - Largest" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6 - Smallest" }
          ],
          "default": "h2"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color"
        },
        {
          "type": "color_background",
          "id": "heading_gradient",
          "label": "Heading gradient"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Explore our latest collection of fashion-forward apparel and accessories. From trendy tops to stylish shoes, we have everything you need to elevate your wardrobe.</p>"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "button_background_color",
          "label": "Button background"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text"
        },
        {
          "type": "color",
          "id": "button_outline_color",
          "label": "Button outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image With Text",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}

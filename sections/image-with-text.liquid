{{ 'image-with-text.css' | asset_url | stylesheet_tag }}

<style>

    {% if section.settings.image_show != true %}
        .cms-image-with-text {
            padding-top: var(--section-spacing-top);
            padding-bottom: var(--section-spacing-bottom);
        }

        .cms-image-with-text__media {
            border-radius: var(--spacing-20);
            position: relative;
            overflow: hidden;
        }
    {% endif %}

    {% if section.settings.image_show == true %}
        .cms-image-with-text__content {
            padding-left: 2rem;
            padding-right: 2rem;
            padding-top: var(--section-spacing-top);
            padding-bottom: var(--section-spacing-bottom);
            max-width: 64rem;
        }
    {% endif %}

    .cms-image-with-text-row {
        display: flex;
        flex-wrap: wrap;
        {% if section.settings.image_show != true %}
            margin: 0 -15px;
        {% endif %}
    }

    {% if section.settings.image_show != true %}
    .cms-image-with-text-row >* {
        padding: 1.5rem;
    }
    {% endif %}

    @media (min-width: 768px) {
        .cms-cell--{{ section.settings.width }} {
            width: {% case section.settings.width %}
                {% when 'small' %} 33.3333%
                {% when 'medium' %} 50%
                {% when 'large' %} 66.6666%
            {% endcase %};
        }

        .cms-image-with-text__content {
            display: flex;
            flex-direction: column;
            width: {% if section.settings.image_show == true %} 50% {% else %} 1% {% endif %};
            flex: {% if section.settings.image_show != true %} 1 1 auto {% endif %};
        }
    }
</style>


<div class="{% if section.settings.image_show != true %} {{ section.settings.section_width }} {% endif %}">
    <div class="cms-image-with-text-row flex-{{ section.settings.image_position }}">
        <div class="cms-cell--{{ section.settings.width }}">
            <div class="cms-image-with-text__media image_media--{{ section.settings.media_height }}">
                {% if section.settings.media_type == 'image' %}
                    {% if section.settings.mb_image != blank or section.settings.desktop_image != blank %}
                        <picture>
                            {% if section.settings.mb_image != blank %}
                                <source
                                media="(max-width: 767px)"
                                srcset="{{ section.settings.mb_image | image_url }}"
                                >
                            {% endif %}
                            {% if section.settings.desktop_image != blank %}
                                <img
                                    src="{{ section.settings.desktop_image | image_url }}"
                                    alt="{{ section.settings.desktop_image.alt | escape }}"
                                    loading="lazy"
                                    width="auto"
                                    height="auto"
                                >
                            {% endif %}
                        </picture>
                    {% endif  %}
                {% elsif section.settings.media_type == 'video' %}
                    {% if section.settings.desktop_video != blank %}
                        <video
                            autoplay
                            loop
                            muted
                            playsinline
                            preload="metadata"
                            class="hero-media"
                        >
                            {%- if section.settings.desktop_video != blank -%}
                            {% for source in section.settings.desktop_video.sources %}
                                {% if source.format == 'mp4' %}
                                    <source
                                        src="{{ source.url }}"
                                        type="video/mp4"
                                        media="(max-width: 989px)"
                                    >
                                    {% break %}
                                {% endif %}
                            {% endfor %}
                            {%- elsif section.settings.desktop_video != blank -%}
                                {% for source in section.settings.desktop_video.sources %}
                                    {% if source.format == 'mp4' %}
                                    <source
                                        src="{{ source.url }}"
                                        type="video/mp4"
                                        media="(max-width: 989px)"
                                    >
                                    {% break %}
                                    {% endif %}
                                {% endfor %}
                            {%- endif -%}
                            {%- if section.settings.desktop_video != blank -%}
                                {% for source in section.settings.desktop_video.sources %}
                                    {% if source.format == 'mp4' %}
                                    <source
                                        src="{{ source.url }}"
                                        type="video/mp4"
                                        media="(min-width: 990px)"
                                    >
                                    {% break %}
                                    {% endif %}
                                {% endfor %}
                            {%- endif -%}
                        </video>
                    {% endif %}
                {% endif %}
            </div>
        </div>
        <div class="cms-image-with-text__content flex-{{ section.settings.text_alignment }} justify-{{ section.settings.content_alignment }}">
            {% for block in section.blocks %}
                {% case block.type %}
                {% when 'caption' %}
                    <p class="cms-image-with-text__subheading">{{ block.settings.subheading }}</p>
                {% when 'heading' %}
                    <h2 class="cms-image-with-text__heading">{{ block.settings.heading }}</h2>
                {% when 'description' %}
                    <div class="cms-image-with-text__description">{{ block.settings.description }}</div>
                {% when 'buttons' %}
                    <a href="{{ block.settings.link }}" class="btn">{{ block.settings.link_label }}</a>
                {% endcase %}
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Image With Text",
  "class": "section cms-image-with-text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Width"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "checkbox",
        "id": "image_show",
        "default": false,
        "label": "Show image In Half Screen"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "row",
          "label": "Image First"
        },
        {
          "value": "row-reverse",
          "label": "Image Second"
        }
      ],
      "default": "row",
      "label": "Image Position"
    },
    {
        "type": "select",
        "id": "media_type",
        "label": "Type",
        "options": [
        {
            "value": "image",
            "label": "Image"
        },
        {
            "value": "video",
            "label": "Video"
        }
        ],
        "default": "image"
    },
    {
        "type": "video",
        "id": "desktop_video",
        "visible_if": "{{ section.settings.media_type == 'video' }}",
        "label": "Video"
    },
    {
        "type": "image_picker",
        "id": "mb_image",
        "visible_if": "{{ section.settings.media_type == 'image' }}",
        "label": "Mobile Image"
    },
    {
        "type": "image_picker",
        "id": "desktop_image",
        "visible_if": "{{ section.settings.media_type == 'image' }}",
        "label": "Desktop Image"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "Media height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
        "type": "header",
        "content": "Content Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "End"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub heading"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image With Text",
      "blocks": [
        {
          "type": "caption"
        },
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
{{ 'product-image-gallery.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'product-image-gallery.js' | asset_url | script_tag }}

<div {%- render 'section-variables', section: section, class: 'slideshow__section' -%}>
  <div class="page-width">
    <div class="main-product-section">
      <div class="product-image-gallery-wrapper cms-cell--{{ section.settings.width }}">
        {% render 'product-image-gallery',
          product: product,
          thumbnail_layout: section.settings.thumbnail_layout,
          gallery_arrows_visibility: section.settings.gallery_arrows_device,
          gallery_zoom_type: section.settings.gallery_zoom_type,
          hover_zoom_style: section.settings.hover_zoom_style,
          gallery_arrow_display: section.settings.gallery_arrow_display
        %}
      </div>

      <div class="product-info-wrapper">
        {% render 'product-details', product: product, blocks: section.blocks %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Section",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Width"
    },
    {
      "type": "select",
      "id": "thumbnail_layout",
      "label": "Thumbnail Layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "gallery_arrows_device",
      "label": "Show Arrows On",
      "options": [
        {
          "value": "desktop",
          "label": "Desktop Only"
        },
        {
          "value": "mobile",
          "label": "Mobile Only"
        },
        {
          "value": "both",
          "label": "Both"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "both"
    },
    {
      "type": "select",
      "id": "gallery_arrow_display",
      "label": "Arrow visibility style",
      "options": [
        {
          "value": "always",
          "label": "Always show"
        },
        {
          "value": "hover",
          "label": "Show on hover"
        }
      ],
      "default": "always",
      "visible_if": "{{ section.settings.gallery_arrows_device != 'none' }}"
    },
    {
      "type": "select",
      "id": "gallery_zoom_type",
      "label": "Image Zoom Type",
      "options": [
        { "value": "none", "label": "No Zoom" },
        { "value": "hover", "label": "Hover Zoom" },
        { "value": "lightbox", "label": "Lightbox Slider" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "hover_zoom_style",
      "label": "Hover Zoom Style",
      "options": [
        {
          "value": "magnifier",
          "label": "Same Image Magnifier"
        },
        {
          "value": "preview_window",
          "label": "Separate Preview Window"
        }
      ],
      "default": "magnifier",
      "visible_if": "{{ section.settings.gallery_zoom_type == 'hover' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_drag",
      "label": "Enable desktop image drag",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "Product Section"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

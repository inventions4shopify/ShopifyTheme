
{{ 'multicolumn.css' | asset_url | stylesheet_tag }}

<div {%- render 'section-variables', section: section, class: 'multicolumn__section' -%}>
  <div class="{{ section.settings.container_width }}">
    <div class="multicolumn__content ps-rte">
        {% if section.settings.heading != blank %}
            {%- assign head_color = block.settings.heading_color -%}
            {%- assign head_grad = block.settings.heading_gradient -%}

            {%- capture heading_style -%}
              {%- if head_grad != blank -%}
                background: {{ head_grad }};
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
              {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                --color-heading: {{ head_color.rgb }};
              {%- endif -%}
            {%- endcapture -%}

            <h2 
            class="heading {{ section.settings.heading_size }} text-{{ section.settings.heading_alignment }}"
            {%- unless heading_style == blank %}
                style="{{ heading_style | strip }}"
            {%- endunless %}
            >
                {{ section.settings.heading }}
            </h2>
        {% endif %}
        <div class="grid grid--3-col">

        {% for block in section.blocks %}
            {%- assign text_color = block.settings.text_color -%}

            <div class="grid__item icon-box ps-rte">
            {% if block.settings.icon != blank %}
                <img 
                src="{{ block.settings.icon | img_url: '100x' }}" 
                alt="{{ block.settings.title }}"
                class="icon-image"
                width="auto"
                height="auto"
                >
            {% endif %}

            {% if block.settings.title != blank %}
                <h3 class="icon-title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
                <p class="icon-text">{{ block.settings.text }}</p>
            {% endif %}
            </div>
        {% endfor %}

        </div>
        {%- render 'button',
            text: section.settings.link_label,
            href: section.settings.link,
            style: section.settings.button_style,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            outline_color: section.settings.button_outline_color
        -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multi Column Icons",
  "tag":"section",
  "class":"multi-column-icons",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' }}"
    },
    {
        "type": "header",
        "content": "Content"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Talk about your brand"
    },
    {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size (visual)",
        "options": [
        { "value": "h1", "label": "H1 — Largest" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6 — Smallest" }
        ],
        "default": "h2"
    },
    {
        "type": "select",
        "id": "heading_alignment",
        "label": "Alignment",
        "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
        ],
        "default": "center"
    },
    {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color"
    },
    {
        "type": "color_background",
        "id": "heading_gradient",
        "label": "Heading gradient"
    },
    {
      "type": "header",
      "content": "Button Content"
    },
    {
        "type": "select",
        "id": "button_alignment",
        "label": "Button Alignment",
        "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
        ],
        "default": "center"
    },
    {
        "type": "text",
        "id": "link_label",
        "label": "Button label",
        "default": "Shop now"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Button link"
    },
    {
        "type": "color",
        "id": "button_background_color",
        "label": "Button background"
    },
    {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text"
    },
    {
        "type": "color",
        "id": "button_outline_color",
        "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Short description here"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Card Background color"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Card Text color"
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Card Border color"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Column Icons",
      "blocks": [
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" }
      ]
    }
  ]
}
{% endschema %}
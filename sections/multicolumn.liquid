
{{ 'multicolumn.css' | asset_url | stylesheet_tag }}

<style>
    .multicolumn__content .grid__item >* {
      color: var(--tps-card-text-color);
    }
</style>

<div {%- render 'section-variables', section: section, class: 'multicolumn__section' -%}>
  <div class="{{ section.settings.container_width }}">
    <div class="multicolumn__content flex flex-col items-{{ section.settings.heading_alignment }}">
        {% if section.settings.heading != blank %}
            {%- assign head_color = section.settings.heading_color -%}
            {%- assign head_grad = section.settings.heading_gradient -%}

            {%- capture heading_style -%}
              {%- if head_grad != blank -%}
                background: {{ head_grad }};
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
              {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                --tps-color-heading: {{ head_color.rgb }};
              {%- endif -%}
            {%- endcapture -%}

            <h2 
            class="heading {{ section.settings.heading_size }} text-{{ section.settings.heading_alignment }}"
            {%- unless heading_style == blank %}
                style="{{ heading_style | strip }}"
            {%- endunless %}
            >
                {{ section.settings.heading }}
            </h2>
        {% endif %}
        <div class="grid xs:grid--2-col md:grid--3-col">

          {% for block in section.blocks %}
            {%- assign text_color = section.settings.text_color -%}
            {%- assign card_bg_color = section.settings.bg_color -%}
            {%- assign border_color = section.settings.border_color -%}
            {%- assign border_radius = section.settings.border_radius -%}

              {%- capture card_style -%}
                {%- if card_bg_color != blank and card_bg_color != 'rgba(0,0,0,0)' -%}
                  --tps-card-bg-color: {{ card_bg_color }};
                {%- endif -%}
                {%- if text_color != blank and text_color != 'rgba(0,0,0,0)' -%}
                  --tps-card-text-color: {{ text_color }};
                {%- endif -%}
                {%- if border_color != blank and border_color != 'rgba(0,0,0,0)' -%}
                  --tps-card-border-color: {{ border_color }};
                {%- endif -%}
                {%- if border_radius != blank -%}
                  --tps-card-border-radius: {{ border_radius }}px;
                {%- endif -%}
              {%- endcapture -%}

            <div class="grid__item ps-rte" style="{{ card_style | strip }}">
              {%- assign icon_height = block.settings.icon-height -%}
              {%- assign svg_size = block.settings.icon-height | divided_by: 2 -%}
              {%- assign thumb_height = block.settings.thumb-height -%}

                {% if block.settings.media_type == 'icon' %}
                  <span class="icon-wrapper-svg" style="height: {{ icon_height }}px; width: {{ icon_height }}px;">
                      {% render 'icon', icon: block.settings.icon_name, width: svg_size, height: svg_size %}
                  </span>
                {% endif %}
                {% if block.settings.media_type == 'image' %}
                  <span class="icon-wrapper" style="height: {{ thumb_height }}px;">
                      {{
                        block.settings.icon
                        | image_url: width: 500
                        | image_tag:
                          alt: block.settings.title,
                          class: 'icon-image',
                          loading: 'lazy'
                      }}
                  </span>
                {% endif %}

            {% if block.settings.title != blank %}
                <h3 class="{{ section.settings.title_size }}">
                  {{ block.settings.title }}
                </h3>
            {% endif %}

            {% if block.settings.text != blank %}
                <div class="icon-text">{{ block.settings.text }}</div>
            {% endif %}
            </div>
          {% endfor %}

        </div>
        {%- render 'button',
            text: section.settings.link_label,
            href: section.settings.link,
            style: section.settings.button_style,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            outline_color: section.settings.button_outline_color
        -%}
    </div>
  </div>
</div>

{% schema %}
{

{% comment %}
  Dynamic Password Page
{% endcomment %}

<style>
  .password-content {
    width: 100%;
    margin: 0 auto;
  }

  .password-form-part input {
    margin-bottom: var(--spacing-12);
  }

  .password-logo {
    display:block;
    width:100%;
    max-width:{{ section.settings.logo_width }}px;
  }

  .section-password-url {
    flex-shrink: 0;
  }
</style>

{%- liquid
  assign s = section.settings

  # ── Layout Width ──────────────────────────────────────────────────────
  assign container_class = 'page-width'
  if s.container_width == 'full-width'
    assign container_class = 'page-width--full'
  elsif s.container_width == 'narrow'
    assign container_class = 'page-width page-width--narrow'
  elsif s.container_width == 'small'
    assign container_class = 'page-width page-width--small'
  elsif s.container_width == 'custom'
    assign container_class = 'page-width rich-text__container--custom'
  endif

  # ── Alignment class ───────────────────────────────────────────────────────
  assign align_value = s.alignment | default: 'center'
  assign align_class = 'text-' | append: align_value

-%}

<div class="section-password-header">
  {% if section.settings.logo %}
    <a href="/" class="password-logo">
      <img
        src="{{ section.settings.logo | image_url: width: 600 }}"
        alt="{{ shop.name }}"
        width="auto"
        height="auto"
      />
    </a>
  {%  else %}
    <a class="h4" href="/">{{ shop.name }}</a>
  {% endif %}
  <a href="/password" class="section-password-url">Enter Using Password</a>
</div>

<div {%- render 'section-variables', section: section, class: 'password__section' -%}>
  <div class="{{ container_class }}">
    <div class="password-content {{ align_class }}" style="max-width: {{ section.settings.text_width }};">
      <{{ section.settings.heading_tag }}
        class="{{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
      <div class="password-description">{{ section.settings.description }}</div>

      {% if shop.password_message != blank %}
        <p>{{ shop.password_message }}</p>
      {% endif %}

      <div class="password-form-part">
        {% form 'customer' %}

          {% if form.errors %}
            <div class="form-errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          >

          <input
            type="email"
            name="contact[email]"
            id="Email"
            placeholder="{{ section.settings.placeholder }}"
            required
          >

          {% if form.posted_successfully? %}
            <p class="footer__nl-success">
              {{ section.settings.success_msg }}
            </p>
          {% endif %}

          {%- render 'button',
            type: 'submit',
            text: section.settings.button_text,
            text_color: section.settings.button_text_color,
            outline_color: section.settings.button_outline_color
          -%}

        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password Page",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Layout Width",
      "options": [
        { "value": "page-width", "label": "Default" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_width",
      "label": "Contant Width",
      "options": [
        { "value": "", "label": "Full" },
        { "value": "80rem", "label": "Narrow" },
        { "value": "60rem", "label": "Extra narrow" },
        { "value": "50rem", "label": "Small" }
      ],
      "default": "50rem"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 50,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size (visual)",
      "options": [
        { "value": "h1", "label": "H1 — Largest" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6 — Smallest" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Our store will be launching soon.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "E-mail"
    },
    {
      "type": "text",
      "id": "success_msg",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Notify me"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
      "label": "Heading gradient"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ]
}
{% endschema %}
{{ 'main-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

<div {%- render 'section-variables', section: section, class: 'search__section' -%}>
  {% paginate search.results by section.settings.card_per_page %}
      {% capture collection_filters_form %}
          <form action="{{ routes.search_url }}{{ search_url }}" method="get" data-collection-filter>

            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="options[prefix]" value="last">

            {% for filter in search.filters %}
              <div class="cms-filter-group">

                <!-- CLOSED BY DEFAULT -->
                <details class="cms-filter-accordion">

                  <summary class="cms-filter-accordion-title">
                    <span class="cms-filter-label">{{ filter.label }}</span>
                    <span class="cms-filter-icon">
                      {% render 'icon', icon: 'chevron-bottom', width: 18, height: 18 %}
                    </span>
                  </summary>

                  <div class="cms-filter-accordion-content">

                    {% case filter.type %}

                      {% when 'list', 'boolean' %}
                        {% for value in filter.values %}
                          <label class="cms-filter-option">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                            >
                            <span>
                              {{ value.label }} <strong>({{ value.count }})</strong>
                            </span>
                          </label>
                        {% endfor %}

                      {% when 'price_range' %}
                        <div class="price-range">
                          <div class="field price-range__field">
                            <input
                              type="number"
                              class="field__input text-sm"
                              id="Filter-Price-{{ section.id }}-{{ forloop.index }}-min"
                              name="{{ filter.min_value.param_name }}"
                              placeholder="Min"
                              value="{{ filter.min_value.value }}"
                              min="0"
                              inputmode="numeric"
                            >
                            <label class="field__label" for="Filter-Price-{{ section.id }}-{{ forloop.index }}-min">Min</label>
                          </div>

                          <span class="price-range__separator" aria-hidden="true">–</span>

                          <div class="field price-range__field">
                            <input
                              type="number"
                              class="field__input text-sm"
                              id="Filter-Price-{{ section.id }}-{{ forloop.index }}-max"
                              name="{{ filter.max_value.param_name }}"
                              placeholder="Max"
                              value="{{ filter.max_value.value }}"
                              min="0"
                              inputmode="numeric"
                            >
                            <label class="field__label" for="Filter-Price-{{ section.id }}-{{ forloop.index }}-max">Max</label>
                          </div>
                        </div>

                    {% endcase %}

                  </div>

                </details>

              </div>
            {% endfor %}

          </form>
      {% endcapture %}

      {% capture collection_filters %}
        {% if section.settings.filter_position == 'sidebar' %}
          <div class="cms-filter-sidebar">
            {{ collection_filters_form }}
          </div>
        {% else %}
          {{ collection_filters_form }}
        {% endif %}
      {% endcapture %}
    <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %}">
      <div class="template-search__header page-width">
        <div class="flex items-center flex-col justify-center">
          <h1 class="h2 text-center">
             {{- 'search.title' | t -}}
          </h1> 
          <div class="template-search__search">
            {%- if settings.predictive_search_enabled -%}
              <predictive-search data-loading-text="{{ 'search.loading' | t }}">
            {%- else -%}
              <main-search>
            {%- endif -%}
              <form action="{{ routes.search_url }}" method="get" role="search" class="search">
                <div class="field with-icon-right">
                  <input
                    class="search__input field__input"
                    id="Search-In-Template"
                    type="search"
                    name="q"
                    value="{{ search.terms | escape }}"
                    placeholder=" "
                    {%- if settings.predictive_search_enabled %}
                      role="combobox"
                      aria-expanded="false"
                      aria-owns="predictive-search-results"
                      aria-controls="predictive-search-results"
                      aria-haspopup="listbox"
                      aria-autocomplete="list"
                      autocorrect="off"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                    {%- endif %}
                  >
                  <label class="field__label" for="Search-In-Template">{{ 'search.placeholder' | t }}</label>
                  <input name="options[prefix]" type="hidden" value="last">

                  <button
                    type="reset"
                    class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                    aria-label="{{ 'search.reset' | t }}"
                  >
                    <span class="svg-wrapper">
                      {% render 'icon', icon: 'close', width: 18, height: 18 %}
                    </span>
                  </button>
                  <button type="submit" class="search__button field__button" aria-label="{{ 'search.title' | t }}">
                    <span class="svg-wrapper">
                      {% render 'icon', icon: 'search', width: 20, height: 20 %}
                    </span>
                  </button>
                </div>

                {%- if settings.predictive_search_enabled -%}
                  <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                    <div class="predictive-search__loading-state">
                      {%- render 'loading-spinner' -%}
                    </div>
                  </div>
                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                {%- endif -%}
              </form>
            {%- if settings.predictive_search_enabled -%}
              </predictive-search>
            {%- else -%}
              </main-search>
            {%- endif -%}
          </div>
        </div>
        {%- if search.performed -%}
        
          {%- if search.results_count == 0 and search.filters == empty -%}
            <p role="status">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          {%- endif -%}
        {%- endif -%}
      
        {%- if search.performed -%}
          <div>
            <div class="product-grid-container" id="ProductGridContainer">
              {%- if search.results.size == 0 and search.filters != empty -%}
                <div class="template-search__results">
                  <div class="loading-overlay gradient"></div>
                  <div class="title-wrapper center">
                    <h2 class="title title--primary">
                      {{ 'search.no_results_html' | t -}}
                    </h2>
                  </div>
                </div>
              {%- else -%}
              <main-collection-section class="cms-main-collection" data-section-id="{{ section.id }}">
                <div class="">
                  <div id="CollectionAjaxContainer" data-collection-ajax>
                  {%- liquid
                    assign filter_clear_url = routes.search_url | append: '?q=' | append: terms | append: '&options[prefix]=last'
                    if search.sort_by != blank
                      assign filter_clear_url = filter_clear_url | append: '&sort_by=' | append: search.sort_by
                    endif
                  -%}
                  {% render 'collection-filter-sort-row',
                    show_filter: section.settings.show_filter,
                    filter_position: section.settings.filter_position,
                    filters: search.filters,
                    clear_url: filter_clear_url,
                    filters_markup: collection_filters_form,
                    products_count: search.results_count,
                    sort_options: search.sort_options,
                    sort_by: search.sort_by,
                    default_sort_by: search.default_sort_by,
                    show_total_product: section.settings.show_total_product,
                    show_sort: section.settings.show_sort,
                    show_layout: section.settings.show_layout,
                    sort_form_action: routes.search_url,
                    search_terms: search.terms
                  %}

                  <div class="template-search__results collection{% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %} cms-main-collection-grid cms-main-collection-grid--sidebar{% endif %}" id="product-grid" data-id="{{ section.id }}" >
                    {% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %}
                      {{ collection_filters }}
                      <div class="collection-products">
                        <div class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col">
                          {%- for item in search.results -%}
                            <div class="grid__item" >
                              {%- case item.object_type -%}
                                {%- when 'product' -%}
                                  {% render 'product-card',
                                    product: item,
                                    show_vendor: settings.show_vendor,
                                    show_secondary_image: settings.show_secondary_image,
                                    show_quick_buy: settings.show_quick_buy,
                                    show_rating: settings.show_rating,
                                    rating_display: settings.rating_display,
                                    show_sold_out_badge: settings.show_sold_out_badge,
                                    show_discount_badge: settings.show_discount_badge,
                                    discount_type: settings.discount_type,
                                    color_display_mode: settings.color_display_mode,
                                    image_ratio: settings.image_ratio,
                                    content_alignment: settings.content_alignment,
                                    style: settings.style
                                  %}
                                {%- when 'article' -%}
                                    {%- render 'article-card',
                                        article: item,
                                        media_height: section.settings.image_ratio,
                                        show_image: section.settings.show_image,
                                        show_date: section.settings.show_date,
                                        show_author: section.settings.show_author,
                                        show_excerpt: section.settings.show_excerpt,
                                        read_more_label: section.settings.read_more_label,
                                        settings: settings
                                      -%}
                                {%- when 'page' -%}
                                  <div class="article-card-wrapper card-wrapper underline-links-hover">
                                    <div class="card">
                                      <div class="card__content">
                                        <div class="card__information">
                                          <h3 class="card__heading">
                                            <a href="{{ item.url }}" class="full-unstyled-link">
                                              {{ item.title | truncate: 50 | escape }}
                                            </a>
                                          </h3>
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                              {%- endcase -%}
                            </div>
                          {%- endfor -%}
                        </div>
                        {%- if paginate.pages > 1 -%}
                          {% render 'pagination', paginate: paginate %}
                        {%- endif -%}
                      </div>
                    {% else %}
                      <div class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col">
                        {%- for item in search.results -%}
                          <div class="grid__item" >
                            {%- case item.object_type -%}
                              {%- when 'product' -%}
                                {% render 'product-card',
                                  product: item,
                                  show_vendor: settings.show_vendor,
                                  show_secondary_image: settings.show_secondary_image,
                                  show_quick_buy: settings.show_quick_buy,
                                  show_rating: settings.show_rating,
                                  rating_display: settings.rating_display,
                                  show_sold_out_badge: settings.show_sold_out_badge,
                                  show_discount_badge: settings.show_discount_badge,
                                  discount_type: settings.discount_type,
                                  color_display_mode: settings.color_display_mode,
                                  image_ratio: settings.image_ratio,
                                  content_alignment: settings.content_alignment,
                                  style: settings.style
                                %}
                              {%- when 'article' -%}
                                  {%- render 'article-card',
                                      article: item,
                                      media_height: section.settings.image_ratio,
                                      show_image: section.settings.show_image,
                                      show_date: section.settings.show_date,
                                      show_author: section.settings.show_author,
                                      show_excerpt: section.settings.show_excerpt,
                                      read_more_label: section.settings.read_more_label,
                                      settings: settings
                                    -%}
                              {%- when 'page' -%}
                                <div class="article-card-wrapper card-wrapper underline-links-hover">
                                  <div class="card">
                                    <div class="card__content">
                                      <div class="card__information">
                                        <h3 class="card__heading">
                                          <a href="{{ item.url }}" class="full-unstyled-link">
                                            {{ item.title | truncate: 50 | escape }}
                                          </a>
                                        </h3>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                            {%- endcase -%}
                          </div>
                        {%- endfor -%}
                      </div>
                      {%- if paginate.pages > 1 -%}
                        {% render 'pagination', paginate: paginate %}
                      {%- endif -%}
                    {% endif %}
                  </div>
                  </div>
                </div>
              </main-collection-section>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {% endpaginate %}
</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "section search-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "range",
      "id": "card_per_page",
      "min": 8,
      "max": 40,
      "step": 1,
      "label": "Card Per Page",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Card Per Page",
      "default": 3
    },
    {
      "type": "header",
      "content": "Article Image Settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "default": "adapt",
      "visible_if": "{{ section.settings.show_image == true }}",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "zoom_effect",
      "label": "Enable Image Zoom",
      "default": true,
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "header",
      "content": "Article Content Settings"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read More Label",
      "default": "Read More"
    },
      {
      "type": "header",
      "content": "Filter & sort"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.show_filter == true }}"
    },
     {
      "type": "checkbox",
      "id": "show_total_product",
      "label": "Show Total Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout",
      "label": "Show Layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ]
}
{% endschema %}

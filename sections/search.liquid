{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{{ 'blog-template.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  if sort_by == blank
    assign sort_by = 'relevance'
  endif
  assign terms = search.terms | escape
  assign search_type = 'product,collection,page'
  assign search_url = '?q=' | append: terms | append: '&type=' | append: search_type | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

<div {%- render 'section-variables', section: section, class: 'search__section' -%}>
  {% paginate search.results by section.settings.card_per_page %}
      {% capture collection_filters_form %}
          <form action="{{ routes.search_url }}{{ search_url }}" method="get" data-collection-filter>

            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="type" value="{{ search_type }}">

            {% for filter in search.filters %}
              <div class="cms-filter-group">

                <!-- CLOSED BY DEFAULT -->
                <details class="cms-filter-accordion">

                  <summary class="cms-filter-accordion-title">
                    <span class="cms-filter-label">{{ filter.label }}</span>
                    <span class="cms-filter-icon">
                      {% render 'icon', icon: 'chevron-bottom', width: 18, height: 18 %}
                    </span>
                  </summary>

                  <div class="cms-filter-accordion-content">

                    {% case filter.type %}

                      {% when 'list', 'boolean' %}
                        {% for value in filter.values %}
                          <label class="cms-filter-option">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                            >
                            <span>
                              {{ value.label }} <strong>({{ value.count }})</strong>
                            </span>
                          </label>
                        {% endfor %}

                      {% when 'price_range' %}
                        {%- liquid
                          assign price_range_min = filter.range_min | divided_by: 100.0
                          assign price_range_max = filter.range_max | divided_by: 100.0
                          assign price_step = 1
                          assign price_round = 0
                          if price_range_max < 100
                            assign price_step = 0.01
                            assign price_round = 2
                          endif

                          assign price_current_min = price_range_min
                          if filter.min_value.value != blank
                            assign price_current_min = filter.min_value.value | divided_by: 100.0
                          endif

                          assign price_current_max = price_range_max
                          if filter.max_value.value != blank
                            assign price_current_max = filter.max_value.value | divided_by: 100.0
                          endif

                          assign price_input_min = ''
                          if filter.min_value.value != blank
                            assign price_input_min = filter.min_value.value | divided_by: 100.0 | round: price_round
                          endif

                          assign price_input_max = ''
                          if filter.max_value.value != blank
                            assign price_input_max = filter.max_value.value | divided_by: 100.0 | round: price_round
                          endif
                        -%}

                        <price-range-filter
                          class="price-range-filter"
                          data-range-min="{{ price_range_min }}"
                          data-range-max="{{ price_range_max }}"
                          data-price-step="{{ price_step }}"
                        >
                          <div class="price-range-filter__slider" data-price-slider>
                            <div class="price-range-filter__track">
                              <div class="price-range-filter__progress" data-price-progress></div>
                            </div>
                            <input
                              type="range"
                              class="price-range-filter__range price-range-filter__range--min"
                              data-price-range-min
                              min="{{ price_range_min }}"
                              max="{{ price_range_max }}"
                              value="{{ price_current_min }}"
                              step="{{ price_step }}"
                              aria-label="{{ filter.label }} minimum"
                            >
                            <input
                              type="range"
                              class="price-range-filter__range price-range-filter__range--max"
                              data-price-range-max
                              min="{{ price_range_min }}"
                              max="{{ price_range_max }}"
                              value="{{ price_current_max }}"
                              step="{{ price_step }}"
                              aria-label="{{ filter.label }} maximum"
                            >
                          </div>

                          <div class="price-range">
                            <div class="field price-range__field">
                              <span class="price-range__currency">{{ cart.currency.symbol }}</span>
                              <input
                                type="number"
                                class="field__input text-sm"
                                id="Filter-Price-{{ section.id }}-{{ forloop.index }}-min"
                                name="{{ filter.min_value.param_name }}"
                                placeholder="{{ price_range_min | round: price_round }}"
                                value="{{ price_input_min }}"
                                min="{{ price_range_min }}"
                                max="{{ price_range_max }}"
                                step="{{ price_step }}"
                                inputmode="decimal"
                                data-price-input-min
                              >
                            </div>

                            <span class="price-range__separator" aria-hidden="true">–</span>

                            <div class="field price-range__field">
                              <span class="price-range__currency">{{ cart.currency.symbol }}</span>
                              <input
                                type="number"
                                class="field__input text-sm"
                                id="Filter-Price-{{ section.id }}-{{ forloop.index }}-max"
                                name="{{ filter.max_value.param_name }}"
                                placeholder="{{ price_range_max | round: price_round }}"
                                value="{{ price_input_max }}"
                                min="{{ price_range_min }}"
                                max="{{ price_range_max }}"
                                step="{{ price_step }}"
                                inputmode="decimal"
                                data-price-input-max
                              >
                            </div>
                          </div>
                        </price-range-filter>

                    {% endcase %}

                  </div>

                </details>

              </div>
            {% endfor %}

          </form>
      {% endcapture %}

      {% capture collection_filters %}
        {% if section.settings.filter_position == 'sidebar' %}
          <div class="cms-filter-sidebar">
            {{ collection_filters_form }}
          </div>
        {% else %}
          {{ collection_filters_form }}
        {% endif %}
      {% endcapture %}
    {%- liquid
      assign use_search_fallback = false
      if search.performed and search.results_count == 0 and search.filters == empty and search.terms != blank and settings.predictive_search_enabled
        assign use_search_fallback = true
      endif

      assign has_search_layout = false
      if use_search_fallback
        assign has_search_layout = true
      elsif search.performed and search.results_count > 0
        assign has_search_layout = true
      elsif search.performed and search.filters != empty
        assign has_search_layout = true
      endif
    -%}
    <div class="template-search{% unless has_search_layout %} template-search--empty{% endunless %}">
      <div class="template-search__header page-width">
        <div class="flex items-center flex-col justify-center">
          <h1 class="h2 text-center">
             {{- 'search.title' | t -}}
          </h1> 
          <div class="template-search__search">
            {%- if settings.predictive_search_enabled -%}
              <predictive-search data-loading-text="{{ 'search.loading' | t }}">
            {%- else -%}
              <main-search>
            {%- endif -%}
              <form action="{{ routes.search_url }}" method="get" role="search" class="search">
                <div class="field with-icon-right">
                  <label class="visually-hidden" for="Search-In-Template">{{ 'search.placeholder' | t }}</label>
                  <input
                    class="search__input field__input"
                    id="Search-In-Template"
                    type="search"
                    name="q"
                    value="{{ search.terms | escape }}"
                    placeholder="{{ 'search.placeholder' | t }}"
                    {%- if settings.predictive_search_enabled %}
                      role="combobox"
                      aria-expanded="false"
                      aria-owns="predictive-search-results"
                      aria-controls="predictive-search-results"
                      aria-haspopup="listbox"
                      aria-autocomplete="list"
                      autocorrect="off"
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                    {%- endif %}
                  >
                  <input name="options[prefix]" type="hidden" value="last">
                  <input name="type" type="hidden" value="{{ search_type }}">

                  <button
                    type="reset"
                    class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                    aria-label="{{ 'search.reset' | t }}"
                  >
                    {% render 'icon', icon: 'close', width: 18, height: 18 %}
                  </button>
                  <button type="submit" class="search__button field__button" aria-label="{{ 'search.title' | t }}">
                    {% render 'icon', icon: 'search', width: 18, height: 18 %}
                  </button>
                </div>

                {%- if settings.predictive_search_enabled -%}
                  <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                    <div class="predictive-search__loading-state">
                      {%- render 'loading-spinner' -%}
                    </div>
                  </div>
                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                {%- endif -%}
              </form>
            {%- if settings.predictive_search_enabled -%}
              </predictive-search>
            {%- else -%}
              </main-search>
            {%- endif -%}
          </div>
        </div>
        {%- if search.performed -%}
          {%- if search.results_count == 0 and search.filters == empty and use_search_fallback == false -%}
            <p role="status">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          {%- elsif has_search_layout -%}
          <div>
            <div class="product-grid-container" id="ProductGridContainer">
              {%- if search.results.size == 0 and search.filters != empty and use_search_fallback == false -%}
                <div class="template-search__results">
                  <div class="loading-overlay gradient"></div>
                  <div class="title-wrapper center">
                    <h2 class="title title--primary">
                      {{ 'search.no_results_html' | t -}}
                    </h2>
                  </div>
                </div>
              {%- else -%}
              <main-collection-section
                class="cms-main-collection"
                data-section-id="{{ section.id }}"
                data-search-page
                {% if use_search_fallback %}
                  data-search-fallback
                  data-search-terms="{{ search.terms | escape }}"
                  data-predictive-url="{{ routes.predictive_search_url }}"
                  data-search-type="{{ search_type }}"
                {% endif %}
              >
                <div class="">
                  <div id="CollectionAjaxContainer" data-collection-ajax>
                  {%- liquid
                    assign filter_clear_url = routes.search_url | append: '?q=' | append: terms | append: '&type=' | append: search_type | append: '&options[prefix]=last'
                    if sort_by != blank
                      assign filter_clear_url = filter_clear_url | append: '&sort_by=' | append: sort_by
                    endif
                  -%}
                  {% render 'collection-filter-sort-row',
                    show_filter: section.settings.show_filter,
                    filter_position: section.settings.filter_position,
                    filters: search.filters,
                    clear_url: filter_clear_url,
                    filters_markup: collection_filters_form,
                    products_count: search.results_count,
                    sort_options: search.sort_options,
                    sort_by: sort_by,
                    default_sort_by: search.default_sort_by,
                    show_total_product: section.settings.show_total_product,
                    show_sort: section.settings.show_sort,
                    show_layout: section.settings.show_layout,
                    sort_form_action: routes.search_url,
                    search_terms: search.terms
                  %}

                  <div class="template-search__results collection{% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %} cms-main-collection-grid cms-main-collection-grid--sidebar{% endif %}" id="product-grid" data-id="{{ section.id }}" >
                    {% if section.settings.show_filter and section.settings.filter_position == 'sidebar' %}
                      {{ collection_filters }}
                    {% endif %}
                      <div class="collection-products">
                        <div
                          class="grid grid--2-col md:grid--{{ section.settings.card_per_row }}-col"
                          data-search-results-grid
                        >
                          {%- if use_search_fallback -%}
                            <p
                              class="grid__item"
                              role="status"
                              data-search-fallback-empty
                              data-no-results-text="{{ 'search.no_results_html' | t: terms: search.terms | escape }}"
                              style="grid-column: 1 / -1;"
                            >
                              {{ 'search.loading' | t }}
                            </p>
                          {%- else -%}
                            {%- for item in search.results -%}
                              {%- if item.object_type == 'product' or item.object_type == 'collection' or item.object_type == 'page' -%}
                                {%- liquid
                                  assign sort_title = item.title | downcase
                                  assign sort_price = 0
                                  assign sort_created = 0
                                  if item.object_type == 'product'
                                    assign sort_price = item.price_min | default: item.price | default: 0
                                    assign sort_created = item.created_at | date: '%s'
                                  elsif item.object_type == 'page'
                                    assign sort_created = item.published_at | default: item.created_at | date: '%s'
                                  endif
                                -%}
                                <div
                                  class="grid__item"
                                  data-sort-title="{{ sort_title | escape }}"
                                  data-sort-price="{{ sort_price }}"
                                  data-sort-created="{{ sort_created }}"
                                >
                                  {% render 'search-result-item',
                                    item: item,
                                    image_ratio: section.settings.image_ratio,
                                    settings: settings
                                  %}
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        </div>
                        {%- if use_search_fallback == false and paginate.pages > 1 -%}
                          {% render 'pagination', paginate: paginate %}
                        {%- endif -%}
                      </div>
                  </div>
                  </div>
                </div>
              </main-collection-section>
              {%- if use_search_fallback -%}
                <script src="{{ 'search-fallback.js' | asset_url }}" defer="defer"></script>
              {%- endif -%}
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {% endpaginate %}
</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "class": "section search-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "range",
      "id": "card_per_page",
      "min": 8,
      "max": 40,
      "step": 1,
      "label": "Card Per Page",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Card Per Page",
      "default": 3
    },
    {
      "type": "header",
      "content": "Article Image Settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "default": "adapt",
      "visible_if": "{{ section.settings.show_image == true }}",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "zoom_effect",
      "label": "Enable Image Zoom",
      "default": true,
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "header",
      "content": "Article Content Settings"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read More Label",
      "default": "Read More"
    },
      {
      "type": "header",
      "content": "Filter & sort"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "Filter Position",
      "options": [
        {
          "value": "drawer",
          "label": "Drawer"
        },
        {
          "value": "sidebar",
          "label": "Sidebar"
        }
      ],
      "default": "sidebar",
      "visible_if": "{{ section.settings.show_filter == true }}"
    },
     {
      "type": "checkbox",
      "id": "show_total_product",
      "label": "Show Total Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_layout",
      "label": "Show Layout",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ]
}
{% endschema %}

{{ 'table-comparison.css' | asset_url | stylesheet_tag }}

{%- if section.settings.container_width == 'custom' and section.settings.custom_container_width > 0 -%}
  <style>
    #shopify-section-{{ section.id }} .page-width--custom {
      max-width: {{ section.settings.custom_container_width }}px;
    }
  </style>
{%- endif -%}

<div {%- render 'section-variables', section: section, class: 'rich-text__section' -%}>
  <div class="page-width page-width--{{ section.settings.container_width }}">
    <div class="cms-comparison-table__inner">
      <div class="flex flex-col items-{{ section.settings.text_alignment }} text-{{ section.settings.text_alignment }} gap-{{ section.settings.gap }}">
        <span class="section-header__subheading subheading">{{ section.settings.subheading }}</span>
        <{{ section.settings.heading_tag }} class="section-header__heading {{section.settings.heading_tag}}">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
        <div class="cms-comparison-table__description ps-rte">{{ section.settings.description }}</div>
          {%- render 'button',
            text: section.settings.link_label,
            href: section.settings.link,
            style: section.settings.button_style,
            background_color: section.settings.button_background_color,
            text_color: section.settings.button_text_color,
            outline_color: section.settings.button_outline_color
          -%}
      </div>
    </div>
  </div>
  <div class="page-width cms-comparison-table__table-container">
    <div class="cms-comparison-table__table-wrapper">
      <table class="cms-comparison-table__table">
        <thead class="cms-comparison-table__head">
          <tr>
            <th class="cms-comparison-table__cell cms-comparison-table__cell--images"></th>
            {% for i in (1..3) %}
              {% assign image_key = 'table_image_' | append: i %}
              {% assign image = section.settings[image_key] %}

              <th class="cms-comparison-table__cell cms-comparison-table__cell--images">
                <span class="table-thumb aspect-square">
                  {% if image != blank %}
                    {{
                      image
                      | image_url: width: 500
                      | image_tag:
                        alt: 'logo',
                        loading: 'lazy'
                    }}
                  {% endif %}
                </span>
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="cms-comparison-table__row">
              <th class="cms-comparison-table__cell cms-comparison-table__cell--heading">
                {{ block.settings.heading }}
              </th>
              
              {% for i in (1..3) %}
                {% assign compare_key = 'compare_options-' | append: i %}
                {% assign icon_key = 'icon-' | append: i %}
                {% assign cell_key = 'cell-' | append: i %}

                <td class="cms-comparison-table__cell">
                  
                  {% if block.settings[compare_key] == 'compare-icons' %}
                    
                    {% if block.settings[icon_key] %}
                      <span class="icon icon--check">
                        {% render 'icon', icon: 'check-mark', width: 22, height: 22 %}
                      </span>
                    {% else %}
                      <span class="icon icon--close">
                        {% render 'icon', icon: 'close', width: 22, height: 22 %}
                      </span>
                    {% endif %}

                  {% else %}                  
                    {{ block.settings[cell_key] }}
                  {% endif %}
                  
                </td>
              {% endfor %}
            </tr>
          {%- endfor -%}
        </tbody>

      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison Table",
  "class": "section cms-comparison-table",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "small", "label": "Small" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "custom_container_width",
      "min": 400,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Custom max-width",
      "default": 800,
      "visible_if": "{{ section.settings.container_width == 'custom' }}"
    },
    {
        "type": "header",
        "content": "Table Images"
    },
    {
      "type": "image_picker",
      "id": "table_image_1",
      "label": "First column image"
    },
    {
      "type": "image_picker",
      "id": "table_image_2",
      "label": "Second column image"
    },
    {
      "type": "image_picker",
      "id": "table_image_3",
      "label": "Third column image"
    },
    {
        "type": "header",
        "content": "Content Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" },
        { "value": "48", "label": "2× large" }
      ],
      "default": "24"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub heading",
      "default": "Compare Plans"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the Perfect Option for Your Needs"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore features, pricing, and benefits side by side to choose the solution that best fits your workflow and business goals.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "View Full Comparison"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_outline_color",
      "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "list",
      "name": "Table Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Feature Title",
          "default": "Feature Title"
        },
        {
          "type": "header",
          "content": "First Compared Cell"
        },
        {
          "type": "select",
          "id": "compare_options-1",
          "label": "Compare Options",
          "options": [
            { "value": "compare-icons", "label": "Compare Icons" },
            { "value": "compare-text", "label": "Compare Text" }
          ],
          "default": "compare-icons"
        },
        {
          "type": "text",
          "id": "cell-1",
          "visible_if": "{{ block.settings.compare_options-1 == 'compare-text' }}",
          "label": "First Compared Option",
          "default": "First Compared Option"
        },
        {
          "type": "checkbox",
          "id": "icon-1",
          "visible_if": "{{ block.settings.compare_options-1 == 'compare-icons' }}",
          "label": "First Compared Option",
          "default": true
        },
        {
          "type": "header",
          "content": "Second Compared Cell"
        },
        {
          "type": "select",
          "id": "compare_options-2",
          "label": "Compare Options",
          "options": [
            { "value": "compare-icons", "label": "Compare Icons" },
            { "value": "compare-text", "label": "Compare Text" }
          ],
          "default": "compare-icons"
        },
        {
          "type": "text",
          "id": "cell-2",
          "visible_if": "{{ block.settings.compare_options-2 == 'compare-text' }}",
          "label": "Second Compared Option",
          "default": "Second Compared Option"
        },
        {
          "type": "checkbox",
          "id": "icon-2",
          "visible_if": "{{ block.settings.compare_options-2 == 'compare-icons' }}",
          "label": "Second Compared Option",
          "default": false
        },
        {
          "type": "header",
          "content": "Third Compared Cell"
        },
        {
          "type": "select",
          "id": "compare_options-3",
          "label": "Compare Options",
          "options": [
            { "value": "compare-icons", "label": "Compare Icons" },
            { "value": "compare-text", "label": "Compare Text" }
          ],
          "default": "compare-icons"
        },
        {
          "type": "text",
          "id": "cell-3",
          "visible_if": "{{ block.settings.compare_options-3 == 'compare-text' }}",
          "label": "Third Compared Option",
          "default": "Third Compared Option"
        },
        {
          "type": "checkbox",
          "id": "icon-3",
          "visible_if": "{{ block.settings.compare_options-3 == 'compare-icons' }}",
          "label": "Third Compared Option",
          "default": true
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "list"
        },
        {
          "type": "list"
        },
        {
          "type": "list"
        },
        {
          "type": "list"
        },
        {
          "type": "list"
        },
        {
          "type": "list"
        },
      ]
    }
  ]
}
{% endschema %}
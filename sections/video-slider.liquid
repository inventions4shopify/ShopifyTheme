{{ 'video-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  # ── Alignment class ───────────────────────────────────────────────────────
  assign align_value = s.content_alignment | default: 'center'
  assign align_class = 'text-' | append: align_value

  # ── Gap class ─────────────────────────────────────────────────────────────
  assign gap_value = s.gap | default: '24'
  assign gap_class = ''
  if gap_value != 'default'
    assign gap_class = 'gap-' | append: gap_value
  endif
-%}

{%- if s.container_width == 'custom' and s.custom_container_width > 0 -%}
  <style>
    #shopify-section-{{ section.id }} .rich-text__container--custom {
      max-width: {{ s.custom_container_width }}px;
    }
  </style>
{%- endif -%}

<div {%- render 'section-variables', section: section, class: 'video-slider__section' -%}>
  <div class="{{ s.container_width }}">
    <div class="rich-text__body flex flex-col {{ align_class }} {{ gap_class }}">
      
        {%- assign sub_align = section.settings.subheading_alignment | default: 'inherit' -%}
        {%- assign sub_color = section.settings.subheading_color -%}

        {%- if section.settings.subheading != blank -%}
            <p
            class="section-header__subheading subheading{% if sub_align != 'inherit' %} text-{{ sub_align }}{% endif %}"
            {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                style="color: rgb({{ sub_color.rgb }});"
            {%- endunless %}
            {{ section.shopify_attributes }}
            >
            {{- section.settings.subheading | escape -}}
            </p>
        {%- endif -%}

        {%- assign tag = section.settings.heading_tag | default: 'h2' -%}
        {%- assign size = section.settings.heading_size | default: 'h2' -%}
        {%- assign head_align = section.settings.heading_alignment | default: 'inherit' -%}
        {%- assign head_color = section.settings.heading_color -%}
        {%- assign head_grad = section.settings.heading_gradient -%}

        {%- capture heading_style -%}
            {%- if head_grad != blank -%}
            background: {{ head_grad }};
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
            --color-heading: {{ head_color.rgb }};
            {%- endif -%}
        {%- endcapture -%}

        {%- if section.settings.heading != blank -%}
            <{{ tag }}
            class="section-header__heading {{ size }}{% if head_align != 'inherit' %} text-{{ head_align }}{% endif %}"
            {%- unless heading_style == blank %}
                style="{{ heading_style | strip }}"
            {%- endunless %}
            {{ section.shopify_attributes }}
            >
            {{- section.settings.heading | escape -}}
            </{{ tag }}>
        {%- endif -%}

        {%- assign text_align = section.settings.text_alignment | default: 'inherit' -%}
        {%- assign text_width = section.settings.text_width | default: '' -%}
        {%- assign section_color = section.settings.text_color -%}

        <div
            class="rich-text__text ps-rte{% if text_align != 'inherit' %} text-{{ text_align }}{% endif %}"
            data-block-id="{{ section.id }}"
            {%- if text_width != blank or section_color != blank and section_color != 'rgba(0,0,0,0)' %}
            style="
                {%- if text_width != blank -%}max-width: {{ text_width }};{%- endif -%}
                {%- unless section_color == blank or section_color == 'rgba(0,0,0,0)' -%}color: rgb({{ section_color.rgb }});{%- endunless -%}
            "
            {%- endif %}
            {{ section.shopify_attributes }}
        >
            {{- section.settings.text -}}
        </div>

        
        {%- assign btn_align = section.settings.button_alignment | default: 'inherit' -%}
        {%- if section.settings.link_label != blank -%}
            <div
            class="rich-text__button-wrapper{% if btn_align != 'inherit' %} text-{{ btn_align }}{% endif %}"
            {{ section.shopify_attributes }}
            >
            {%- render 'button',
                text: section.settings.link_label,
                href: section.settings.link,
                style: section.settings.button_style,
                background_color: section.settings.button_background_color,
                text_color: section.settings.button_text_color,
                outline_color: section.settings.button_outline_color
            -%}
            </div>
        {%- endif -%}
    </div>

    <div class="video-slider__content">
        <div class="video-slider__slider js-video-slider">
            {%- for block in section.blocks -%}
                <div class="video-slider__slide">
                    <div class="video-slider__media image_media--{{ section.settings.desktop_height }}">
						{% if block.settings.source == 'uploaded' %}
						<video
							class="video-slider__element"
							playsinline
							{% if section.settings.autoplay %}
							autoplay
							{% endif %}
							{% if section.settings.loop %}
							loop
							{% endif %}
							{% if section.settings.muted %}
							muted
							{% endif %}
						>
							{% if block.settings.mobile_video != blank %}
							<source
								media="(max-width: 767px)"
								src="{{ block.settings.mobile_video.sources[1].url }}"
								type="video/mp4"
							>
							{% endif %}

							{% if block.settings.video != blank %}
							<source
								src="{{ block.settings.video.sources[1].url }}"
								type="video/mp4"
							>
							{% endif %}
						</video>

						<button
							class="video-slider__play-btn{% if section.settings.autoplay %} hidden{% endif %}"
							aria-label="Play video"
						>
							{% render 'icon', icon: 'play-button', width: 24, height: 24 %}
						</button>

						{% elsif block.settings.source == 'external_url' and block.settings.video_url != blank %}
							{% liquid
								assign autoplay = 0
								assign muted = 0
								assign loop = 0

								if section.settings.autoplay
								assign autoplay = 1
								endif

								if section.settings.muted
								assign muted = 1
								endif

								if section.settings.loop
								assign loop = 1
								endif
							%}

							{% if block.settings.video_url.type == 'youtube' %}
								<iframe
								src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={{ autoplay }}&mute={{ muted }}&loop={{ loop }}&playlist={{ block.settings.video_url.id }}"
								allow="autoplay; encrypted-media"
								allowfullscreen
								loading="lazy"
								></iframe>

							{% else %}
								<iframe
								src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={{ autoplay }}&muted={{ muted }}&loop={{ loop }}"
								allow="autoplay; encrypted-media"
								allowfullscreen
								loading="lazy"
								></iframe>
							{% endif %}
						{% endif %}
					</div>
                </div>
            {%- endfor -%}
        </div>
		<div class="video-slider__controls">
			<button class="button button--secondary video-slider__control--prev" aria-label="Previous slide">
				{% render 'icon', icon: 'chevron-left', width: 20, height: 20 %}
			</button>
			<button class="button button--secondary video-slider__control--next" aria-label="Next slide">
				{% render 'icon', icon: 'chevron-right', width: 20, height: 20 %}
			</button>
		</div>
    </div>
  </div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const slider = document.querySelector('.js-video-slider');
		if (!slider) return;

		const prevBtn = document.querySelector('.video-slider__control--prev');
		const nextBtn = document.querySelector('.video-slider__control--next');

		let slides = Array.from(slider.children);
		if (slides.length < 2) return;

		const container = slider.parentElement;

		let index = 2; // 3rd active
		let startX = 0;
		let isDragging = false;
		let startTranslate = 0;
		let currentTranslate = 0;

		const slideWidth = slides[0].offsetWidth;

		// --------------------------
		// CLONE SETUP
		// --------------------------
		const firstClone = slides[0].cloneNode(true);
		const lastClone = slides[slides.length - 1].cloneNode(true);

		slider.appendChild(firstClone);
		slider.insertBefore(lastClone, slides[0]);

		slides = Array.from(slider.children);

		index = index + 1;

		// --------------------------
		// POSITION
		// --------------------------
		function getTranslate() {
			const containerCenter = container.offsetWidth / 2;
			const centerOffset = (containerCenter - slideWidth / 2);
			return -index * slideWidth + centerOffset;
		}

		function apply(animate = true) {
			slider.style.transition = animate ? 'transform 0.5s ease' : 'none';
			currentTranslate = getTranslate();
			slider.style.transform = `translate3d(${currentTranslate}px,0,0)`;
		}

		// --------------------------
		// CLASS UPDATE
		// --------------------------
		function updateClasses() {
			slides.forEach(s => {
				s.classList.remove(
					'center-slide',
					'previous-slide',
					'next-slide',
					'prev-outer-slide',
					'next-outer-slide'
				);
			});

			const prev = index - 1;
			const next = index + 1;
			const prev2 = index - 2;
			const next2 = index + 2;

			// center
			if (slides[index]) slides[index].classList.add('center-slide');

			// near
			if (slides[prev]) slides[prev].classList.add('previous-slide');
			if (slides[next]) slides[next].classList.add('next-slide');

			// outer (THIS WAS MISSING / BROKEN)
			if (slides[prev2]) slides[prev2].classList.add('prev-outer-slide');
			if (slides[next2]) slides[next2].classList.add('next-outer-slide');
		}

		function update(animate = true) {
			updateClasses();
			apply(animate);
			updateButtons();
		}

		// --------------------------
		// BUTTON STATE (DISABLED LOGIC)
		// --------------------------
		function updateButtons() {
			const realFirst = 0;
			const realLast = slides.length - 1;

			if (prevBtn) {
				if (index <= realFirst) {
					prevBtn.setAttribute('disabled', 'true');
				} else {
					prevBtn.removeAttribute('disabled');
				}
			}

			if (nextBtn) {
				if (index >= realLast) {
					nextBtn.setAttribute('disabled', 'true');
				} else {
					nextBtn.removeAttribute('disabled');
				}
			}
		}

		// --------------------------
		// NEXT / PREV
		// --------------------------
		function next() {
			const max = slides.length - 1;
			if (index >= max) return;

			index++;
			update(true);
		}

		function prev() {
			if (index <= 0) return;

			index--;
			update(true);
		}

		// --------------------------
		// BUTTON EVENTS
		// --------------------------
		if (nextBtn) {
			nextBtn.addEventListener('click', next);
		}

		if (prevBtn) {
			prevBtn.addEventListener('click', prev);
		}

		// --------------------------
		// DRAG
		// --------------------------
		slider.addEventListener('mousedown', (e) => {
			isDragging = true;
			startX = e.clientX;
			startTranslate = currentTranslate;
			slider.style.transition = 'none';
		});

		slider.addEventListener('mousemove', (e) => {
			if (!isDragging) return;

			const diff = e.clientX - startX;
			slider.style.transform = `translate3d(${startTranslate + diff}px,0,0)`;
		});

		slider.addEventListener('mouseup', (e) => {
			if (!isDragging) return;

			const diff = e.clientX - startX;

			if (Math.abs(diff) > 50) {
				diff > 0 ? prev() : next();
			} else {
				update(true);
			}

			isDragging = false;
		});

		slider.addEventListener('mouseleave', () => {
			isDragging = false;
			update(true);
		});

		// --------------------------
		// TOUCH
		// --------------------------
		slider.addEventListener('touchstart', (e) => {
			startX = e.touches[0].clientX;
		});

		slider.addEventListener('touchend', (e) => {
			const diff = startX - e.changedTouches[0].clientX;

			if (Math.abs(diff) > 50) {
				diff > 0 ? next() : prev();
			}
		});

		// --------------------------
		// INIT
		// --------------------------
		update(false);
	});

	document.addEventListener('DOMContentLoaded', () => {
		const wrappers = document.querySelectorAll('.video-slider__media');

		wrappers.forEach((wrapper) => {
			const video = wrapper.querySelector('.video-slider__element');
			const playBtn = wrapper.querySelector('.video-slider__play-btn');

			if (!video || !playBtn) return;

			// Initial state
			if (video.paused) {
			playBtn.classList.remove('hidden');
			} else {
			playBtn.classList.add('hidden');
			}

			// Play button click
			playBtn.addEventListener('click', (e) => {
			e.preventDefault();
			e.stopPropagation();

			video.play();
			playBtn.classList.add('hidden');
			});

			// Video click = pause video and show play button
			video.addEventListener('click', () => {
			if (!video.paused) {
				video.pause();
				playBtn.classList.remove('hidden');
			}
			});

			// When video starts playing
			video.addEventListener('play', () => {
			playBtn.classList.add('hidden');
			});

			// When video pauses
			video.addEventListener('pause', () => {
			playBtn.classList.remove('hidden');
			});

			// When video ends
			video.addEventListener('ended', () => {
			playBtn.classList.remove('hidden');
			});
		});
	});
</script>

{% schema %}
{
  "name": "Video Slider",
  "tag": "section",
  "class": "section-video-slider",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Block gap",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "8", "label": "Extra small" },
        { "value": "12", "label": "Small" },
        { "value": "16", "label": "Medium" },
        { "value": "24", "label": "Large" },
        { "value": "32", "label": "Extra large" },
        { "value": "48", "label": "2× large" }
      ],
      "default": "24"
    },
	{
      "type": "header",
      "content": "Media settings"
    },
	{
		"type": "select",
		"id": "desktop_height",
		"label": "Video Slide Height",
		"options": [
			{
				"value": "small",
				"label": "Small"
			},
			{
				"value": "medium",
				"label": "Medium"
			},
			{
				"value": "large",
				"label": "Large"
			}
		],
		"default": "medium"
	},
	{
		"type": "checkbox",
		"id": "autoplay",
		"label": "Enable autoplay",
		"default": false
	},
	{
		"type": "checkbox",
		"id": "muted",
		"label": "Mute video",
		"default": true
	},
	{
		"type": "checkbox",
		"id": "loop",
		"label": "Loop video",
		"default": false
	},
    {
      "type": "header",
      "content": "Content"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Watch & Shop Our Latest Collection"
    },
    {
        "type": "select",
        "id": "heading_tag",
        "label": "Heading tag (SEO)",
        "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
        ],
        "default": "h2"
    },
    {
        "type": "select",
        "id": "heading_size",
        "label": "Heading size (visual)",
        "options": [
        { "value": "h1", "label": "H1 — Largest" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6 — Smallest" }
        ],
        "default": "h2"
    },
    {
        "type": "select",
        "id": "heading_alignment",
        "label": "Alignment",
        "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
        ],
        "default": "inherit"
    },
    {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color"
    },
    {
        "type": "color_background",
        "id": "heading_gradient",
        "label": "Heading gradient"
    },
    {
        "type": "text",
        "id": "subheading",
        "label": "Subheading",
        "default": "Innovative solutions designed to help your business grow faster."
    },
    {
        "type": "select",
        "id": "subheading_alignment",
        "label": "Alignment",
        "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
        ],
        "default": "inherit"
    },
    {
        "type": "color",
        "id": "subheading_color",
        "label": "Subheading color"
    },
    {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Discover powerful strategies, cutting-edge technology, and expert support that drive success and create lasting impact.</p>"
    },
    {
        "type": "select",
        "id": "text_alignment",
        "label": "Alignment",
        "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
        ],
        "default": "inherit"
    },
    {
        "type": "select",
        "id": "text_width",
        "label": "Text max-width",
        "options": [
        { "value": "", "label": "Full" },
        { "value": "80rem", "label": "Narrow" },
        { "value": "60rem", "label": "Extra narrow" },
        { "value": "48rem", "label": "Small" }
        ],
        "default": ""
    },
    {
        "type": "color",
        "id": "text_color",
        "label": "Text color"
    },
    {
        "type": "text",
        "id": "link_label",
        "label": "Button label",
        "default": "Get Started"
    },
    {
        "type": "url",
        "id": "link",
        "label": "Button link"
    },
    {
        "type": "select",
        "id": "button_alignment",
        "label": "Alignment",
        "options": [
        { "value": "inherit", "label": "Inherit from section" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
        ],
        "default": "inherit"
    },
    {
        "type": "color",
        "id": "button_background_color",
        "label": "Button background"
    },
    {
        "type": "color",
        "id": "button_text_color",
        "label": "Button text"
    },
    {
        "type": "color",
        "id": "button_outline_color",
        "label": "Button outline"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "label": "Enable custom spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "section_spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_desktop.label",
      "default": 64,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.top_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "section_spacing_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.layout.settings.section_spacing.bottom_mobile.label",
      "default": 40,
      "visible_if": "{{ section.settings.custom_spacing }}"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Video Slide",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Source",
          "options": [
            {
              "value": "uploaded",
              "label": "Uploaded"
            },
            {
              "value": "external_url",
              "label": "External url"
            }
          ]
        },
        {
          "type": "video",
          "id": "video",
          "label": "Desktop Video",
          "visible_if": "{{ block.settings.source == 'uploaded' }}"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile Video",
          "visible_if": "{{ block.settings.source == 'uploaded' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "label": "Video URL",
          "visible_if": "{{ block.settings.source == 'external_url' }}"
        },
        {
          "type": "product",
          "id": "product_url",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider",
      "blocks": [
        { "type": "slide" }
    ]
    }
  ]
}
{% endschema %}

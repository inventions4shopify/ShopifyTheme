{% liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_bg }};
  }
  .custom-video-section {
    height: 50rem;
    min-height: var(--section-height-{{ section.settings.slide_height }});
    padding: 0;
  }
  #shopify-section-{{ section.id }} .custom-video-wrapper {
    position: relative;
    overflow: hidden;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .custom-video-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .custom-video-media video,
  #shopify-section-{{ section.id }} .custom-video-media iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .media-overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ overlay_opacity }};
    border-radius: var(--media-radius);
  }
  #shopify-section-{{ section.id }} .custom-video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    width: 80px;
    height: 80px;
    border: none;
    border-radius: 100%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ section.settings.ply_color }};
  }
  #shopify-section-{{ section.id }} .custom-video-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }
  #shopify-section-{{ section.id }} .custom-video-play-btn svg {
    width: 28px;
    height: 28px;
  }
  #shopify-section-{{ section.id }} .custom-video-play-btn.hidden {
    display: none;
  }
  .custom-video-wrapper .page-width,
  .custom-video-wrapper .full-width {
    height: 100%;
  }
  .custom-video-play-btn svg path{
    fill: currentColor;
  }
  @media screen and (max-width: 749px){
    #shopify-section-{{ section.id }} .custom-video-play-btn {
      width: 40px;
      height: 40px;
    }
    #shopify-section-{{ section.id }} .custom-video-play-btn svg {
      width: 14px;
      height: 14px;
    }
  }
</style>

<div {%- render 'section-variables', section: section, class: 'custom-video-section' -%}>
  <div class="custom-video-wrapper {% if section.settings.section_width == 'full-width' %}full-width{% else %}page-width{% endif %}">
    <div class="custom-video-media">
      {% if section.settings.source == 'uploaded' %}
        <video
          class="custom-video-element"
          playsinline
          {% if section.settings.autoplay %}
            autoplay
          {% endif %}
          {% if section.settings.loop %}
            loop
          {% endif %}
          {% if section.settings.muted or section.settings.autoplay == true %}
            muted
          {% endif %}
        >
          {% if section.settings.mobile_video != blank %}
            <source
              media="(max-width: 767px)"
              src="{{ section.settings.mobile_video.sources[1].url }}"
              type="video/mp4"
            >
          {% endif %}
          {% if section.settings.video != blank %}
            <source
              src="{{ section.settings.video.sources[1].url }}"
              type="video/mp4"
            >
          {% endif %}
        </video>

        <button
          class="custom-video-play-btn {% if section.settings.autoplay %}hidden{% endif %}"
          aria-label="Play video"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            version="1.1"
            width="50"
            height="50"
            x="0"
            y="0"
            viewBox="0 0 163.861 163.861"
            style="enable-background:new 0 0 512 512"
            xml:space="preserve"
          >
            <g><path d="M34.857 3.613C20.084-4.861 8.107 2.081 8.107 19.106v125.637c0 17.042 11.977 23.975 26.75 15.509L144.67 97.275c14.778-8.477 14.778-22.211 0-30.686L34.857 3.613z" fill="#000000" opacity="1" /></g>
          </svg>
        </button>
      {% elsif section.settings.source == 'external_url' and section.settings.video_url != blank %}
        {% liquid
          assign autoplay = 0
          assign muted = 0
          assign loop = 0

          if section.settings.autoplay
            assign autoplay = 1
          endif
          if section.settings.muted
            assign muted = 1
          endif
          if section.settings.loop
            assign loop = 1
          endif
        %}
        {% if section.settings.video_url.type == 'youtube' %}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay={{ autoplay }}&mute={{ muted }}&loop={{ loop }}&playlist={{ section.settings.video_url.id }}&controls=0&rel=0"
            allow="autoplay; encrypted-media"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {% else %}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay={{ autoplay }}&muted={{ muted }}&loop={{ loop }}"
            allow="autoplay; encrypted-media"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {% endif %}
      {% endif %}

      <div class="media-overlay"></div>
    </div>
    {% if section.blocks.size > 0 %}
      <div class="{% if section.settings.content_size == 'full-width' %}full-width{% else %}page-width{% endif %}">
        <div class="media-overlay-content ps-rte media-overlay-content--{{ section.settings.content_alignment }} media-content-width-{{ section.settings.content_width }}">
          {% for block in section.blocks %}
            {%- case block.type -%}
              {%- when 'subheading' -%}
                {%- assign sub_align = block.settings.subheading_alignment | default: 'inherit' -%}
                {%- assign sub_color = block.settings.subheading_color -%}
                {%- if block.settings.subheading != blank -%}
                  <p
                    class="section-header__subheading subheading{% if sub_align != 'inherit' %} text-{{ sub_align }}{% endif %}"
                    {%- unless sub_color == blank or sub_color == 'rgba(0,0,0,0)' %}
                      style="color: rgb({{ sub_color.rgb }});"
                    {%- endunless %}
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.subheading | escape -}}
                  </p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- assign tag = block.settings.heading_tag | default: 'h2' -%}
                {%- assign size = block.settings.heading_size | default: 'h2' -%}
                {%- assign head_align = block.settings.heading_alignment | default: 'inherit' -%}
                {%- assign head_color = block.settings.heading_color -%}
                {%- assign head_grad = block.settings.heading_gradient -%}

                {%- capture heading_style -%}
                {%- if head_grad != blank -%}
                  background: {{ head_grad }};
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;
                {%- elsif head_color != blank and head_color != 'rgba(0,0,0,0)' -%}
                  --color-heading: {{ head_color.rgb }};
                {%- endif -%}
              {%- endcapture -%}

                {%- if block.settings.heading != blank -%}
                  <{{ tag }}
                    class="section-header__heading {{ size }}{% if head_align != 'inherit' %} text-{{ head_align }}{% endif %}"
                    {%- unless heading_style == blank %}
                      style="{{ heading_style | strip }}"
                    {%- endunless %}
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.heading | escape -}}
                  </{{ tag }}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- assign text_align = block.settings.text_alignment | default: 'inherit' -%}
                {%- assign text_width = block.settings.text_width | default: '' -%}
                {%- assign block_color = block.settings.text_color -%}
                <div
                  class="rich-text__text ps-rte{% if text_align != 'inherit' %} text-{{ text_align }}{% endif %}"
                  data-block-id="{{ block.id }}"
                  {%- if text_width != blank or block_color != blank and block_color != 'rgba(0,0,0,0)' %}
                    style="
                      {%- if text_width != blank -%}max-width: {{ text_width }};{%- endif -%}
                      {%- unless block_color == blank or block_color == 'rgba(0,0,0,0)' -%}color: rgb({{ block_color.rgb }});{%- endunless -%}
                    "
                  {%- endif %}
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </div>

              {%- when 'button' -%}
                {%- assign btn_align = block.settings.button_alignment | default: 'inherit' -%}
                {%- if block.settings.link_label != blank -%}
                  <div
                    class="rich-text__button-wrapper{% if btn_align != 'inherit' %} text-{{ btn_align }}{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- render 'button',
                      text: block.settings.link_label,
                      href: block.settings.link,
                      style: block.settings.button_style,
                      background_color: block.settings.button_background_color,
                      text_color: block.settings.button_text_color,
                      outline_color: block.settings.button_outline_color
                    -%}
                  </div>
                {%- endif -%}

              {%- when 'spacer' -%}
                <div
                  class="rich-text__spacer"
                  style="height: {{ block.settings.spacer_height | default: 20 }}px;"
                  aria-hidden="true"
                  {{ block.shopify_attributes }}
                ></div>
            {%- endcase -%}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% if section.settings.autoplay == false %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
      if (!sectionEl) return;

      const video = sectionEl.querySelector('.custom-video-element');
      const playBtn = sectionEl.querySelector('.custom-video-play-btn');
      if (!video || !playBtn) return;

      function syncPlayButton() {
        playBtn.classList.toggle('hidden', !video.paused && !video.ended);
      }

      if (video.autoplay) {
        playBtn.classList.add('hidden');
      } else {
        playBtn.classList.remove('hidden');
      }

      playBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        video.play().catch(function () {});
      });

      video.addEventListener('click', function () {
        if (video.paused || video.ended) {
          video.play().catch(function () {});
        } else {
          video.pause();
        }
      });

      video.addEventListener('play', syncPlayButton);
      video.addEventListener('pause', syncPlayButton);
      video.addEventListener('ended', syncPlayButton);
    });
  </script>
{% endif %}
{% schema %}

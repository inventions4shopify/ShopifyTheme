{{ 'card-product.css' | asset_url | stylesheet_tag }}
{{ 'wishlist.css' | asset_url | stylesheet_tag }}

<wishlist-page class="wishlist-page">
  <div class="page-width">
    <div class="wishlist-page__header text-center">
      <h1 class="page-heading">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'wishlist.title' | t }}
        {%- endif -%}
      </h1>

      {%- if section.settings.description != blank -%}
        <div class="page-description text-sm">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="wishlist-page__empty" data-wishlist-empty hidden>
      <p>{{ 'wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'wishlist.continue_shopping' | t }}
      </a>
    </div>

    <div class="wishlist-page__grid" data-wishlist-grid></div>
  </div>
</wishlist-page>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wishlist"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
}
{% endschema %}

{{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}

{% assign breadcrumb_collection = collection | default: product.collections.first %}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">

    <li class="breadcrumbs__item">
      <a href="{{ routes.root_url }}">Home</a>
    </li>

    {% if template contains 'product' %}

      {% if breadcrumb_collection %}
        <li class="breadcrumbs__separator">
          {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
        </li>

        <li class="breadcrumbs__item">
          <a href="{{ breadcrumb_collection.url }}">
            {{ breadcrumb_collection.title }}
          </a>
        </li>
      {% endif %}

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item breadcrumbs__item--current">
        {{ product.title }}
      </li>

    {% elsif template contains 'collection' %}

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item breadcrumbs__item--current">
        {{ collection.title }}
      </li>

    {% elsif template contains 'page' %}

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item breadcrumbs__item--current">
        {{ page.title }}
      </li>

    {% elsif template contains 'blog' %}

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item breadcrumbs__item--current">
        {{ blog.title }}
      </li>

    {% elsif template contains 'article' %}

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item">
        <a href="{{ blog.url }}">
          {{ blog.title }}
        </a>
      </li>

      <li class="breadcrumbs__separator">
        {% render 'icon', icon: 'chevron-right', width: 14, height: 14 %}
      </li>

      <li class="breadcrumbs__item breadcrumbs__item--current">
        {{ article.title }}
      </li>

    {% endif %}

  </ol>
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    }
  ]
}
</script>
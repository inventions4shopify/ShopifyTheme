{%- liquid
  assign continue_url = settings.button_url_link | default: routes.all_products_collection_url
  assign continue_label = settings.button_text | default: 'Continue shopping'
  assign empty_heading = settings.drawer_heading | default: 'Your cart is empty'
  assign account_label = settings.account_title | default: 'Have an account?'
-%}

<div class="cart-drawer__inner">
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title h5">
      {{ 'cart.title' | t }}
      {% if cart.item_count > 0 %}
        <span class="cart-drawer__count">({{ cart.item_count }})</span>
      {% endif %}
    </h2>

    <button
      type="button"
      class="drawer-close-icon cart-drawer__close"
      data-cart-drawer-close
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon', icon: 'close', width: 20, height: 20 %}
    </button>
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-drawer__empty">
      <div class="cart-drawer__empty-text">
        {{ empty_heading }}
      </div>

      {% unless customer %}
        <p class="drawer-loggin">{{ account_label }}</p>
        <p class="cart-login-textt">
          <a href="{{ routes.account_login_url }}">{{ 'customers.log_in' | t }}</a>
        </p>
      {% endunless %}

      <a href="{{ continue_url }}" class="button cart-drawer__continue">
        {{ continue_label }}
      </a>
    </div>
  {% else %}
    {% if settings.cart_drawer_enable_progress %}
      {% render 'cart-drawer-progress' %}
    {% endif %}

    <div class="cart-drawer__body">
      <div class="cart-drawer__items" data-cart-drawer-items>
        {% for item in cart.items %}
          <div
            class="cart-drawer__item"
            data-cart-item
            data-line="{{ forloop.index }}"
          >
            <a href="{{ item.url }}" class="cart-drawer__item-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | default: item.product.title | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% endif %}
            </a>

            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title">
                {{ item.product.title }}
              </a>

              {% unless item.product.has_only_default_variant %}
                <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
              {% endunless %}

              <div class="cart-drawer__item-price">
                {% if item.original_line_price != item.final_line_price %}
                  <span class="cart-drawer__item-price--sale">{{ item.final_line_price | money }}</span>
                  <span class="cart-drawer__item-price--compare">{{ item.original_line_price | money }}</span>
                {% else %}
                  <span>{{ item.final_line_price | money }}</span>
                {% endif %}
              </div>

              <div class="cart-drawer__item-actions">
                <div class="cart-drawer__quantity">
                  <button
                    type="button"
                    class="cart-drawer__quantity-button"
                    data-quantity-decrease
                    aria-label="Decrease quantity"
                  >
                    {% render 'icon', icon: 'minus', width: 16, height: 16 %}
                  </button>

                  <input
                    type="number"
                    class="cart-drawer__quantity-input"
                    value="{{ item.quantity }}"
                    min="0"
                    data-quantity-input
                    aria-label="Quantity"
                  >

                  <button
                    type="button"
                    class="cart-drawer__quantity-button"
                    data-quantity-increase
                    aria-label="Increase quantity"
                  >
                    {% render 'icon', icon: 'plus', width: 16, height: 16 %}
                  </button>
                </div>

                <button
                  type="button"
                  class="cart-drawer__remove"
                  data-cart-remove
                  aria-label="{{ 'cart.remove' | t }}"
                >
                  {% render 'icon', icon: 'trash', width: 18, height: 18 %}
                </button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if settings.cart_drawer_enable_recommendations %}
        {% render 'cart-drawer-recommendations' %}
      {% endif %}
    </div>

    <div class="cart-drawer__footer">
      <div class="cart-drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}:</span>
        <span class="cart-drawer__subtotal-values">
          {% if cart.original_total_price != cart.total_price %}
            <span class="cart-drawer__subtotal-compare">{{ cart.original_total_price | money }}</span>
          {% endif %}
          <span class="cart-drawer__subtotal-price">{{ cart.total_price | money }}</span>
        </span>
      </div>

      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="button cart-drawer__checkout">
          {% render 'icon', icon: 'security', width: 18, height: 18 %}
          {{ 'cart.checkout' | t }}
        </button>
      </form>

      <a href="{{ continue_url }}" class="cart-drawer__continue-link" data-cart-drawer-close>
        {{ continue_label }}
      </a>
    </div>
  {% endif %}
</div>

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer
  class="drawer{% if cart == empty %} is-empty{% endif %}"
  data-section-id="cart-drawer"
  aria-hidden="true"
>
  <div id="CartDrawer" class="cart-drawer">
    <div class="cart-drawer__overlay" data-cart-drawer-close></div>

    <div
      class="cart-drawer__panel drawer_inner_content"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'cart.title' | t }}"
    >
      <div class="cart-drawer__celebration" data-cart-drawer-celebration aria-hidden="true"></div>
      <div data-cart-drawer-contents>
        {% render 'cart-drawer-content' %}
      </div>
    </div>
  </div>
</cart-drawer>

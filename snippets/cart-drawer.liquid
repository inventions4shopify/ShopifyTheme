{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'cart.js' | asset_url | script_tag }}

{% style %}
  .drawer {
    visibility: hidden;
  }
{% endstyle %}

<cart-drawer class="drawer{% if cart == empty %} cart-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="cart-drawer-overlay" class="cart-overlay"></div>
    <div class="drawer_inner_content">
      {% if cart == empty %}
        <div class="drawer-heading">
          <h3 class="empty-cart-headingp">{{ settings.drawer_heading }}</h3>
          <button class="drawer-close-icon" id="drawer-close-icon">
            {{ 'icon-close.svg' | inline_asset_content }}
          </button>
        </div>
      {% endif %}
    </div>
  </div>

</cart-drawer>
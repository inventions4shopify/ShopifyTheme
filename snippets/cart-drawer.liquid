{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'cart.js' | asset_url | script_tag }}

{% style %}
  .drawer {
    visibility: hidden;
  }
{% endstyle %}

<cart-drawer class="drawer{% if cart == empty %} cart-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="cart-drawer-overlay" class="cart-overlay"></div>
    <div class="drawer_inner_content">
      {% if cart == empty %}
        <div class="drawer-heading">
          <h3 class="empty-cart-headingp">{{ settings.drawer_heading }}</h3>
          <button class="drawer-close-icon" id="drawer-close-icon">
            {% render 'icon', icon: 'close', width: 24, height: 24 %}
          </button>
        </div>
        <div class="collection-btn">
          <a class="button" href="{{ settings.button_url_link | routes.all_products_collection_url }}">{{ settings.button_text }}</a>

          {% if settings.account_title != blank %}
            <p class="drawer-loggin">{{ settings.account_title }}</p>
          {% endif %}

          <p class="cart-login-textt">
            <a href="{{ routes.account_login_url }}">Login</a> to check out faster.
          </p>
        </div>
      {% endif %}
    </div>
  </div>

</cart-drawer>
{%- liquid
  assign continue_url = settings.button_url_link | default: routes.all_products_collection_url
  assign continue_label = settings.button_text | default: 'Continue shopping'
  assign empty_heading = settings.drawer_heading | default: 'Your cart is empty'
  assign account_label = settings.account_title | default: 'Have an account?'
-%}

<div class="cart-page__inner">
  <div class="cart-header">
    <h1>{{ 'cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <p class="cart-header__count">
        {{ cart.item_count }}
        {% if cart.item_count == 1 %}item{% else %}items{% endif %}
      </p>
    {% endif %}
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <div class="cart-empty__icon" aria-hidden="true">
        {% render 'icon', icon: 'cart', width: 48, height: 48 %}
      </div>

      <h2 class="cart-empty__heading">{{ empty_heading }}</h2>

      {% unless customer %}
        <p class="cart-empty__account">{{ account_label }}</p>
        <p class="cart-empty__login">
          <a href="{{ routes.account_login_url }}">{{ 'customers.log_in' | t }}</a>
        </p>
      {% endunless %}

      <a href="{{ continue_url }}" class="button button--primary">
        {{ continue_label }}
      </a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">
      {% if settings.cart_drawer_enable_progress %}
        <div class="cart-page__progress">
          {% render 'cart-drawer-progress' %}
        </div>
      {% endif %}

      <div class="cart-layout">
        <div class="cart-items" data-cart-items>
          {% for item in cart.items %}
            <div
              class="cart-item"
              data-cart-item
              data-line="{{ forloop.index }}"
            >
              <div class="cart-item__image">
                <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {% if item.image %}
                    {{
                      item.image
                      | image_url: width: 300
                      | image_tag: loading: 'lazy', widths: '150,300', alt: item.product.title
                    }}
                  {% endif %}
                </a>
              </div>

              <div class="cart-item__content">
                <h3 class="cart-item__title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>

                {% unless item.product.has_only_default_variant %}
                  <div class="cart-item__variants">
                    {% for option in item.options_with_values %}
                      <p>
                        <span class="cart-item__variant-label">{{ option.name }}:</span>
                        {{ option.value }}
                      </p>
                    {% endfor %}
                  </div>
                {% endunless %}

                {% if item.selling_plan_allocation %}
                  <p class="cart-item__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {% endif %}

                {% if item.unit_price_measurement %}
                  <p class="cart-item__unit-price">
                    {{ item.unit_price | money }}/{{ item.unit_price_measurement.reference_value -}}
                    {{- item.unit_price_measurement.reference_unit }}
                  </p>
                {% endif %}

                <div class="cart-item__price">
                  {% if item.original_price > item.final_price %}
                    <span class="price price--sale">{{ item.final_price | money }}</span>
                    <span class="price price--compare">{{ item.original_price | money }}</span>
                  {% else %}
                    <span class="price">{{ item.final_price | money }}</span>
                  {% endif %}
                </div>

                {% if item.line_level_discount_allocations.size > 0 %}
                  <ul class="cart-item__discounts" role="list">
                    {% for discount in item.line_level_discount_allocations %}
                      <li>
                        <span>{{ discount.discount_application.title }}</span>
                        <span>-{{ discount.amount | money }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}

                <div class="cart-item__actions">
                  <quantity-input class="cart-qty">
                    <button
                      type="button"
                      class="cart-qty__button"
                      data-quantity-decrease
                      aria-label="Decrease quantity for {{ item.product.title | escape }}"
                    >
                      {% render 'icon', icon: 'minus', width: 16, height: 16 %}
                    </button>

                    <input
                      type="number"
                      class="cart-qty__input"
                      value="{{ item.quantity }}"
                      min="0"
                      data-quantity-input
                      aria-label="Quantity for {{ item.product.title | escape }}"
                    >

                    <button
                      type="button"
                      class="cart-qty__button"
                      data-quantity-increase
                      aria-label="Increase quantity for {{ item.product.title | escape }}"
                    >
                      {% render 'icon', icon: 'plus', width: 16, height: 16 %}
                    </button>
                  </quantity-input>

                  <button
                    type="button"
                    class="cart-remove"
                    data-cart-remove
                    aria-label="{{ 'cart.remove' | t }}: {{ item.product.title | escape }}"
                  >
                    {% render 'icon', icon: 'trash', width: 18, height: 18 %}
                    <span>{{ 'cart.remove' | t }}</span>
                  </button>
                </div>
              </div>

              <div class="cart-item__total">
                {% if item.original_line_price > item.final_line_price %}
                  <span class="cart-item__total-sale">{{ item.final_line_price | money }}</span>
                  <span class="cart-item__total-compare">{{ item.original_line_price | money }}</span>
                {% else %}
                  <span>{{ item.final_line_price | money }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <aside class="cart-summary" aria-label="Order summary">
          {% if settings.cart_drawer_enable_recommendations %}
            <div class="cart-page__recommendations">
              {% render 'cart-drawer-recommendations' %}
            </div>
          {% endif %}

          <div class="cart-summary__box">
            <h2 class="cart-summary__title">Order summary</h2>

            <div class="summary-row">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span class="summary-row__values">
                {% if cart.original_total_price > cart.total_price %}
                  <span class="summary-row__compare">{{ cart.original_total_price | money }}</span>
                {% endif %}
                <strong>{{ cart.items_subtotal_price | money }}</strong>
              </span>
            </div>

            {% if cart.cart_level_discount_applications.size > 0 %}
              <div class="cart-discounts">
                <ul role="list">
                  {% for discount in cart.cart_level_discount_applications %}
                    <li>
                      <span>{{ discount.title }}</span>
                      <span>-{{ discount.total_allocated_amount | money }}</span>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            {% if cart.total_discount > 0 %}
              <div class="summary-row summary-row--savings">
                <span>Savings</span>
                <strong>-{{ cart.total_discount | money }}</strong>
              </div>
            {% endif %}

            <div class="summary-row summary-row--total">
              <span>Estimated total</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            <div class="cart-note">
              <label for="CartNote">Order note</label>
              <textarea
                id="CartNote"
                name="note"
                placeholder="Add a note to your order"
              >{{ cart.note }}</textarea>
            </div>

            <button
              class="button button--primary cart-checkout"
              type="submit"
              name="checkout"
            >
              {% render 'icon', icon: 'security', width: 18, height: 18 %}
              {{ 'cart.checkout' | t }}
            </button>

            <a href="{{ continue_url }}" class="button button--secondary">
              {{ continue_label }}
            </a>

            <p class="cart-tax-note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
          </div>
        </aside>
      </div>
    </form>
  {% endif %}
</div>

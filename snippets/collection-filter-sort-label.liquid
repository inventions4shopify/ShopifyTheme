{%- liquid
  assign active_filter_count = 0

  if filters != blank
    for filter in filters
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endfor
  endif
-%}

<span class="collection-filter-summary-label">
  Filter & Sort
  <span
    class="collection-filter-count"
    data-collection-filter-count
    {% if active_filter_count == 0 %}hidden aria-hidden="true"{% endif %}
  >
    {{- active_filter_count -}}
  </span>
</span>

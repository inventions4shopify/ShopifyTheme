{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_subheading_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}

  :root {
    --tps-bp-xxs: 320px;
    --tps-bp-xs: 576px;
    --tps-bp-sm: 768px;
    --tps-bp-md: 992px;
    --tps-bp-lg: 1200px;
    --tps-bp-xl: 1400px;
    --tps-bp-2xl: 1600px;

    --tps-font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --tps-font-heading-style: {{ settings.type_heading_font.style }};
    --tps-font-heading-weight: {{ settings.type_heading_font.weight }};
    --tps-font-subheading-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    --tps-font-subheading-style: {{ settings.type_subheading_font.style }};
    --tps-font-subheading-weight: {{ settings.type_subheading_font.weight }};
    --tps-font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --tps-font-body-style: {{ settings.type_body_font.style }};
    --tps-font-body-weight: {{ settings.type_body_font.weight }};

    /* Page width */
    --tps-page-width: {{ settings.page_width_max }}px;
    --tps-page-width-narrow: 120rem;
    --tps-page-width-small: 80rem;
    --tps-page-width-xs-small: 55rem;

    /* Section spacing - Desktop */
    --tps-section-spacing-top-desktop: {{ settings.section_spacing_top_desktop }}px;
    --tps-section-spacing-bottom-desktop: {{ settings.section_spacing_bottom_desktop }}px;

    /* Section spacing - Tablet (calculated as average of desktop and mobile) */
    --tps-section-spacing-top-tablet: {{ settings.section_spacing_top_desktop | plus: settings.section_spacing_top_mobile | divided_by: 2 }}px;
    --tps-section-spacing-bottom-tablet: {{ settings.section_spacing_bottom_desktop | plus: settings.section_spacing_bottom_mobile | divided_by: 2 }}px;

    /* Section spacing - Mobile */
    --tps-section-spacing-top-mobile: {{ settings.section_spacing_top_mobile }}px;
    --tps-section-spacing-bottom-mobile: {{ settings.section_spacing_bottom_mobile }}px;

    /* Grid spacing - Desktop */
    --tps-grid-spacing-desktop: {{ settings.grid_spacing_desktop }}px;

    /* Grid spacing - Tablet (calculated as average of desktop and mobile) */
    --tps-grid-spacing-tablet: {{ settings.grid_spacing_desktop | plus: settings.grid_spacing_mobile | divided_by: 2 }}px;

    /* Grid spacing - Mobile */
    --tps-grid-spacing-mobile: {{ settings.grid_spacing_mobile }}px;

    /* Grid spacing - Current (defaults to mobile) */
    --tps-grid-spacing: var(--tps-grid-spacing-mobile);

    /* General colors */
    --tps-white: #fff;
    --tps-black: #000;
    --tps-color-background: {{ settings.background_color.rgb }};
    --tps-color-heading: {{ settings.heading_color.rgb }};
    --tps-color-subheading: {{ settings.subheading_color.rgb }};
    --tps-color-body-text: {{ settings.body_text_color.rgb }};
    --tps-color-success: {{ settings.success_color.rgb }};
    --tps-color-warning: {{ settings.warning_color.rgb }};
    --tps-color-error: {{ settings.error_color.rgb }};
    --tps-color-border: {{ settings.border_color.rgb }};
    --tps-color-border-opacity: {{ settings.border_opacity | default: 1 }};

    /* Header colors */
    --tps-color-header-background: {{ settings.header_background_color.rgb }};
    --tps-color-header-text: {{ settings.header_text_color.rgb }};
    --tps-color-header-hover-text: {{ settings.header_hover_text_color.rgb }};

    /* Footer colors */
    --tps-color-footer-background: {{ settings.footer_background_color.rgb }};
    --tps-color-footer-text: {{ settings.footer_text_color.rgb }};
    --tps-color-footer-hover-text: {{ settings.footer_hover_text_color.rgb }};

    /* Primary button colors */
    --tps-color-button-primary-text: {{ settings.primary_button_text_color.rgb }};
    --tps-color-button-primary-background: {{ settings.primary_button_background_color.rgb }};
    --tps-color-button-primary-outline: {{ settings.primary_button_outline_color.rgb }};

    /* Secondary button colors */
    --tps-color-button-secondary-text: {{ settings.secondary_button_text_color.rgb }};
    --tps-color-button-secondary-background: {{ settings.secondary_button_background_color.rgb }};
    --tps-color-button-secondary-outline: {{ settings.secondary_button_outline_color.rgb }};

    /* Product card colors */
    --tps-color-product-card-background: {{ settings.product_card_background_color.rgb }};
    --tps-color-product-card-text: {{ settings.product_card_text_color.rgb }};
    --tps-color-product-star-rating: {{ settings.product_star_rating_color.rgb }};

    /* Product badge colors */
    --tps-color-sale-badge-background: {{ settings.sale_badge_background_color.rgb }};
    --tps-color-sale-badge-text: {{ settings.sale_badge_text_color.rgb }};
    --tps-color-sold-badge-background: {{ settings.sold_badge_background_color.rgb }};
    --tps-color-sold-badge-text: {{ settings.sold_badge_text_color.rgb }};
    --tps-color-custom-badge-background: {{ settings.custom_badge_background_color.rgb }};
    --tps-color-custom-badge-text: {{ settings.custom_badge_text_color.rgb }};

    /* spacing variable */
    --tps-spacing-2: 0.2rem;
    --tps-spacing-4: 0.4rem;
    --tps-spacing-6: 0.6rem;
    --tps-spacing-8: 0.8rem;
    --tps-spacing-10: 1rem;
    --tps-spacing-12: 1.2rem;
    --tps-spacing-14: 1.4rem;
    --tps-spacing-16: 1.6rem;
    --tps-spacing-18: 1.8rem;
    --tps-spacing-20: 2rem;
    --tps-spacing-24: 2.4rem;
    --tps-spacing-28: 2.8rem;
    --tps-spacing-32: 3.2rem;
    --tps-spacing-36: 3.6rem;
    --tps-spacing-40: 4rem;
    --tps-spacing-48: 4.8rem;
    --tps-spacing-56: 5.6rem;
    --tps-spacing-64: 6.4rem;
    --tps-spacing-72: 7.2rem;
    --tps-spacing-80: 8rem;
    --tps-spacing-96: 9.6rem;
    --tps-spacing-100: 10rem;
    --tps-spacing-112: 11.2rem;
    --tps-spacing-128: 12.8rem;
    --tps-spacing-144: 14.4rem;
    --tps-spacing-160: 16rem;
    --tps-spacing-192: 19.2rem;
    --tps-spacing-224: 22.4rem;
    --tps-spacing-240: 24rem;

    /* heading styles */
    --tps-text-h0: {%- if settings.heading_size == "large" -%} 5.4rem {%- elsif settings.heading_size == "medium" -%} 4.4rem {%- else -%} 4.4rem {%- endif -%};
    --tps-text-h1: {%- if settings.heading_size == "large" -%} 4.2rem {%- elsif settings.heading_size == "medium" -%} 4rem {%- else -%} 3.8rem {%- endif -%};
    --tps-text-h2: {%- if settings.heading_size == "large" -%} 3.4rem {%- elsif settings.heading_size == "medium" -%} 3rem {%- else -%} 3.2rem {%- endif -%};
    --tps-text-h3: {%- if settings.heading_size == "large" -%} 2.6rem {%- elsif settings.heading_size == "medium" -%} 2.2rem {%- else -%} 2rem {%- endif -%};
    --tps-text-h4: {%- if settings.heading_size == "large" -%} 2.4rem {%- elsif settings.heading_size == "medium" -%} 2rem {%- else -%} 1.8rem {%- endif -%};
    --tps-text-h5: {%- if settings.heading_size == "large" -%} 1.8rem {%- elsif settings.heading_size == "medium" -%} 1.6rem {%- else -%} 1.4rem {%- endif -%};
    --tps-text-h6: {%- if settings.heading_size == "large" -%} 1.6rem {%- elsif settings.heading_size == "medium" -%} 1.4rem {%- else -%} 1.2rem {%- endif -%};
    --tps-text-letter-spacing: {{ settings.heading_letter_spacing }}rem;
    --tps-heading-transform: {{ settings.heading_text_transform }};

    --tps-text-base: {{ settings.mobile_body_text | times: 0.1 }}rem;
    --tps-body-text: {{ settings.body_text | times: 0.1 }}rem;
    --tps-text-xss: calc(var(--tps-text-base) * 0.75);
    --tps-text-xs: calc(var(--tps-text-base) * 0.875);
    --tps-text-sm: calc(var(--tps-text-base) * 0.9375);
    --tps-text-lg: calc(var(--tps-text-base) * 1.125);
    --tps-text-xlg: calc(var(--tps-text-base) * 1.25);
    --tps-body-letter-spacing: {{ settings.body_text_letter_spacing }}rem;

    --tps-sub-heading-text: {%- if settings.sub_heading_size == "large" -%} 2rem {%- elsif settings.sub_heading_size == "medium" -%} 1.6rem {%- else -%} 1.4rem {%- endif -%};
    --tps-sub-heading-letter-spacing: {{ settings.subheading_letter_spacing }}rem;
    --tps-sub-heading-transform: {{ settings.subheading_text_transform }};

    --tps-radius-xs: 0.2rem;
    --tps-radius-sm: 0.4rem;
    --tps-radius-md: 0.8rem;
    --tps-radius-lg: 1.2rem;
    --tps-radius-xl: 1.6rem;
    --tps-radius-full: 100rem;

    --tps-transition-fast: 0.2s ease-in-out;
    --tps-transition-medium: 0.3s ease-in-out;
    --tps-transition-slow: 0.5s ease-in-out;

    --tps-button-radius: {{ settings.button_border_radius | times: 0.1 }}rem;
    --tps-button-text-transform: {{ settings.button_text_transform }};
    --tps-button-font-size: var(--tps-text-base);
    --tps-button-font-weight: 500;
    --tps-button-transition: var(--tps-transition-fast);

    --tps-input-radius: {{ settings.input_border_radius | times: 0.1 }}rem;
    --tps-input-border-style: {{ settings.input_border_style }};
    --tps-input-border-width: 0.1rem;
    --tps-input-border-color: rgba(var(--tps-color-border), var(--tps-color-border-opacity));
    --tps-input-background: rgb(var(--tps-color-background));
    --tps-input-text-color: rgb(var(--tps-color-body-text));
    --tps-media-radius: {{ settings.media_border_radius }}px;
    --tps-img-placeholder: {{ settings.img_placeholder_color }};
    --tps-media-fit: {{ settings.media_object_fit }};


    /* height variable */
    --tps-section-height-small: 40dvh;
    --tps-section-height-medium: 55dvh;
    --tps-section-height-large: 70dvh;

    --tps-card-radius: {{ settings.card_border_radius | times: 0.1 }}rem;
  }

  @media (min-width: 992px) {
    :root {
      --tps-text-h0: {%- if settings.heading_size == "large" -%} 7.4rem {%- elsif settings.heading_size == "medium" -%} 6.4rem {%- else -%} 4.4rem {%- endif -%};
      --tps-text-h1: {%- if settings.heading_size == "large" -%} 7.2rem {%- elsif settings.heading_size == "medium" -%} 5.6rem {%- else -%} 4rem {%- endif -%};
      --tps-text-h2: {%- if settings.heading_size == "large" -%} 6.4rem {%- elsif settings.heading_size == "medium" -%} 4.8rem {%- else -%} 3.6rem {%- endif -%};
      --tps-text-h3: {%- if settings.heading_size == "large" -%} 5.6rem {%- elsif settings.heading_size == "medium" -%} 4rem {%- else -%} 3.2rem {%- endif -%};
      --tps-text-h4: {%- if settings.heading_size == "large" -%} 4.4rem {%- elsif settings.heading_size == "medium" -%} 3.2rem {%- else -%} 2.8rem {%- endif -%};

        /* height variable */
      --tps-section-height-small: 50dvh;
      --tps-section-height-medium: 65dvh;
      --tps-section-height-large: 80dvh;
    }
  }

  @media (min-width: 1200px) {
    :root {
      --tps-grid-spacing: var(--tps-grid-spacing-desktop);
    }
  }
{% endstyle %}

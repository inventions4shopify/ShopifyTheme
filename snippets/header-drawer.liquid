{%- liquid
  assign menu = section.settings.main_menu

  assign show_loc = false
  if section.settings.show_country and localization.available_countries.size > 1
    assign show_loc = true
  endif
  if section.settings.show_language and localization.available_languages.size > 1
    assign show_loc = true
  endif
-%}

{% style %}
  /* show drawer element in the burger grid cell; respect theme's desktop hiding */
  {%- if section.settings.menu_type == 'drawer' -%}
    header-drawer { display: contents; }
  {%- else -%}
    @media (max-width: 992px) { header-drawer { display: contents; } }
  {%- endif -%}

  .drawer-nav__burger {
    background: none; border: 0; cursor: pointer; color: inherit;
    display: inline-flex; align-items: center; padding: 0;
  }

  /* overlay */
  .drawer-nav__overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.42);
    opacity: 0; visibility: hidden; transition: opacity .25s ease, visibility .25s ease;
    z-index: 1000;
  }
  .drawer-nav.is-open .drawer-nav__overlay { opacity: 1; visibility: visible; }

  /* sliding container */
  .drawer-nav__panels {
    position: fixed; top: 0; left: 0; bottom: 0;
    max-width: 40.0rem;
    width: 100%;
    background: rgb(var(--tps-color-header-background));
    color: rgb(var(--tps-color-header-text));
    transform: translateX(-100%);
    transition: transform .28s ease;
    z-index: 1001;
    overflow: hidden;
  }
  .drawer-nav.is-open .drawer-nav__panels { transform: translateX(0); }

  /* individual panels stacked on top of each other */
  .drawer-nav__panel {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    background: rgb(var(--tps-color-header-background));
    transform: translateX(100%);
    transition: transform .28s ease;
    overflow-y: auto;
  }
  .drawer-nav__panel[data-dm-panel="root"] { transform: translateX(0); }
  .drawer-nav__panel.is-active { transform: translateX(0); }

  /* head row */
  .drawer-nav__head {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--tps-spacing-10); padding: 1.6rem 1.8rem; min-height: 5.6rem;
  }
  .drawer-nav__head--root { justify-content: flex-end; }
  .drawer-nav__icon-btn {
    background: none; border: 0; cursor: pointer; color: inherit;
    padding: var(--tps-spacing-4); display: inline-flex; align-items: center; line-height: 0;
  }
  .drawer-nav__back {
    gap: var(--tps-spacing-10); font-size: var(--tps-text-base); font-weight: 500;
  }
  .drawer-nav__back span { line-height: 1; }

  /* root list */
  .drawer-nav__list { list-style: none; margin: 0; padding: 0.4rem 0; }
  .drawer-nav__item { margin: 0; }
  .drawer-nav__link {
    display: flex; align-items: center; justify-content: space-between;
    width: 100%; gap: var(--tps-spacing-12); text-align: left;
    padding: 1.0rem 1.8rem;
    font-size: var(--tps-text-lg); line-height: 1.25; font-weight: 400;
    color: inherit; text-decoration: none;
    background: none; border: 0; cursor: pointer;
    transition: all 0.25s ease;
  }

  .drawer-nav__link span {
    position: relative;
  }

  .drawer-nav__link span::before {
      width: 100%;
      display: block;
      content: "";
      height: .1rem;
      background-color: rgb(var(--tps-color-header-hover-text));
      position: absolute;
      border-radius: 2rem;
      bottom: -.2rem;
      left: 0;
      transition: transform .15s;
      transform: scaleX(0);
  }

  .drawer-nav__link:hover span::before,
  .drawer-nav__link:focus span::before {
      transform: scaleX(1);
  }

  /* sub-panel content */
  .drawer-nav__sub { padding: 0.4rem 1.8rem 2.4rem;  display: flex;
  flex-direction: column;
  gap: var(--tps-spacing-20); }
  .drawer-nav__col { margin-bottom: 2.2rem; }
  .drawer-nav__col:last-child { margin-bottom: 0; }
  .drawer-nav__col-title {
    margin: 0.6rem 0 ; font-size: var(--tps-text-xs); font-weight: 400;
    opacity: .55; line-height: 1.4;text-transform: capitalize;
  }
  .drawer-nav__col-list { list-style: none; margin: 0; padding: 0; }
  .drawer-nav__col-list li { margin: 0; }
  .drawer-nav__sublink {
    display: block; padding: 0.5rem 0;
    font-size: var(--tps-text-base); line-height: 1.3;
    color: inherit; text-decoration: none;
  }
  /* grandchild items */
  .drawer-nav__col-sublist {
    list-style: none; margin: var(--tps-spacing-2) 0 var(--tps-spacing-4) var(--tps-spacing-10); padding-left: var(--tps-spacing-12);
    border-left: 0.1rem solid rgba(var(--tps-color-header-text) / 0.2);
  }
  .drawer-nav__sublink--grand { font-size: var(--tps-text-sm); opacity: .8; padding: 0.4rem 0; }

  /* image banner inside a sub-panel */
  .drawer-nav__banner {
    display: block; margin-top: 1.4rem; text-decoration: none; color: inherit;
    border-radius: var(--tps-radius-md, 0.8rem); overflow: hidden;
    background: rgba(127,127,127,.08);
  }
  .drawer-nav__banner img { display: block; width: 100%; height: 14.0rem; object-fit: cover; }
  .drawer-nav__banner-body { padding: 1.2rem 1.4rem; }
  .drawer-nav__banner-title { font-weight: 600; }
  .drawer-nav__banner-desc { font-size: var(--tps-text-sm); opacity: .8; margin-top: 0.4rem; }

  /* footer / localization */
  .drawer-nav__footer {
    margin-top: auto; padding: 1.6rem 1.8rem;
    display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;  background: var(--tps-input-text-color);
  }
  .drawer-nav__footer .localization-form { display: inline-flex; }
  @media (max-width: 575px) {
    .drawer-nav__panels {
      max-width: 100%;
      width: 100%;
    }
  }
{% endstyle %}

<script src="{{ 'header-drawer.js' | asset_url }}" defer="defer"></script>

<header-drawer class="drawer-nav">
  {%- comment -%} burger / open button {%- endcomment -%}
  <button type="button" class="header__burger drawer-nav__burger" data-dm-open aria-label="Open menu" aria-expanded="false">
    {% render 'icon' , icon: 'hamburger' , width: 24, height: 24 %}
  </button>

  <div class="drawer-nav__overlay" data-dm-close></div>

  <div class="drawer-nav__panels" role="dialog" aria-modal="true" aria-label="Menu">
    {%- comment -%} ---------- ROOT PANEL ---------- {%- endcomment -%}
    <div class="drawer-nav__panel is-active" data-dm-panel="root">
      <div class="drawer-nav__head drawer-nav__head--root">
        <button type="button" class="drawer-nav__icon-btn" data-dm-close aria-label="Close menu">
          {% render 'icon' , icon: 'close' , width: 20, height: 20 %}
        </button>
      </div>

      <ul class="drawer-nav__list">
        {%- for link in menu.links -%}
          {%- liquid
            assign has_children = false
            for block in section.blocks
              if block.settings.parent_item != blank
                assign bt = block.settings.parent_item | downcase | strip
                assign lt = link.title | downcase | strip
                if bt == lt
                  assign has_children = true
                  break
                endif
              endif
            endfor
            unless has_children
              if link.links.size > 0
                assign has_children = true
              endif
            endunless
          -%}
          <li class="drawer-nav__item">
            {%- if has_children -%}
              <button type="button" class="drawer-nav__link drawer-nav__link--has-child" data-dm-to="panel-{{ forloop.index }}">
                <span>{{ link.title | escape }}</span>
                {% render 'icon' , icon: 'arrow-right' , width: 20, height: 20 %}
              </button>
            {%- else -%}
              <a class="drawer-nav__link" href="{{ link.url }}">
                <span>{{ link.title | escape }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_loc -%}
        <div class="drawer-nav__footer">
          {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon-btn header__icon--account {% if section.settings.menu != blank %} small-hide{% endif %}"
            rel="nofollow"
          >
            {%- if section.settings.enable_customer_avatar -%}
              <account-icon>
                {%- if customer and customer.has_avatar? -%}
                  {{ customer | avatar }}
                {%- else -%}
                  {% render 'icon', icon: 'account', width: 20, height: 20 %}
                {%- endif -%}
              </account-icon>
            {%- else -%}
              {% render 'icon', icon: 'account', width: 20, height: 20 %}
            {%- endif -%}
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'Account'
                else
                  echo 'Log in'
                endif
              -%}
            </span>
          </a>
        {%- endif -%}
          {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'DrawerCountryForm', class: 'localization-form' -%}
                {%- render 'country-localization', localPosition: 'DrawerCountry' -%}
              {%- endform -%}
            </localization-form>
          {%- endif -%}
          {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'DrawerLanguageForm', class: 'localization-form' -%}
                {%- render 'language-localization', localPosition: 'DrawerLanguage' -%}
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- SUB PANELS ---------- {%- endcomment -%}
    {%- for link in menu.links -%}
      {%- liquid
        assign has_children = false
        assign has_blocks = false
        for block in section.blocks
          if block.settings.parent_item != blank
            assign bt = block.settings.parent_item | downcase | strip
            assign lt = link.title | downcase | strip
            if bt == lt
              assign has_children = true
              assign has_blocks = true
              break
            endif
          endif
        endfor
        unless has_children
          if link.links.size > 0
            assign has_children = true
          endif
        endunless
      -%}
      {%- if has_children -%}
        <div class="drawer-nav__panel" data-dm-panel="panel-{{ forloop.index }}">
          <div class="drawer-nav__head">
            <button type="button" class="drawer-nav__icon-btn drawer-nav__back" data-dm-back="root" aria-label="Back">
              {% render 'icon' , icon: 'chevron-left' , width: 16, height: 16 %}
              <span>{{ link.title | escape }}</span>
            </button>
            <button type="button" class="drawer-nav__icon-btn" data-dm-close aria-label="Close menu">
              {% render 'icon' , icon: 'close' , width: 20, height: 20 %}
            </button>
          </div>

          <div class="drawer-nav__sub">
            {%- if has_blocks -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign show = false
                  if block.settings.parent_item != blank
                    assign bt = block.settings.parent_item | downcase | strip
                    assign lt = link.title | downcase | strip
                    if bt == lt
                      assign show = true
                    endif
                  endif
                -%}
                {%- if show and block.type == 'menu_column' -%}
                  <div class="drawer-nav__col" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="drawer-nav__col-title">{{ block.settings.heading | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.menu != blank -%}
                      <ul class="drawer-nav__col-list">
                        {%- for l in block.settings.menu.links -%}
                          <li>
                            <a class="drawer-nav__sublink" href="{{ l.url }}">{{ l.title | escape }}</a>
                            {%- if l.links.size > 0 -%}
                              <ul class="drawer-nav__col-sublist">
                                {%- for gl in l.links -%}
                                  <li><a class="drawer-nav__sublink drawer-nav__sublink--grand" href="{{ gl.url }}">{{ gl.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                {%- elsif show and block.type == 'image_banner' -%}
                  <a
                        class="header__mega-banner"
                        href="{{ block.settings.button_link | default: link.url }}"
                        {{ block.shopify_attributes }}
                      >
                        {%- if block.settings.image != blank -%}
                          {{
                            block.settings.image
                            | image_url: width: 600
                            | image_tag: class: 'header__mega-banner-img', widths: '300,600', alt: block.settings.heading
                          }}
                        {%- endif -%}
                        <span class="header__mega-banner-body">
                          {%- if block.settings.heading != blank -%}
                            <span class="header__mega-banner-title">{{ block.settings.heading }}</span>
                          {%- endif -%}
                          {%- if block.settings.description != blank -%}
                            <span class="header__mega-banner-desc">{{ block.settings.description }}</span>
                          {%- endif -%}
                          {%- if block.settings.button_label != blank -%}
                            <span class="header__mega-banner-btn button button--secondary">{{ block.settings.button_label }}</span>
                          {%- endif -%}
                        </span>
                      </a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <ul class="drawer-nav__col-list">
                {%- for child in link.links -%}
                  <li>
                    <a class="drawer-nav__sublink" href="{{ child.url }}">{{ child.title | escape }}</a>
                    {%- if child.links.size > 0 -%}
                      <ul class="drawer-nav__col-sublist">
                        {%- for gc in child.links -%}
                          <li><a class="drawer-nav__sublink drawer-nav__sublink--grand" href="{{ gc.url }}">{{ gc.title | escape }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header-drawer>

{%- comment -%}
  Header drawer (mobile + "drawer" menu type)
  - 3-level nested accordion menu
  - Account / Log in link
  - Country & language selectors (if enabled)
  - Social icons (from theme settings)
  Works with the open/close JS in header.liquid (.header__overlay / .header__drawer).
{%- endcomment -%}
<div class="header__overlay" data-drawer-close></div>
<header-drawer>
  <button class="header__burger" aria-label="Open menu" data-drawer-open>
  <span>
    {% render 'icon', icon: 'hamburger', width: 20, height: 20 %}
    {% comment %} {% render 'icon', icon: 'close', width: 20, height: 20 %} {% endcomment %}
  </span>
</button>
  <aside class="header__drawer" id="HeaderDrawer" aria-label="Menu">
    <div class="header__drawer-head">
      <a href="{{ routes.root_url }}" class="header__drawer-logo">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 240 | image_tag: alt: shop.name, widths: '120,240', sizes: '120px' }}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <button class="header__icon-btn" data-drawer-close aria-label="Close menu">
        {% render 'icon', icon: 'close', width: 20, height: 20 %}
      </button>
    </div>
  
    <nav class="header__drawer-nav" aria-label="Mobile">
      <ul class="header__drawer-list">
        {%- for link in section.settings.main_menu.links -%}
          <li class="header__drawer-item">
            {%- if link.links != blank -%}
              <div class="header__drawer-row">
                <a href="{{ link.url }}" class="header__drawer-link">{{ link.title }}</a>
                <button class="header__drawer-toggle" data-accordion aria-expanded="false" aria-label="Expand {{ link.title | escape }}">
                 {% render 'icon', icon: 'chevron-down', width: 20, height: 20 %}
                </button>
              </div>
              <ul class="header__drawer-sub">
                {%- for child in link.links -%}
                  <li class="header__drawer-item">
                    {%- if child.links != blank -%}
                      <div class="header__drawer-row">
                        <a href="{{ child.url }}" class="header__drawer-link">{{ child.title }}</a>
                        <button class="header__drawer-toggle" data-accordion aria-expanded="false" aria-label="Expand {{ child.title | escape }}">
                          {% render 'icon', icon: 'chevron-down', width: 20, height: 20 %}
                        </button>
                      </div>
                      <ul class="header__drawer-sub header__drawer-sub--grand">
                        {%- for grandchild in child.links -%}
                          <li class="header__drawer-item">
                            <a href="{{ grandchild.url }}" class="header__drawer-link">{{ grandchild.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <a href="{{ child.url }}" class="header__drawer-link">{{ child.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <a href="{{ link.url }}" class="header__drawer-link">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  
    <div class="header__drawer-footer">
      {%- if shop.customer_accounts_enabled -%}
        <a
          class="header__drawer-account"
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          rel="nofollow"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
          {%- if customer -%}{{ 'customers.account.title' | t | default: 'Account' }}{%- else -%}{{ 'customers.log_in' | t | default: 'Log in' }}{%- endif -%}
        </a>
      {%- endif -%}
  
      {%- comment -%} Country / language (only if enabled in section settings) {%- endcomment -%}
      {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'header__drawer-loc' -%}
          <select name="country_code" onchange="this.form.submit()" aria-label="Country/region">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
      {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'header__drawer-loc' -%}
          <select name="locale_code" onchange="this.form.submit()" aria-label="Language">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{ language.endonym_name }}
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
  
      {%- comment -%} Social icons — render only the ones set in theme settings {%- endcomment -%}
      <div class="header__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M14 9h3V6h-3c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3H13.5V9.5C13.5 9.2 13.7 9 14 9z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" aria-label="X" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 3h3l-6.5 7.4L21.7 21h-5.9l-4.6-6-5.3 6H3l7-8L2.5 3h6l4.1 5.5L17.5 3zm-1 16h1.6L7.6 4.7H5.9L16.5 19z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" aria-label="YouTube" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.5 12 5.5 12 5.5s-6 0-7.9.6A3 3 0 0 0 2 8.2 31 31 0 0 0 1.7 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.6 7.9.6 7.9.6s6 0 7.9-.6a3 3 0 0 0 2.1-2.1c.3-1.3.3-3.8.3-3.8s0-2.5-.3-3.8zM10 15V9l5.2 3L10 15z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16 3c.3 2 1.6 3.6 3.6 4v3c-1.4 0-2.7-.4-3.8-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3.2z"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3-2.3 3-5 0-2-1.4-3.6-3.9-3.6-2.9 0-4.6 2.1-4.6 4.4 0 .8.2 1.4.6 1.9.2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.6.2-1.2-.5-1.7-1.8-1.7-3.3 0-2.5 2.1-5.5 6.3-5.5 3.3 0 5.5 2.4 5.5 5 0 3.4-1.9 6-4.7 6-.9 0-1.8-.5-2.1-1.1l-.6 2.2c-.2.8-.7 1.7-1 2.3A10 10 0 1 0 12 2z"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </aside>
</header-drawer>

<script>
  (function () {
    var drawer = document.getElementById('HeaderDrawer');
    if (!drawer) return;
    drawer.querySelectorAll('[data-accordion]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var row = btn.closest('.header__drawer-row');
        var sub = row ? row.nextElementSibling : null;
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.classList.toggle('is-open', !open);
        if (sub && sub.classList.contains('header__drawer-sub')) {
          sub.classList.toggle('is-open', !open);
        }
      });
    });
  })();
</script>

<nav class="header__nav header__nav--desktop header__nav--dropdown" aria-label="Primary">
  <ul class="header__nav-list">
    {%- for link in section.settings.main_menu.links -%}
      {%- assign has_children = false -%}
      {%- if link.links != blank -%}{%- assign has_children = true -%}{%- endif -%}
      <li class="header__nav-item{% if has_children %} has-children{% endif %}">
        <a
          href="{{ link.url }}"
          class="header__nav-link"
          {% if link.current %}aria-current="page"{% endif %}
        >
          <span>{{ link.title }}</span>
          {%- if has_children -%}
            <span class="header__nav-icon">
              {% render 'icon' , icon: 'chevron-bottom' , width: 16, height: 16 %}
            </span>
          {%- endif -%}
        </a>

        {%- if has_children -%}
          <ul class="header__submenu">
            {%- for child in link.links -%}
              {%- assign has_grand = false -%}
              {%- if child.links != blank -%}{%- assign has_grand = true -%}{%- endif -%}
              <li class="header__nav-item{% if has_grand %} has-children{% endif %}">
                <a
                  href="{{ child.url }}"
                  class="header__nav-link"
                  {% if child.current %}aria-current="page"{% endif %}
                >
                  <span>{{ child.title }}</span>
                  {%- if has_grand -%}
                    <span class="header__nav-icon">
                      {% render 'icon' , icon: 'chevron-right' , width: 14, height: 14 %}
                    </span>
                  {%- endif -%}
                </a>

                {%- if has_grand -%}
                  <ul class="header__submenu header__submenu--nested">
                    {%- for grandchild in child.links -%}
                      <li class="header__nav-item">
                        <a
                          href="{{ grandchild.url }}"
                          class="header__nav-link"
                          {% if grandchild.current %}aria-current="page"{% endif %}
                        >
                          <span>{{ grandchild.title }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

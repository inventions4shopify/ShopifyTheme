<nav class="header__nav header__nav--desktop header__nav--mega" aria-label="Primary">
  <ul class="header__nav-list">
    {%- for link in section.settings.main_menu.links -%}
      {%- assign has_children = false -%}
      {%- if link.links != blank -%}{%- assign has_children = true -%}{%- endif -%}
      <li class="header__nav-item{% if has_children %} has-children{% endif %}">
        <a
          href="{{ link.url }}"
          class="header__nav-link"
          {% if link.current %}aria-current="page"{% endif %}
        >
          <span>{{ link.title }}</span>
          {%- if has_children -%}
            <svg class="header__caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </a>

        {%- if has_children -%}
          <div class="header__mega">
            <div class="header__mega-inner">
              {%- for child in link.links -%}
                <div class="header__mega-col">
                  <a
                    href="{{ child.url }}"
                    class="header__mega-title"
                    {% if child.current %}aria-current="page"{% endif %}
                  >
                    {{ child.title }}
                  </a>
                  {%- if child.links != blank -%}
                    <ul class="header__mega-list">
                      {%- for grandchild in child.links -%}
                        <li>
                          <a
                            href="{{ grandchild.url }}"
                            class="header__mega-link"
                            {% if grandchild.current %}aria-current="page"{% endif %}
                          >
                            {{ grandchild.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{%- comment -%}
  Renders predictive search results.
  Output is fetched by assets/predictive-search.js via the
  `sections/predictive-search.liquid` section and injected into
  `[data-predictive-search]`.

  Globals used:
    - predictive_search (populated by the predictive search endpoint)
    - settings.predictive_search_show_vendor
    - settings.predictive_search_show_price
{%- endcomment -%}

{%- if predictive_search.performed -%}
  {%- liquid
    assign products = predictive_search.resources.products
    assign collections = predictive_search.resources.collections
    assign pages = predictive_search.resources.pages
    assign articles = predictive_search.resources.articles
    assign queries = predictive_search.resources.queries

    assign has_results = false
    if products.size > 0 or collections.size > 0 or pages.size > 0 or articles.size > 0 or queries.size > 0
      assign has_results = true
    endif

    assign has_suggestions = false
    if queries.size > 0 or pages.size > 0 or articles.size > 0
      assign has_suggestions = true
    endif

    assign has_catalog = false
    if products.size > 0 or collections.size > 0
      assign has_catalog = true
    endif
  -%}

  <div id="predictive-search-results" class="predictive-search__results" role="listbox">
    {%- if has_results -%}
      <div class="predictive-search__results-groups-wrapper{% if has_suggestions and has_catalog %} predictive-search__results-groups-wrapper--split{% endif %}">
        {%- if has_suggestions -%}
          <div class="predictive-search__column predictive-search__column--suggestions">
        {%- endif -%}

        {%- comment -%} Suggested search queries {%- endcomment -%}
        {%- if queries.size > 0 -%}
          <div class="predictive-search__result-group">
            <h2 id="predictive-search-queries" class="predictive-search__heading">
              {{ 'search.suggestions' | t }}
            </h2>
            <ul
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-queries"
            >
              {%- for query in queries -%}
                <li
                  id="predictive-search-option-query-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ query.url }}" class="predictive-search__item predictive-search__item--query link">
                    <span class="predictive-search__item-icon" aria-hidden="true">
                      {% render 'icon', icon: 'search', width: 18, height: 18 %}
                    </span>
                    <span class="predictive-search__item-query-result">{{ query.styled_text }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} Pages {%- endcomment -%}
        {%- if pages.size > 0 -%}
          <div class="predictive-search__result-group">
            <h2 id="predictive-search-pages" class="predictive-search__heading">
              {{ 'search.pages' | t }}
            </h2>
            <ul
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-pages"
            >
              {%- for page in pages -%}
                <li
                  id="predictive-search-option-page-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ page.url }}" class="predictive-search__item predictive-search__item--link link">
                    <span class="predictive-search__item-content predictive-search__item-content--centered">
                      <span class="predictive-search__item-heading">{{ page.title }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} Articles {%- endcomment -%}
        {%- if articles.size > 0 -%}
          <div class="predictive-search__result-group">
            <h2 id="predictive-search-articles" class="predictive-search__heading">
              {{ 'search.articles' | t }}
            </h2>
            <ul
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-articles"
            >
              {%- for article in articles -%}
                <li
                  id="predictive-search-option-article-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ article.url }}" class="predictive-search__item predictive-search__item--link link">
                    {%- if article.image != blank -%}
                      <span class="predictive-search__item-media">
                        {{
                          article.image
                          | image_url: width: 150
                          | image_tag:
                            widths: '50, 100, 150',
                            sizes: '50px',
                            class: 'predictive-search__image',
                            alt: article.image.alt
                        }}
                      </span>
                    {%- endif -%}
                    <span class="predictive-search__item-content">
                      <span class="predictive-search__item-heading">{{ article.title }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_suggestions -%}
          </div>
        {%- endif -%}

        {%- if has_catalog -%}
          <div class="predictive-search__column predictive-search__column--catalog">
        {%- endif -%}

        {%- comment -%} Products {%- endcomment -%}
        {%- if products.size > 0 -%}
          <div class="predictive-search__result-group">
            <h2 id="predictive-search-products" class="predictive-search__heading">
              {{ 'search.products' | t }}
            </h2>
            <ul
              class="predictive-search__results-list predictive-search__results-list--products list-unstyled"
              role="group"
              aria-labelledby="predictive-search-products"
            >
              {%- for product in products -%}
                <li
                  id="predictive-search-option-product-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ product.url }}" class="predictive-search__item predictive-search__item--link link">
                    <span class="predictive-search__item-media">
                      {%- if product.featured_media != blank -%}
                        {{
                          product.featured_media
                          | image_url: width: 150
                          | image_tag:
                            widths: '50, 100, 150',
                            sizes: '50px',
                            class: 'predictive-search__image',
                            alt: product.featured_media.alt
                        }}
                      {%- endif -%}
                    </span>
                    <span class="predictive-search__item-content">
                      {%- if settings.predictive_search_show_vendor and product.vendor != blank -%}
                        <span class="predictive-search__item-vendor caption">{{ product.vendor }}</span>
                      {%- endif -%}
                      <span class="predictive-search__item-heading">{{ product.title }}</span>
                      {%- if settings.predictive_search_show_price -%}
                        <span class="predictive-search__item-price">
                          {%- if product.price_varies -%}
                            {{ product.price_min | money }}+
                          {%- else -%}
                            {{ product.price | money }}
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} Collections {%- endcomment -%}
        {%- if collections.size > 0 -%}
          <div class="predictive-search__result-group">
            <h2 id="predictive-search-collections" class="predictive-search__heading">
              {{ 'search.collections' | t }}
            </h2>
            <ul
              class="predictive-search__results-list list-unstyled"
              role="group"
              aria-labelledby="predictive-search-collections"
            >
              {%- for collection in collections -%}
                <li
                  id="predictive-search-option-collection-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ collection.url }}" class="predictive-search__item predictive-search__item--link link">
                    <span class="predictive-search__item-content predictive-search__item-content--centered">
                      <span class="predictive-search__item-heading">{{ collection.title }}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_catalog -%}
          </div>
        {%- endif -%}
      </div>

      {%- if predictive_search.terms != blank -%}
        <div class="predictive-search__footer">
          <a
            href="{{ routes.search_url }}?q={{ predictive_search.terms | escape }}&options%5Bprefix%5D=last"
            class="predictive-search__view-all button button--secondary"
          >
            {{ 'search.view_all_results' | t: terms: predictive_search.terms }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="predictive-search__no-results">
        <p class="predictive-search__no-results-text">
          {{ 'search.no_predictive_results_html' | t: terms: predictive_search.terms }}
        </p>
      </div>
    {%- endif -%}
  </div>

  <span class="visually-hidden" role="status" aria-live="polite">
    {%- if has_results -%}
      {{ 'search.announcement' | t: count: predictive_search.resources.products.size }}
    {%- else -%}
      {{ 'search.no_predictive_results_html' | t: terms: predictive_search.terms }}
    {%- endif -%}
  </span>
{%- endif -%}

{% style %}
  .product_accordion {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .product_accordion_summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  .product_accordion_summary::-webkit-details-marker {
    display: none;
  }

  .product_accordion_icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s ease;
    flex-shrink: 0;
  }

  .product_accordion[open] .product_accordion_icon {
    transform: rotate(-180deg);
  }

  .product_accordion_content_wrapper {
    height: 0;
    overflow: hidden;
    transition: height 0.35s ease;
  }

  .product_accordion_content {
    padding-bottom: 16px;
  }

  .product_accordion_content > *:first-child {
    margin-top: 0;
  }

  .product_accordion_content > *:last-child {
    margin-bottom: 0;
  }
{% endstyle %}

<details
  class="product_accordion"
  {% if block.settings.open_by_default %}
    open
  {% endif %}
  {{ block.shopify_attributes }}
>
  <summary class="product_accordion_summary">
    <span>{{ block.settings.heading }}</span>

    <span class="product_accordion_icon">
      {% render 'icon', icon: 'chevron-bottom', width: 22, height: 22 %}
    </span>
  </summary>

  <div class="product_accordion_content_wrapper">
    <div class="product_accordion_content">
      {{ block.settings.content }}
    </div>
  </div>
</details>


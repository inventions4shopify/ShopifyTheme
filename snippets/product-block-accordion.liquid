{{ 'product-block-accordion.css' | asset_url | stylesheet_tag }}

<details
  class="product_accordion"
  {% if block.settings.open_by_default %}
    open
  {% endif %}
  {{ block.shopify_attributes }}
>
  <summary class="product_accordion_summary">
    <span>{{ block.settings.heading }}</span>

    <span class="product_accordion_icon">
      {% render 'icon', icon: 'chevron-bottom', width: 22, height: 22 %}
    </span>
  </summary>

  <div class="product_accordion_content_wrapper">
    <div class="product_accordion_content">
      {{ block.settings.content }}
    </div>
  </div>
</details>

{% comment %} JS For accordion is in product-block.js file which is added in main-product.liquid section file. {% endcomment %}

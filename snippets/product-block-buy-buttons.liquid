{% style %}
  .product_form {
    margin-top: 1.5rem;
    display: block;
  }
  .product_form_submit {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 1%;
    flex: 1 1 auto;
  }

  .product_quantity_buy_wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
  }

  .product_form_submit.loading {
    pointer-events: none;
  }

  .product_form_spinner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: inherit;
  }

  .product_form_spinner.hidden {
    display: none;
  }

  .product_form_submit.loading > svg,
  .product_form_submit.loading > span:not(.product_form_spinner) {
    opacity: 0;
  }
{% endstyle %}

<product-form
  class="product_form"
  data-product-id="{{ product.id }}"
  data-cart-type="{{ settings.cart_type }}"
  data-cart-drawer-section="cart-drawer"
  {{ block.shopify_attributes }}
>
  {% form 'product', product, class: 'product_form_form', novalidate: 'novalidate' %}
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
      data-variant-id
    >

    <div class="product_quantity_buy_wrapper">
      {% if block.settings.show_quantity_selector %}
        {% render 'product-quantity-input' %}
      {% endif %}

      <button
        type="submit"
        name="add"
        class="product_form_submit button button--primary"
        data-add-to-cart
      >
        {% render 'icon', icon: 'cart', width: 22, height: 22 %}

        <span data-add-to-cart-text> Add to cart </span>

        <span
          class="product_form_spinner hidden"
          data-spinner
        >
          {% render 'loading-spinner' %}
        </span>
      </button>
    </div>

    {% if block.settings.show_dynamic_checkout %}
      {{ form | payment_button }}
    {% endif %}
  {% endform %}
</product-form>

<script src="{{ 'product-block-buy-buttons.js' | asset_url }}" defer="defer"></script>

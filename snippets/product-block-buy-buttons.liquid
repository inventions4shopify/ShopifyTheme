{%- liquid
  assign buy_show_quantity_selector = qv_show_quantity_selector | default: block.settings.show_quantity_selector
  assign buy_show_dynamic_checkout = qv_show_dynamic_checkout | default: block.settings.show_dynamic_checkout
-%}

<script src="{{ 'product-block-buy-buttons.js' | asset_url }}" defer="defer"></script>

{%- if product != blank -%}
<product-form
  class="product_form"
  data-product-id="{{ product.id }}"
  data-cart-type="{{ settings.cart_type }}"
  data-cart-drawer-section="cart-drawer"
  {{ block.shopify_attributes }}
>
  {% form 'product', product, class: 'product_form_form', novalidate: 'novalidate' %}
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
      data-variant-id
    >

    <input
      type="hidden"
      name="selling_plan"
      value=""
      data-selling-plan-input
    >

    <div class="product_quantity_buy_wrapper">
      {% if buy_show_quantity_selector %}
        {% render 'product-quantity-input' %}
      {% endif %}

      <button
        type="submit"
        name="add"
        class="product_form_submit button button--primary"
        data-add-to-cart
      >
        {% render 'icon', icon: 'cart', width: 22, height: 22 %}

        <span data-add-to-cart-text> Add to cart </span>

        <span
          class="product_form_spinner hidden"
          data-spinner
        >
          {% render 'loading-spinner' %}
        </span>
      </button>
    </div>

    {% if buy_show_dynamic_checkout %}
      {{ form | payment_button }}
    {% endif %}
  {% endform %}
</product-form>
{%- endif -%}

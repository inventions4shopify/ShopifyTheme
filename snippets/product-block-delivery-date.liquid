<product-delivery-date
  class="product-delivery-date"
  {% if block.settings.set_time_limit %}
    data-storage-key="delivery-countdown-{{ block.id }}"
    data-default-seconds="13500"
  {% endif %}
>
    {% assign delivery_days = block.settings.delivery_gap_days %}
    {% assign delivery_seconds = delivery_days | times: 86400 %}
    {% assign delivery_timestamp = 'now' | date: '%s' | plus: delivery_seconds %}
    {% assign delivery_day = delivery_timestamp | date: '%A' %}

    {% if delivery_day == 'Saturday' %}
        {% assign delivery_timestamp = delivery_timestamp | plus: 172800 %}
    {% elsif delivery_day == 'Sunday' %}
        {% assign delivery_timestamp = delivery_timestamp | plus: 86400 %}
    {% endif %}

    {% assign delivery_date = delivery_timestamp | date: '%A, %d %b %Y' %}
    <div class="csm_date_delivery">
        <span class="delivery_date_icon">
        {%- if block.settings.image != blank -%}
            {{
                block.settings.image
                | image_url: width: 40
                | image_tag:
                alt: block.settings.image.alt,
                loading: 'lazy',
                class: ''
            }}
        {%- endif -%}
        </span>
        
        <span class="get_it_by">Get It By {{ delivery_date }}
        {% if block.settings.set_time_limit %}, <span>If you Order within next <strong><span data-delivery-countdown></span></strong></span>{% endif %}
        </span>
    </div>
</product-delivery-date>

<script src="{{ 'product-block-delivery-date.js' | asset_url }}" defer="defer"></script>

{% style %}
  read-more-description {
    display: block;
  }

  /* Description text */
  .product_description_content {
    overflow: hidden;
    transition: max-height 0.4s ease;
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
  }

  /* Optional spacing wrapper */
  .product_description_block {
    margin-top: 1.5rem;
  }

  /* Toggle button */
  .product_description_toggle {
    margin-top: 1rem;
    padding: 0;
    background: none;
    border: none;
    font-size: 1.3rem;
    font-weight: 500;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .product_description_toggle:hover {
    opacity: 0.7;
  }

  /* Hidden state */
  .product_description_toggle.hidden {
    display: none;
  }

  /* Optional: nicer spacing when expanded */
  read-more-description[expanded] .product_description_content {
    transition: max-height 0.35s ease;
  }

  /* Desktop */
  @media screen and (min-width: 750px) {
    .product_description_toggle {
      font-size: 1.4rem;
    }
  }
{% endstyle %}

<div
  class="product_description_block"
  {{ block.shopify_attributes }}
>
  {% if block.settings.enable_read_more %}
    <read-more-description
      data-lines="{{ block.settings.lines_to_show }}"
      data-read-more="{{ block.settings.read_more_text }}"
      data-read-less="{{ block.settings.read_less_text }}"
    >
      <div class="product_description_content">
        {{ block.settings.description_content }}
      </div>

      <button
        type="button"
        class="product_description_toggle"
      >
        {{ block.settings.read_more_text }}
      </button>
    </read-more-description>
  {% else %}
    <div class="product_description_content">
      {{ product.description }}
    </div>
  {% endif %}
</div>

{% if block.settings.enable_read_more %}
  <script src="{{ 'product-block-description.js' | asset_url }}" defer="defer"></script>
{% endif %}


{%- liquid
  assign description_text = block.settings.description_content
  if description_text == blank
    assign description_text = product.description
  endif
-%}

{%- if description_text != blank -%}
  <div
    class="product_description_block"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.enable_read_more %}
      <read-more-description
        data-lines="{{ block.settings.lines_to_show }}"
        data-read-more="{{ block.settings.read_more_text }}"
        data-read-less="{{ block.settings.read_less_text }}"
      >
        <div class="product_description_content">
          {{ description_text }}
        </div>

        <button
          type="button"
          class="product_description_toggle"
        >
          {{ block.settings.read_more_text }}
        </button>
      </read-more-description>
    {% else %}
      <div class="product_description_content">
        {{ description_text }}
      </div>
    {% endif %}
  </div>
{%- endif -%}

{% if block.settings.enable_read_more %}
  <script src="{{ 'product-block-description.js' | asset_url }}" defer="defer"></script>
{% endif %}


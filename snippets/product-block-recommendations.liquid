{% style %}
  .prs {
    position: relative;
  }

  .prs_viewport {
    overflow: hidden;
  }

  .prs_track {
    display: flex;
    gap: 16px;
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .prs_slide {
    flex: 0 0 100%;
  }

  .prs_image {
    display: block;
    aspect-ratio: 1;
    margin-bottom: 12px;
  }

  .prs_image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .prs_content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prs_title {
    margin: 0;
    font-size: 16px;
  }

  .prs_title a {
    color: inherit;
    text-decoration: none;
  }

  .prs_price {
    font-weight: 600;
  }

  .prs_prev,
  .prs_next {
    display: none;
  }

  @media screen and (min-width: 768px) {
    .prs_track {
      gap: 20px;
    }

    .prs_slide {
      flex: 0 0 calc(50% - 10px);
    }

    .prs_prev,
    .prs_next {
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      z-index: 2;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 40px;
      height: 40px;
      cursor: pointer;
    }

    .prs_prev {
      left: 0;
    }

    .prs_next {
      right: 0;
    }

    .prs_prev[disabled],
    .prs_next[disabled] {
      opacity: 0.4;
      cursor: not-allowed;
    }
  }

  @media screen and (min-width: 992px) {
    .prs_slide {
      flex: 0 0 calc(25% - 15px);
    }
  }
{% endstyle %}

<product-recommendations-slider
  class="prs"
  {{ block.shopify_attributes }}
>
  <div class="prs_viewport">
    <h5 class="prs_heading">Frequently Bought Together</h5>

    <div class="prs_track">
      {% for recommendation_product in block.settings.products %}
        <div class="prs_slide">
          <a
            href="{{ recommendation_product.url }}"
            class="prs_image"
          >
            <img
              src="{{ recommendation_product.featured_image | image_url: width: 500 }}"
              alt="{{ recommendation_product.title | escape }}"
              loading="lazy"
              width="500"
              height="500"
            >
          </a>

          <div class="prs_content">
            <h3 class="prs_title">
              <a href="{{ recommendation_product.url }}">
                {{ recommendation_product.title }}
              </a>
            </h3>

            <div class="prs_price">
              {{ recommendation_product.price | money }}
            </div>

            {% render 'product-card-form', product: recommendation_product %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if block.settings.products.count > 1 %}
    <button
      type="button"
      class="prs_prev button button--secondary"
      aria-label="Previous products"
    >
      {% render 'icon', icon: 'chevron-left', width: 22, height: 22 %}
    </button>

    <button
      type="button"
      class="prs_next button button--secondary"
      aria-label="Next products"
    >
      {% render 'icon', icon: 'chevron-right', width: 22, height: 22 %}
    </button>
  {% endif %}
</product-recommendations-slider>

<product-recommendations-slider
  class="prs"
  {{ block.shopify_attributes }}
>
  <div class="prs_viewport">
    <h5 class="prs_heading">Frequently Bought Together</h5>

    <div class="prs_track">
      {% for recommendation_product in block.settings.products %}
        <div class="prs_slide">
          <div class="prs_slide_inner">
            <a
              href="{{ recommendation_product.url }}"
              class="prs_image"
            >
              <img
                src="{{ recommendation_product.featured_image | image_url: width: 500 }}"
                alt="{{ recommendation_product.title | escape }}"
                loading="lazy"
                width="500"
                height="500"
              >
            </a>

            <div class="prs_content">
              <h3 class="prs_title">
                <a href="{{ recommendation_product.url }}">
                  {{ recommendation_product.title }}
                </a>
              </h3>

              <div class="prs_price">
                {{ recommendation_product.price | money }}
              </div>

              {% render 'product-card-form', product: recommendation_product %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if block.settings.products.count > 1 %}
    <button
      type="button"
      class="prs_prev button button--secondary"
      aria-label="Previous products"
    >
      {% render 'icon', icon: 'chevron-left', width: 22, height: 22 %}
    </button>

    <button
      type="button"
      class="prs_next button button--secondary"
      aria-label="Next products"
    >
      {% render 'icon', icon: 'chevron-right', width: 22, height: 22 %}
    </button>
  {% endif %}
</product-recommendations-slider>

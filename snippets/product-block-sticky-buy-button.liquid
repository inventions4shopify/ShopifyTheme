<sticky-add-to-cart
  class="sticky_add_to_cart"
  data-product-id="{{ product.id }}"
>
  <div class="sticky_add_to_cart_inner">
    <div class="sticky_add_to_cart_product">
      <div class="sticky_add_to_cart_image">
        <img
          src="{{ product.featured_image | image_url: width: 120 }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
          width="120"
          height="120"
          data-sticky-image
        >
      </div>

      <div class="sticky_add_to_cart_content">
        <p
          class="sticky_add_to_cart_title"
          data-sticky-title
        >
          {{ product.title }}
        </p>

        <div
          class="sticky_add_to_cart_price"
          data-sticky-price
        >
          {{ product.selected_or_first_available_variant.price | money }}
        </div>
      </div>
    </div>

    <button
      type="button"
      class="sticky_add_to_cart_button button button--secondary"
      data-sticky-atc
    >
      Add to cart
    </button>
  </div>
</sticky-add-to-cart>

<script src="{{ 'product-block-sticky-buy-button.js' | asset_url }}" defer="defer"></script>


<h1
  class="product_title_block"
  {{ block.shopify_attributes }}
>
  {{ product.title }}
</h1>

{% style %}
.product_title_block {
  line-height: 1.2;
  font-weight: 600;
  color: rgb(var(--color-foreground));
  margin: 0 0 1.2rem;
  letter-spacing: -0.02em;
  word-break: break-word;
}

/* Desktop */
@media screen and (min-width: 750px) {
  .product_title_block {
    margin-bottom: 1.5rem;
  }
}
{% endstyle %}
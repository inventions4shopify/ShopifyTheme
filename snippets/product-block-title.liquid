<div class="product_title_block_wrapper" {{ block.shopify_attributes }}>
  <h1 class="h3">
    {{ product.title }}
  </h1>

  {% liquid
    assign show_wishlist_button = show_wishlist | default: true
  %}
  {% if show_wishlist_button and settings.enable_wishlist and settings.show_wishlist_on_product_page %}
    {% render 'wishlist-button', product: product, class: 'wishlist-button--product' %}
  {% endif %}
</div>

{% style %}
.product_title_block_wrapper {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.2rem;
  margin-bottom: 1.2rem;
}

/* Desktop */
@media screen and (min-width: 750px) {
  .product_title_block_wrapper {
    margin-bottom: 1.5rem;
  }
}
{% endstyle %}
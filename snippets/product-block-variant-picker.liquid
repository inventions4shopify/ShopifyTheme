{% unless product.has_only_default_variant %}
{%- liquid
  assign picker_swatch_size = qv_swatch_size | default: block.settings.swatch_size
  assign picker_update_url = qv_update_url | default: block.settings.update_url
  assign picker_hide_unavailable_options = qv_hide_unavailable_options | default: block.settings.hide_unavailable_options
  assign picker_show_selected_value = qv_show_selected_value | default: block.settings.show_selected_value
  assign picker_show_option_labels = qv_show_option_labels | default: block.settings.show_option_labels
  assign picker_show_color_name = qv_show_color_name | default: block.settings.show_color_name
  assign picker_show_dropdown_swatches = qv_show_dropdown_swatches | default: block.settings.show_dropdown_swatches
  assign picker_swatch_source = qv_swatch_source | default: block.settings.swatch_source
  assign picker_swatch_shape = qv_swatch_shape | default: block.settings.swatch_shape
  assign picker_button_shape = qv_button_shape | default: block.settings.button_shape
  assign picker_option_1_layout = qv_option_1_layout | default: block.settings.option_1_layout
  assign picker_option_2_layout = qv_option_2_layout | default: block.settings.option_2_layout
  assign picker_option_3_layout = qv_option_3_layout | default: block.settings.option_3_layout
-%}

{% style %}
  .variant_picker {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 1.5rem;
  }

  .variant_picker_option {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .variant_picker_option_header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .variant_picker_option_name {
    font-weight: 600;
  }

  .variant_picker_selected_value {
    opacity: 0.7;
  }

  .variant_picker_values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant_picker_value {
    position: relative;
    cursor: pointer;
  }

  .variant_picker_value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .variant_picker_swatch {
    width: calc(var(--swatch-size, 36) * 1px);
    height: calc(var(--swatch-size, 36) * 1px);
    display: block;
    border: 1px solid rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
    background-image: var(--swatch-image);
  }

  .variant_picker_swatch--circle {
    border-radius: 50%;
  }

  .variant_picker_swatch--square {
    border-radius: 0;
  }

  .variant_picker_swatch--rounded {
    border-radius: 8px;
  }
  .variant_picker_value input:checked + .variant_picker_swatch {
    border-color: #000;
    box-shadow: 0 0 0 2px #000;
  }
  .variant_picker_values--swatch .variant_picker_value {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .variant_picker_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 8px 16px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }
  .variant_picker_button--square {
    border-radius: 0;
  }

  .variant_picker_button--rounded {
    border-radius: 8px;
  }

  .variant_picker_button--pill {
    border-radius: 999px;
  }
  .variant_picker_value input:checked + .variant_picker_button {
    border-color: #000;
    background: #000;
    color: #fff;
  }
  .variant_picker_dropdown select {
    width: 100%;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background: transparent;
    cursor: pointer;
  }
  .variant_picker_swatch:hover,
  .variant_picker_button:hover,
  .variant_picker_dropdown select:hover {
    border-color: #000;
  }
  .variant_picker_value.is_unavailable {
    opacity: 0.4;
    pointer-events: none;
  }

  .variant_picker_dropdown {
    position: relative;
  }

  .variant_picker_dropdown_trigger {
    width: 100%;
    min-height: 48px;
    padding: 12px 16px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.15);

    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .variant_picker_dropdown_trigger:hover {
    border-color: #000;
  }

  .variant_picker_dropdown_selected_wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .variant_picker_dropdown_selected {
    line-height: 1.2;
  }

  .variant_picker_dropdown_icon {
    display: flex;
    transition: transform 0.25s ease;
  }

  .variant_picker_dropdown.is-open .variant_picker_dropdown_icon {
    transform: rotate(180deg);
  }

  .variant_picker_dropdown_list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;

    background: #fff;

    border: 1px solid rgba(0, 0, 0, 0.15);

    z-index: 20;

    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);

    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;

    max-height: 250px;
    overflow-y: auto;
  }

  .variant_picker_dropdown.is-open .variant_picker_dropdown_list {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .variant_picker_dropdown_option {
    width: 100%;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 16px;

    border: none;
    background: transparent;

    text-align: left;
    cursor: pointer;

    transition: background 0.15s ease;
  }

  .variant_picker_dropdown_option:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .variant_picker_dropdown_option.is-selected {
    font-weight: 600;
  }

  .variant_picker_dropdown_swatch {
    width: 18px;
    height: 18px;

    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);

    flex-shrink: 0;

    background-size: cover;
    background-position: center;
  }

  .variant_picker_dropdown_selected_swatch {
    width: 18px;
    height: 18px;

    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);

    flex-shrink: 0;

    background-size: cover;
    background-position: center;
  }
{% endstyle %}

<variant-picker
  class="variant_picker"
  style="--swatch-size: {{ picker_swatch_size }};"
  data-product-id="{{ product.id }}"
  data-update-url="{{ picker_update_url }}"
  data-hide-unavailable-options="{{ picker_hide_unavailable_options }}"
  data-show-selected-value="{{ picker_show_selected_value }}"
  data-show-option-labels="{{ picker_show_option_labels }}"
  data-show-color-name="{{ picker_show_color_name }}"
  data-show-dropdown-swatches="{{ picker_show_dropdown_swatches }}"
  data-swatch-source="{{ picker_swatch_source }}"
  data-swatch-size="{{ picker_swatch_size }}"
  data-swatch-shape="{{ picker_swatch_shape }}"
  data-button-shape="{{ picker_button_shape }}"
  {{ block.shopify_attributes }}
>
  {% for option in product.options_with_values %}
    {% liquid
      assign option_position = forloop.index

      case option_position
        when 1
          assign option_layout = picker_option_1_layout
        when 2
          assign option_layout = picker_option_2_layout
        when 3
          assign option_layout = picker_option_3_layout
      endcase
    %}

    {% assign is_color_option = false %}

    {% assign option_name = option.name | downcase %}

    {% if option_name contains 'color' or option_name contains 'colour' or option_name contains 'couleur' %}
      {% assign is_color_option = true %}
    {% endif %}

    <div
      class="variant_picker_option"
      data-option-position="{{ option.position }}"
      data-option-name="{{ option.name | escape }}"
      data-option-layout="{{ option_layout }}"
    >
      {% if picker_show_option_labels %}
        <div class="variant_picker_option_header">
          <span class="variant_picker_option_name">
            {{ option.name }}
          </span>

          {% if picker_show_selected_value %}
            <span
              class="variant_picker_selected_value"
              data-selected-value
            >
              {{ option.selected_value }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% case option_layout %}
        {% when 'swatch' %}
          <div class="variant_picker_values variant_picker_values--swatch">
            {% for value in option.values %}
              <label
                class="variant_picker_value"
              >
                <input
                  type="radio"
                  name="option-{{ option.position }}"
                  value="{{ value | escape }}"
                  {% if option.selected_value == value %}
                    checked
                  {% endif %}
                >

                {% assign swatch_file_name = value | handleize | append: '.png' %}

                <span
                  class="
                    variant_picker_swatch
                    variant_picker_swatch--{{ picker_swatch_shape }}
                  "
                  {% if value.swatch.color %}
                    style="background-color: {{ value.swatch.color }};"
                  {% endif %}
                  data-option-value="{{ value | escape }}"
                  {% if value.swatch.color == blank %}
                  style="--swatch-image: url('{{ swatch_file_name | asset_url }}');"
                  {% endif %}
                ></span>

                {% if picker_show_color_name %}
                  <span class="variant_picker_value_text">
                    {{ value }}
                  </span>
                {% endif %}
              </label>
            {% endfor %}
          </div>

        {% when 'button' %}
          <div class="variant_picker_values variant_picker_values--button">
            {% for value in option.values %}
              <label
                class="variant_picker_value"
              >
                <input
                  type="radio"
                  name="option-{{ option.position }}"
                  value="{{ value | escape }}"
                  {% if option.selected_value == value %}
                    checked
                  {% endif %}
                >

                <span
                  class="
                    variant_picker_button
                    variant_picker_button--{{ picker_button_shape }}
                  "
                >
                  {{ value }}
                </span>
              </label>
            {% endfor %}
          </div>

        {% when 'dropdown' %}
          <div class="variant_picker_dropdown">
            <div class="variant_picker_dropdown">
              <button
                type="button"
                class="variant_picker_dropdown_trigger"
                data-dropdown-trigger
              >
                <span
                  class="variant_picker_dropdown_selected"
                  data-dropdown-selected
                >
                  {{ option.selected_value }}
                </span>

                {% render 'icon', icon: 'chevron-down', width: 16, height: 16 %}
              </button>

              <div
                class="variant_picker_dropdown_list"
                data-dropdown-list
              >
                {% for value in option.values %}
                  <button
                    type="button"
                    class="variant_picker_dropdown_option"
                    data-option-value="{{ value | escape }}"
                  >
                    {% if picker_show_dropdown_swatches and is_color_option %}
                      <span
                        class="variant_picker_dropdown_swatch"
                        {% if value.swatch.color %}
                          style="background-color: {{ value.swatch.color }};"
                        {% endif %}
                      ></span>
                    {% endif %}

                    <span>
                      {{ value }}
                    </span>
                  </button>
                {% endfor %}
              </div>

              <input
                type="hidden"
                name="option-{{ option.position }}"
                value="{{ option.selected_value | escape }}"
                data-dropdown-input
              >
            </div>
          </div>
      {% endcase %}
    </div>
  {% endfor %}
  <script
    type="application/json"
    class="variant_picker_data"
  >
    {{ product.variants | json }}
  </script>
</variant-picker>

<script src="{{ 'product-block-variant-picker.js' | asset_url }}" defer="defer"></script>
{% endunless %}


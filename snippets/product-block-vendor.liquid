{% style %}
  .product_vendor_block {
    font-size: 1.4rem;
    line-height: 1.4;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.7);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .product_vendor_block {
      font-size: 1.5rem;
    }
  }
{% endstyle %}

<div
  class="product_vendor_block"
  {{ block.shopify_attributes }}
>
  {{ product.vendor }}
</div>

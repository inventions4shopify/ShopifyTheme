<product-card-form>
  <input
    type="hidden"
    value="{{ product.selected_or_first_available_variant.id }}"
    data-variant-id
  >

  <button
    type="button"
    class="js_product_card_atc product_card_button button button--secondary"
    aria-label="add to cart"
  >
    {% render 'icon', icon: 'shopping_cart', width: 22, height: 22 %}
  </button>
</product-card-form>
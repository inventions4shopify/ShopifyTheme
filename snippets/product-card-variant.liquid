{% assign color_option = blank %}

{% for option in product.options_with_values %}
  {% if option.name contains 'Color'
    or option.name contains 'Colour'
    or option.name contains 'color'
    or option.name contains 'colour'
  %}
    {% assign color_option = option %}
    {% assign color_option_visible = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if color_option %}
  {% case color_display_mode %}
    {% when 'swatch' %}
      {% if color_option_visible %}
        <div class="product-card__swatches text-{{ content_alignment }}">
          {% for value in color_option.values %}
            {%- liquid
              assign swatch_value = null
              assign swatch_focal_point = null
              assign variant_image_url = blank
              assign value_name = value.name | default: value

              if value.swatch.image
                assign image_url = value.swatch.image | image_url: width: 50
                assign swatch_value = 'url(' | append: image_url | append: ')'
                assign swatch_focal_point = value.swatch.image.presentation.focal_point
              elsif value.swatch.color
                assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
              endif

              if settings.enable_swatch_hover_image
                assign matched_variant = blank

                if value.variant != blank
                  assign matched_variant = value.variant
                else
                  for variant in product.variants
                    case color_option.position
                      when 1
                        if variant.option1 == value_name
                          assign matched_variant = variant
                          break
                        endif
                      when 2
                        if variant.option2 == value_name
                          assign matched_variant = variant
                          break
                        endif
                      when 3
                        if variant.option3 == value_name
                          assign matched_variant = variant
                          break
                        endif
                    endcase
                  endfor
                endif

                if matched_variant.featured_media
                  assign variant_image_url = matched_variant.featured_media.preview_image | image_url: width: 800
                elsif matched_variant.image
                  assign variant_image_url = matched_variant.image | image_url: width: 800
                endif
              endif
            -%}
            <span
              class="product-card__swatch rounded-lg{% if value.swatch.image %} product-card__swatch--image{% endif %}"
              style="{% if swatch_value %}background: {{ swatch_value }} no-repeat {% if swatch_focal_point %}{{ swatch_focal_point }}{% else %}center{% endif %}; background-size: cover;{% else %}background-color: {{ value_name | handleize }};{% endif %}"
              title="{{ value_name | escape }}"
              {% if variant_image_url != blank %}
                data-card-variant-image="{{ variant_image_url }}"
              {% endif %}
            ></span>
          {% endfor %}
        </div>
      {% endif %}

    {% when 'count' %}
      <div class="product-card__color-count">{{ color_option.values.size }} Colors</div>

    {% when 'variant_image' %}
      <div class="product-card__swatches text-{{ content_alignment }}">
        {% for value in color_option.values %}
          {%- liquid
            assign value_name = value.name | default: value
            assign matched_variant = blank

            if value.variant != blank
              assign matched_variant = value.variant
            else
              for variant in product.variants
                case color_option.position
                  when 1
                    if variant.option1 == value_name
                      assign matched_variant = variant
                      break
                    endif
                  when 2
                    if variant.option2 == value_name
                      assign matched_variant = variant
                      break
                    endif
                  when 3
                    if variant.option3 == value_name
                      assign matched_variant = variant
                      break
                    endif
                endcase
              endfor
            endif

            assign variant_image = blank
            if matched_variant.featured_media
              assign variant_image = matched_variant.featured_media.preview_image
            elsif matched_variant.image
              assign variant_image = matched_variant.image
            endif
          -%}

          {% if variant_image != blank %}
            <div
              class="color-swatch-image"
              {% if settings.enable_swatch_hover_image %}
                data-card-variant-image="{{ variant_image | image_url: width: 800 }}"
              {% endif %}
              {% if matched_variant.id %}
                data-variant-id="{{ matched_variant.id }}"
              {% endif %}
            >
              {{ variant_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: value_name }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
  {% endcase %}
{% endif %}

{% comment %}
  Render with:

  {% render 'product-image-gallery',
    product: product,
    thumbnail_layout: section.settings.thumbnail_layout,
    gallery_zoom_type: section.settings.gallery_zoom_type,
    hover_zoom_style: section.settings.hover_zoom_style,
    gallery_arrows_visibility: section.settings.gallery_arrows_visibility,
    gallery_arrow_display: section.settings.gallery_arrow_display
  %}
{% endcomment %}

{%- assign thumbnail_layout = thumbnail_layout | default: 'horizontal' -%}
{% assign arrows = gallery_arrows_visibility | default: 'both' %}
{% assign gallery_arrow_display = gallery_arrow_display | default: 'always' %}

{%- if product != blank and product.media.size > 0 -%}
  <div
    class="
      product_gallery product_gallery--{{ thumbnail_layout }} product_gallery--arrows-{{ arrows }} product_gallery--arrow-display-{{ gallery_arrow_display }}
      {% if gallery_zoom_type == 'hover' %}
        product_gallery--zoom-hover
      {% endif %}
    "
    id="product-gallery-{{ product.id }}"
    data-enable-desktop-drag="{{ section.settings.enable_desktop_drag }}"
    data-zoom-type="{{ gallery_zoom_type }}"
    {% if gallery_zoom_type != 'none' %}
      data-hover-zoom-style="{{ hover_zoom_style }}"
    {% endif %}
  >
    {% if thumbnail_layout == 'vertical' %}
      <div class="product_gallery_thumbnail_wrapper">
        <div class="product_gallery_thumbnail_track">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button
                type="button"
                class="product_gallery_thumbnail {% if forloop.first %}active{% endif %}"
                data-index="{{ forloop.index0 }}"
              >
                <img
                  src="{{ media | image_url: width: 160 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="80"
                  height="80"
                >
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="product_gallery_main_wrapper">
      {% if arrows != 'none' %}
        <button
          class="product_gallery_arrow product_gallery_arrow_prev button--secondary"
          type="button"
          aria-label="Previous image"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            version="1.1"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            width="20"
            height="20"
            viewBox="0 0 128 128"
          >
            <g>
              <path
                d="M84 108a3.988 3.988 0 0 1-2.828-1.172l-40-40a3.997 3.997 0 0 1 0-5.656l40-40c1.563-1.563 4.094-1.563 5.656 0s1.563 4.094 0 5.656L49.656 64l37.172 37.172a3.997 3.997 0 0 1 0 5.656A3.988 3.988 0 0 1 84 108z"
                fill="currentColor"
              ></path>
            </g>
          </svg>
        </button>

        <button
          class="product_gallery_arrow product_gallery_arrow_next button--secondary"
          type="button"
          aria-label="Next image"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            version="1.1"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            width="20"
            height="20"
            viewBox="0 0 128 128"
          >
            <g>
              <path
                d="M44 108a3.988 3.988 0 0 1-2.828-1.172 3.997 3.997 0 0 1 0-5.656L78.344 64 41.172 26.828c-1.563-1.563-1.563-4.094 0-5.656s4.094-1.563 5.656 0l40 40a3.997 3.997 0 0 1 0 5.656l-40 40A3.988 3.988 0 0 1 44 108z"
                fill="currentColor"
              ></path>
            </g>
          </svg>
        </button>
      {% endif %}

      {% if gallery_zoom_type == 'hover' and hover_zoom_style == 'preview_window' %}
        <div class="product_gallery_zoom_preview">
          <div class="product_gallery_zoom_preview_image"></div>
        </div>
      {% endif %}

      <div class="product_gallery_main_slider">
        <div class="product_gallery_main_track">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div
                class="product_gallery_main_slide"
                data-index="{{ forloop.index0 }}"
                data-full="{{ media | image_url: width: 2200 }}"
              >
                <picture>
                  <source
                    media="(min-width: 768px)"
                    srcset="
                      {{ media | image_url: width: 1200 }} 1200w,
                      {{ media | image_url: width: 1600 }} 1600w
                    "
                  >

                  <source
                    media="(max-width: 767px)"
                    srcset="
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 900 }} 900w
                    "
                  >

                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                    draggable="false"
                  >
                </picture>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if thumbnail_layout == 'horizontal' %}
      <div class="product_gallery_thumbnail_wrapper">
        <div class="product_gallery_thumbnail_track">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button
                class="product_gallery_thumbnail {% if forloop.first %}active{% endif %}"
                type="button"
                data-index="{{ forloop.index0 }}"
              >
                <img
                  src="{{ media | image_url: width: 160 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="80"
                  height="80"
                >
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if gallery_zoom_type == 'lightbox' %}
    <div class="product_lightbox" hidden>
      <div class="product_lightbox_overlay"></div>

      <div class="product_lightbox_content">
        <button class="product_lightbox_close button--secondary" aria-label="Close lightbox">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="M18 6L6 18M6 6l12 12"
              stroke="black"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>

        <div class="product_lightbox_layout">
          <div class="product_lightbox_thumbnails_wrapper">
            <div class="product_lightbox_thumbnails">
              {% for media in product.media %}
                {% if media.media_type == 'image' %}
                  <button
                    class="product_lightbox_thumbnail {% if forloop.first %}active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    type="button"
                  >
                    <img
                      src="{{ media | image_url: width: 160 }}"
                      alt="{{ media.alt | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="product_lightbox_images">
            {% for media in product.media %}
              {% if media.media_type == 'image' %}
                <div
                  class="product_lightbox_image_item"
                  data-index="{{ forloop.index0 }}"
                >
                  <img
                    src="{{ media | image_url: width: 2200 }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{%- endif -%}
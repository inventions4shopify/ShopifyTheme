{% comment %}
  Render with:

  {% render 'product-image-gallery',
    product: product,
    thumbnail_layout: section.settings.thumbnail_layout,
    gallery_zoom_type: section.settings.gallery_zoom_type,
    hover_zoom_style: section.settings.hover_zoom_style,
    gallery_arrows_visibility: section.settings.gallery_arrows_visibility,
    gallery_arrow_display: section.settings.gallery_arrow_display,
    enable_variant_image_switching: section.settings.enable_variant_image_switching
  %}
{% endcomment %}

{%- assign thumbnail_layout = thumbnail_layout | default: 'horizontal' -%}
{% assign arrows = gallery_arrows_visibility | default: 'both' %}
{% assign gallery_arrow_display = gallery_arrow_display | default: 'always' %}

<style>
  @media (min-width: 768px) {
  {% if thumbnail_layout == 'vertical' %}
    .product_gallery_thumbnail_wrapper {
      height: calc(var(--tps-thumbnail-height) * 1rem);
    }
  {% endif %}
  }
</style>

{%- if product != blank and product.media.size > 0 -%}
  <div
    class="
      product_gallery product_gallery--{{ thumbnail_layout }} product_gallery--arrows-{{ arrows }} product_gallery--arrow-display-{{ gallery_arrow_display }}
      {% if gallery_zoom_type == 'hover' %}
        product_gallery--zoom-hover
      {% endif %}
    "
    id="product-gallery-{{ product.id }}"
    data-enable-desktop-drag="{{ enable_desktop_drag | default: section.settings.enable_desktop_drag, allow_false: true }}"
    data-enable-variant-image-switching="{{ enable_variant_image_switching | default: false, allow_false: true }}"
    data-zoom-type="{{ gallery_zoom_type }}"
    {% if gallery_zoom_type != 'none' %}
      data-hover-zoom-style="{{ hover_zoom_style }}"
    {% endif %}
  >
    {% if thumbnail_layout == 'vertical' %}
      <div class="product_gallery_thumbnail_wrapper">
        <div class="product_gallery_thumbnail_track">
          {% assign gallery_index = 0 %}
          {% for media in product.media %}
            {% if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' %}
              <button
                type="button"
                class="product_gallery_thumbnail {% if gallery_index == 0 %}active{% endif %}{% if media.media_type != 'image' %} product_gallery_thumbnail--video{% endif %}"
                data-index="{{ gallery_index }}"
                aria-label="{% if media.media_type != 'image' %}Play media{% else %}View image{% endif %} {{ gallery_index | plus: 1 }}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 160 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="80"
                  height="80"
                >
                {% if media.media_type != 'image' %}
                  <span class="product_gallery_thumbnail_play" aria-hidden="true">
                    {% render 'icon', icon: 'play-button', width: 14, height: 14 %}
                  </span>
                {% endif %}
              </button>
              {% assign gallery_index = gallery_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div class="product_gallery_main_wrapper">
      {% if arrows != 'none' %}
        <button
          class="product_gallery_arrow product_gallery_arrow_prev button button--secondary"
          type="button"
          aria-label="Previous media"
        >
          {% render 'icon', icon: 'chevron-left', width: 22, height: 22 %}
        </button>

        <button
          class="product_gallery_arrow product_gallery_arrow_next button button--secondary"
          type="button"
          aria-label="Next media"
        >
          {% render 'icon', icon: 'chevron-right', width: 22, height: 22 %}
        </button>
      {% endif %}

      {% if gallery_zoom_type == 'hover' and hover_zoom_style == 'preview_window' %}
        <div class="product_gallery_zoom_preview">
          <div class="product_gallery_zoom_preview_image"></div>
        </div>
      {% endif %}

      <div class="product_gallery_main_slider">
        <div class="product_gallery_main_track">
          {% assign gallery_index = 0 %}
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <div
                class="product_gallery_main_slide"
                data-index="{{ gallery_index }}"
                data-media-id="{{ media.id }}"
                data-media-type="image"
                data-full="{{ media | image_url: width: 2200 }}"
              >
                <picture>
                  <source
                    media="(min-width: 768px)"
                    srcset="
                      {{ media | image_url: width: 1200 }} 1200w,
                      {{ media | image_url: width: 1600 }} 1600w
                    "
                  >

                  <source
                    media="(max-width: 767px)"
                    srcset="
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 900 }} 900w
                    "
                  >

                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="{% if gallery_index == 0 %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if gallery_index == 0 %}high{% else %}auto{% endif %}"
                    draggable="false"
                  >
                </picture>
              </div>
              {% assign gallery_index = gallery_index | plus: 1 %}
            {% elsif media.media_type == 'video' %}
              <div
                class="product_gallery_main_slide product_gallery_main_slide--video"
                data-index="{{ gallery_index }}"
                data-media-type="video"
              >
                {{
                  media
                  | video_tag:
                    class: 'product_gallery_video',
                    controls: true,
                    playsinline: true,
                    preload: 'metadata',
                    image_size: '1200x'
                }}
              </div>
              {% assign gallery_index = gallery_index | plus: 1 %}
            {% elsif media.media_type == 'external_video' %}
              <div
                class="product_gallery_main_slide product_gallery_main_slide--video"
                data-index="{{ gallery_index }}"
                data-media-type="external_video"
              >
                {{
                  media
                  | external_video_tag:
                    class: 'product_gallery_video product_gallery_video--external',
                    loading: 'lazy'
                }}
              </div>
              {% assign gallery_index = gallery_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if thumbnail_layout == 'horizontal' %}
      <div class="product_gallery_thumbnail_wrapper">
        <div class="product_gallery_thumbnail_track">
          {% assign gallery_index = 0 %}
          {% for media in product.media %}
            {% if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' %}
              <button
                class="product_gallery_thumbnail {% if gallery_index == 0 %}active{% endif %}{% if media.media_type != 'image' %} product_gallery_thumbnail--video{% endif %}"
                type="button"
                data-index="{{ gallery_index }}"
                aria-label="{% if media.media_type != 'image' %}Play media{% else %}View image{% endif %} {{ gallery_index | plus: 1 }}"
              >
                <img
                  src="{{ media.preview_image | image_url: width: 160 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="80"
                  height="80"
                >
                {% if media.media_type != 'image' %}
                  <span class="product_gallery_thumbnail_play" aria-hidden="true">
                    {% render 'icon', icon: 'play-button', width: 14, height: 14 %}
                  </span>
                {% endif %}
              </button>
              {% assign gallery_index = gallery_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if gallery_zoom_type == 'lightbox' %}
    <div class="product_lightbox" hidden>
      <div class="product_lightbox_overlay"></div>

      <div class="product_lightbox_content">
        <button class="product_lightbox_close button button--secondary" aria-label="Close lightbox">
          {% render 'icon', icon: 'close', width: 22, height: 22 %}
        </button>

        <div class="product_lightbox_layout">
          <div class="product_lightbox_thumbnails_wrapper">
            <div class="product_lightbox_thumbnails">
              {% assign gallery_index = 0 %}
              {% for media in product.media %}
                {% if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video' %}
                  <button
                    class="product_lightbox_thumbnail aspect-square {% if gallery_index == 0 %}active{% endif %}{% if media.media_type != 'image' %} product_lightbox_thumbnail--video{% endif %}"
                    data-index="{{ gallery_index }}"
                    type="button"
                    aria-label="{% if media.media_type != 'image' %}Play media{% else %}View image{% endif %} {{ gallery_index | plus: 1 }}"
                  >
                    <img
                      src="{{ media.preview_image | image_url: width: 160 }}"
                      alt="{{ media.alt | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                    {% if media.media_type != 'image' %}
                      <span class="product_gallery_thumbnail_play" aria-hidden="true">
                        {% render 'icon', icon: 'play-button', width: 14, height: 14 %}
                      </span>
                    {% endif %}
                  </button>
                  {% assign gallery_index = gallery_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="product_lightbox_images">
            {% assign gallery_index = 0 %}
            {% for media in product.media %}
              {% if media.media_type == 'image' %}
                <div
                  class="product_lightbox_image_item"
                  data-index="{{ gallery_index }}"
                  data-media-type="image"
                >
                  <img
                    src="{{ media | image_url: width: 2200 }}"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="lazy"
                  >
                </div>
                {% assign gallery_index = gallery_index | plus: 1 %}
              {% elsif media.media_type == 'video' %}
                <div
                  class="product_lightbox_image_item product_lightbox_image_item--video"
                  data-index="{{ gallery_index }}"
                  data-media-type="video"
                >
                  {{
                    media
                    | video_tag:
                      class: 'product_gallery_video',
                      controls: true,
                      playsinline: true,
                      preload: 'metadata',
                      image_size: '2200x'
                  }}
                </div>
                {% assign gallery_index = gallery_index | plus: 1 %}
              {% elsif media.media_type == 'external_video' %}
                <div
                  class="product_lightbox_image_item product_lightbox_image_item--video"
                  data-index="{{ gallery_index }}"
                  data-media-type="external_video"
                >
                  {{
                    media
                    | external_video_tag:
                      class: 'product_gallery_video product_gallery_video--external',
                      loading: 'lazy'
                  }}
                </div>
                {% assign gallery_index = gallery_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{%- endif -%}

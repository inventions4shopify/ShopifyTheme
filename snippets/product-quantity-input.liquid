<quantity-input class="product_quantity">
  <button
    type="button"
    class="product_quantity_button"
    data-quantity-decrease
  >
    {% render 'icon', icon: 'minus', width: 22, height: 22 %}
  </button>

  <input
    type="number"
    name="quantity"
    value="1"
    min="1"
    step="1"
    class="product_quantity_input"
    data-quantity-input
  >

  <button
    type="button"
    class="product_quantity_button"
    data-quantity-increase
  >
    {% render 'icon', icon: 'plus', width: 22, height: 22 %}
  </button>
</quantity-input>

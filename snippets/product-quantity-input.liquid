<quantity-input class="product_quantity">
  <button
    type="button"
    class="product_quantity_button"
    data-quantity-decrease
  >
    {% render 'icon', icon: 'minus', width: 22, height: 22 %}
  </button>

  <input
    type="number"
    name="quantity"
    value="1"
    min="1"
    step="1"
    class="product_quantity_input"
    data-quantity-input
  >

  <button
    type="button"
    class="product_quantity_button"
    data-quantity-increase
  >
    {% render 'icon', icon: 'plus', width: 22, height: 22 %}
  </button>
</quantity-input>

{% style %}
  .product_quantity {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    overflow: hidden;
  }

  .product_quantity_button {
    width: 48px;
    height: 48px;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .product_quantity_button:hover {
    background-color: rgba(0, 0, 0, 0.04);
  }

  .product_quantity_button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product_quantity_input {
    width: 60px;
    height: 48px;
    border: 0;
    padding: 0;
    font-size: 20px;
    text-align: center;
    background: transparent;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .product_quantity_input::-webkit-outer-spin-button,
  .product_quantity_input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product_quantity_input:focus {
    outline: none;
  }
  .product_quantity_button:first-child {
    border-right: 1px solid rgba(0, 0, 0, 0.1);
  }

  .product_quantity_button:last-child {
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }
{% endstyle %}

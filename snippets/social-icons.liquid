<ul class="social_list">
  {%- if settings.social_facebook_link != blank -%}
    <li class="social_list-item">
      <a href="{{ settings.social_facebook_link }}" target="_blank" class="social_link">
        <span class="svg-wrapper">
          {{- 'icon-facebook.svg' | inline_asset_content -}}
        </span>
        <span class="hidden">{{ 'social_media.social_facebook_link.label' | t }}</span>
      </a>
    </li>
  {%- endif -%}

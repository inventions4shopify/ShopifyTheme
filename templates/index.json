    "faq_abpaMm": {
      "type": "faq",
      "blocks": {
        "faq_qABayg": {
          "type": "faq",
          "settings": {
            "heading": "What sizes do you offer?",
            "description": "<p>We offer a wide range of sizes to ensure the perfect fit for every woman. Please refer to our Size Guide on each product page for detailed measurements and fitting recommendations.</p>"
          }
        },
        "faq_6pfEW9": {
          "type": "faq",
          "settings": {
            "heading": "How long does shipping take?",
            "description": "<p>Orders are typically processed within 1–2 business days. Standard delivery usually takes 3–7 business days, depending on your location. You'll receive a tracking number once your order has been shipped.</p>"
          }
        },
        "faq_eWfhNF": {
          "type": "faq",
          "settings": {
            "heading": "Can I return or exchange an item?",
            "description": "<p>Yes! We accept returns and exchanges within 14 days of delivery, provided the item is unworn, unwashed, and has all original tags attached. Visit our Returns page for complete details.</p>"
          }
        },
        "faq_aTg6wj": {
          "type": "faq",
          "settings": {
            "heading": "How can I track my order?",
            "description": "<p>Once your order has been dispatched, we'll send you a confirmation email with a tracking link so you can monitor your shipment in real time.</p>"
          }
        },
        "faq_7YeYzg": {
          "type": "faq",
          "settings": {
            "heading": "How can I contact customer support?",
            "description": "<p>Our customer support team is here to help. You can reach us through our Contact Us page or by emailing us with any questions regarding your order, sizing, or products.</p>"
          }
        }
      },
